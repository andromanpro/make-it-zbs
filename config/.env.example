# ===========================================
# Make it ZBS - Конфигурация API ключей
# ===========================================
#
# Скопируйте этот файл в .env и укажите свои ключи
#

# OpenRouter API Key
# Получить можно на: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter App Name (опционально)
OPENROUTER_APP_NAME=MakeItZBS

# OpenRouter Site URL (опционально)
OPENROUTER_SITE_URL=https://github.com/yourusername/make-it-zbs
