// ========================================================
// Make it ZBS - Главный скрипт v2
// ========================================================
// Универсальная система улучшения контента через AI
// Одна кнопка для улучшения всего!
// ========================================================

// Системный журнал оркестратора.
Перем Лог;
// Общие настройки приложения.
Перем НастройкиОбщие;
// Настройки моделей по контекстам.
Перем НастройкиМоделей;
// Шаблоны инструкций по контекстам.
Перем НастройкиИнструкций;
// Компонент создания снимков экрана.
Перем Screenshot;
// Компонент работы с окнами и UI Automation.
Перем WinInfo;
// Компонент расширенной работы с буфером обмена.
Перем Clipboard;
// Шифрованные страховочные копии перед заменой исходника.
Перем ХранилищеКопий;
// Клиент OpenRouter.
Перем OpenRouterКлиент;
// Локальный Codex CLI, авторизованный через подписку ChatGPT.
Перем CodexКлиент;
// Определитель контекста активного приложения.
Перем ContextDetector;
// Файловый журнал запросов, ответов и ошибок.
Перем Logger;
// Ключ доступа к OpenRouter.
Перем APIКлюч;
// Компонент ожидания горячей клавиши и управления окнами Preview.
Перем ОбработчикСобытий;
// Признак использования имитатора OpenRouter.
Перем МокAI;
// Задержка ответа имитатора в секундах.
Перем МокЗадержкаСек;
// Минимальная сторона полезной области изображения.
Перем МинимальныйРазмерОбрезки;
// Количество миллисекунд в секунде.
Перем МиллисекундВСекунде;
// Длина маркера обрамления блока кода.
Перем ДлинаМаркераОбрамленияКода;
// Максимальная длина адреса данных в тексте ошибки.
Перем МаксимальнаяДлинаФрагментаАдресаДанных;
// Длина префикса двоичных данных в адресе.
Перем ДлинаПрефиксаДвоичныхДанных;
// Задержка перед регистрацией горячей клавиши.
Перем ЗадержкаЗапускаОбработчикаМс;
// Имя поля модели в настройках.
Перем ИмяПоляМодели;
// Имя контекста чата с ИИ.
Перем ИмяКонтекстаЧатаИИ;
// Разделитель блоков консольного вывода.
Перем РазделительВывода;
// Имя настройки текста быстрого продолжения.
Перем ИмяНастройкиПродолжения;
// Имя настройки горячей клавиши.
Перем ИмяНастройкиГорячейКлавиши;
// Максимальная длина локально считанного текста чата.
Перем МаксимальнаяДлинаТекстаЧатаИИ;
// Имена провайдеров и полей конфигурации моделей.
Перем ИмяПоляПровайдера;
// Имя поля модели Codex.
Перем ИмяПоляМоделиCodex;
// Имя поля уровня рассуждений Codex.
Перем ИмяПоляУровняReasoningCodex;
// Идентификатор провайдера OpenRouter.
Перем ПровайдерOpenRouter;
// Идентификатор провайдера Codex.
Перем ПровайдерCodex;
// Таймаут обычного запроса Codex в секундах.
Перем ТаймаутКодексСекунд;
// Таймаут генерации изображения через Codex в секундах.
Перем ТаймаутГенерацииИзображенияКодексСекунд;
// Имя поля системной инструкции.
Перем ИмяПоляСистемнойИнструкции;
// Исход операции при ошибке применения или показа результата.
Перем ИсходОшибка;

// ========================================================
// Инициализация
// ========================================================

Процедура Инициализация() Экспорт

	ИнициализироватьСлужебныеЗначения();

	// Настройка записи журналов
	Лог = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "modules", "console-log.os"));
	Лог.УстановитьУровень(0);

	Лог.Информация(РазделительВывода);
	Лог.Информация("Make it ZBS - Запуск");
	Лог.Информация(РазделительВывода);

	// Подключить компонент
	ПодключитьКомпонент();

	// Снимок настроек читается компонентом под общей блокировкой.
	ЗагрузитьНастройки();

	// Инициализировать модули Windows API.
	// ВНИМАНИЕ: НЕ создавать здесь УправлениеГорячимиКлавишами - его конструктор
	// поднимает STA-loop + трей-иконку (NotifyIcon Visible) + прогретую
	// WebView2-форму (~30 МБ). ГлавныйЦикл создает свой HotkeyManager
	// внутри - второй экземпляр здесь давал ДВЕ иконки в трее и удвоенный
	// прогрев WebView2 (аудит Phase 15). Горячая клавиша обслуживается отдельно.
	Screenshot = Новый СнимокЭкрана();
	WinInfo = Новый ИнформацияОбОкне();
	Clipboard = Новый БуферОбменаРасширенный();
	CodexКлиент = Новый КлиентCodexCLI();

	// Инициализировать модули логики
	ПутьКМодулям = ОбъединитьПути(ТекущийСценарий().Каталог, "modules");

	Если МокAI Тогда
		// DEV: подменяем реальный клиент моком из test/mocks, ответ - из
		// fixture (запросы НЕ уходят в OpenRouter, деньги не тратятся).
		// ОбъединитьПути принимает <=4 аргумента - идем через Корень.
		Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
		ПутьКИмитаторам = ОбъединитьПути(Корень, "test", "mocks");
		OpenRouterКлиент = ЗагрузитьСценарий(
			ОбъединитьПути(ПутьКИмитаторам, "mock-openrouter-client.os"));
		OpenRouterКлиент.Инициализировать("mock-key");
		ПутьКТестовымДанным = ОбъединитьПути(Корень, "test", "fixtures");
		ПутьКОтвету = ОбъединитьПути(ПутьКТестовымДанным, "api-response-success.json");
		OpenRouterКлиент.ЗагрузитьОтветИзФайла(ПутьКОтвету);
		Лог.Информация("DEV: мок OpenRouter активен (ответ из fixture, задержка " + Строка(МокЗадержкаСек) + "с)");
	Иначе
		OpenRouterКлиент = ЗагрузитьСценарий(ОбъединитьПути(ПутьКМодулям, "openrouter-client.os"));
		OpenRouterКлиент.Инициализировать(APIКлюч);
	КонецЕсли;

	ContextDetector = ЗагрузитьСценарий(ОбъединитьПути(ПутьКМодулям, "context-detector.os"));

	Logger = ЗагрузитьСценарий(ОбъединитьПути(ПутьКМодулям, "logger.os"));
	ПутьКЛогам = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "logs");
	Logger.Инициализировать(ПутьКЛогам, НастройкиОбщие["logging"], Clipboard);

	Лог.Информация("Make it ZBS успешно инициализирован");
	Лог.Информация("");

КонецПроцедуры

// Контролируемая точка инъекции зависимостей для smoke-тестов.
// Тест загружает модуль через ЗагрузитьСценарий() (guard не дает
// запуститься циклу), затем подменяет нужные зависимости имитаторами,
// минуя Инициализация() с реальной DLL/сетью/файлами.
//
// Параметры:
//  Зав - Структура - Зависимости, которыми требуется заменить рабочие объекты.
Процедура УстановитьТестовыеЗависимости(Знач Зав) Экспорт

	ИнициализироватьСлужебныеЗначения();

	Если Зав.Свойство("Лог") Тогда
		Лог = Зав.Лог;
	КонецЕсли;
	Если Зав.Свойство("НастройкиОбщие") Тогда
		НастройкиОбщие = Зав.НастройкиОбщие;
	КонецЕсли;
	Если Зав.Свойство("НастройкиМоделей") Тогда
		НастройкиМоделей = Зав.НастройкиМоделей;
	КонецЕсли;
	Если Зав.Свойство("НастройкиИнструкций") Тогда
		НастройкиИнструкций = Зав.НастройкиИнструкций;
	КонецЕсли;
	Если Зав.Свойство("Screenshot") Тогда
		Screenshot = Зав.Screenshot;
	КонецЕсли;
	Если Зав.Свойство("WinInfo") Тогда
		WinInfo = Зав.WinInfo;
	КонецЕсли;
	Если Зав.Свойство("Clipboard") Тогда
		Clipboard = Зав.Clipboard;
	КонецЕсли;
	Если Зав.Свойство("ХранилищеКопий") Тогда
		ХранилищеКопий = Зав.ХранилищеКопий;
	КонецЕсли;
	Если Зав.Свойство("OpenRouterКлиент") Тогда
		OpenRouterКлиент = Зав.OpenRouterКлиент;
	КонецЕсли;
	Если Зав.Свойство("CodexКлиент") Тогда
		CodexКлиент = Зав.CodexКлиент;
	КонецЕсли;
	Если Зав.Свойство("ContextDetector") Тогда
		ContextDetector = Зав.ContextDetector;
	КонецЕсли;
	Если Зав.Свойство("Logger") Тогда
		Logger = Зав.Logger;
	КонецЕсли;
	Если Зав.Свойство("APIКлюч") Тогда
		APIКлюч = Зав.APIКлюч;
	КонецЕсли;
	Если Зав.Свойство("МокAI") Тогда
		МокAI = Зав.МокAI;
	КонецЕсли;
	// Phase 4: тесты ветки replace-in-place подменяют обработчик имитатором
	// (ПоказатьПревью->"applied", ПодтвердитьЗаменуВсегоМодуля, ОчиститьОчередь).
	Если Зав.Свойство("ОбработчикСобытий") Тогда
		ОбработчикСобытий = Зав.ОбработчикСобытий;
	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьСлужебныеЗначения()

	МинимальныйРазмерОбрезки = 8;
	МиллисекундВСекунде = 1000;
	ДлинаМаркераОбрамленияКода = 3;
	МаксимальнаяДлинаФрагментаАдресаДанных = 40;
	ДлинаПрефиксаДвоичныхДанных = 7;
	ЗадержкаЗапускаОбработчикаМс = 6000;
	ИмяПоляМодели = "model";
	ИмяПоляПровайдера = "provider";
	ИмяПоляМоделиCodex = "codexModel";
	ИмяПоляУровняReasoningCodex = "codexReasoningEffort";
	ПровайдерOpenRouter = "openrouter";
	ПровайдерCodex = "codex";
	ТаймаутКодексСекунд = 180;
	ТаймаутГенерацииИзображенияКодексСекунд = 600;
	ИмяПоляСистемнойИнструкции = "system";
	ИсходОшибка = "error";
	ИмяКонтекстаЧатаИИ = "AIChat";
	РазделительВывода = "========================================";
	ИмяНастройкиПродолжения = "continueText";
	ИмяНастройкиГорячейКлавиши = "hotkey";
	МаксимальнаяДлинаТекстаЧатаИИ = 24000;

КонецПроцедуры

// Перечитать конфиги (settings/models/prompts/.env) с диска во время работы.
// Seam для будущего GUI настроек (Фаза 1) и hot-reload: пайплайн
// ЗапуститьОбработку читает настройки моделей, инструкций и общие настройки заново на
// каждом вызове, поэтому новые значения подхватываются со следующего хоткея.
// Возвращает Истина при успехе; при ошибке чтения пробрасывает исключение.
//
// Возвращаемое значение:
//  Булево - Истина после успешной загрузки настроек.
Функция ПерезагрузитьНастройки() Экспорт

	ЗагрузитьНастройки();

	// Phase 15.A (аудит P1): переинициализировать OpenRouter-клиент свежим
	// ключом. Раньше reload обновлял только модульный APIКлюч, а клиент
	// держал копию с момента старта -> ввод ключа в Настройках НЕ применялся
	// до полного рестарта (ломало portable-раздачу: dist едет с пустым .env,
	// новый юзер вводил ключ и получал «API ключ не установлен» до перезапуска).
	// Только реальный режим - мок держит собственный "mock-key".
	Если НЕ МокAI И OpenRouterКлиент <> Неопределено Тогда
		OpenRouterКлиент.Инициализировать(APIКлюч);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Phase 13.2 (Codex audit P1): применить смену горячей клавиши на лету.
// Раньше смена hotkey в Настройках молча не применялась до рестарта
// (регистрация была однократной). Снимаем старую, регистрируем новую;
// при ошибке (клавиша занята другим приложением) - откат на прежнюю.
// Возвращает фактически активную клавишу (новую при успехе, старую при откате).
//
// Параметры:
//  ОбработчикСобытий - Произвольный - Объект регистрации горячей клавиши.
//  СтараяКлавиша - Строка - Ранее зарегистрированная клавиша.
//  НоваяКлавиша - Строка - Новая клавиша для регистрации.
//
// Возвращаемое значение:
//  Строка - Фактически зарегистрированная горячая клавиша.
Функция ПрименитьСменуГорячейКлавиши(ОбработчикСобытий, Знач СтараяКлавиша, Знач НоваяКлавиша) Экспорт

	Попытка
		ОбработчикСобытий.Отменить();
		ОбработчикСобытий.Зарегистрировать(НоваяКлавиша);
		Лог.Информация("Горячая клавиша изменена: " + СтараяКлавиша + " -> " + НоваяКлавиша);
		Возврат НоваяКлавиша;
	Исключение
		Лог.Ошибка("Не удалось сменить горячую клавишу на '" + НоваяКлавиша + "': " + ОписаниеОшибки());
		// Откат: вернуть прежнюю клавишу, чтобы приложение не осталось без hotkey
		Попытка
			ОбработчикСобытий.Зарегистрировать(СтараяКлавиша);
			Лог.Информация("Откат: оставлена прежняя горячая клавиша " + СтараяКлавиша);
			Возврат СтараяКлавиша;
		Исключение
			// Двойной отказ - и новая, и старая заняты (Codex+DeepSeek contrast
			// Phase 13). Hotkey НЕ активна. НЕ возвращаем старую как «активную»
			// (ввело бы в заблуждение): пустая строка -> следующее сохранение
			// настроек повторит попытку регистрации. Уведомляем пользователя.
			Лог.Ошибка("ОТКАТ НЕ УДАЛСЯ - горячая клавиша не активна: " + ОписаниеОшибки());
			Попытка
				СообщениеИндикации = ТекстИнтерфейса(
					"Горячая клавиша не активна - выберите свободную в Настройках",
					"The keyboard shortcut is inactive - choose a free one in Settings");
				ОбработчикСобытий.СброситьИндикацию(СообщениеИндикации);
			Исключение
				Лог.Отладка("Не удалось обновить индикацию после ошибки hotkey: " + ОписаниеОшибки());
			КонецПопытки;
			Возврат "";
		КонецПопытки;
	КонецПопытки;

КонецФункции

Процедура ЗагрузитьНастройки()

	КаталогКонфига = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "config");

	Хранилище = Новый СнимокНастроекПриложения();
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Хранилище.ПрочитатьСнимокJSON(КаталогКонфига));
	Снимок = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	НовыеОбщие = Снимок["settings"];
	НовыеМодели = Снимок["models"];
	НовыеИнструкции = Снимок["prompts"];

	// Dev-режим: мок OpenRouter (не тратить деньги при разработке UI).
	// Гард - секция dev необязательна, дефолт = реальный режим.
	ДевНастройки = НовыеОбщие.Получить("dev");
	НовыйМокAI = (ДевНастройки <> Неопределено) И (ДевНастройки.Получить("mockAI") = Истина);
	НоваяЗадержка = 0;
	Если ДевНастройки <> Неопределено И ДевНастройки.Получить("mockDelaySec") <> Неопределено Тогда
		НоваяЗадержка = ДевНастройки["mockDelaySec"];
	КонецЕсли;

	// .env нужен только в реальном режиме (мок не шлет запросы)
	НовыйКлюч = Снимок["apiKey"];
	Если НовыйМокAI Тогда
		НовыйКлюч = "mock-key";
		Лог.Информация("DEV mockAI=true - .env/OpenRouter-ключ не требуется");
	КонецЕсли;

	// Публикуем только полностью прочитанное поколение настроек.
	НастройкиОбщие = НовыеОбщие;
	НастройкиМоделей = НовыеМодели;
	НастройкиИнструкций = НовыеИнструкции;
	APIКлюч = НовыйКлюч;
	МокAI = НовыйМокAI;
	МокЗадержкаСек = НоваяЗадержка;
	Если Logger <> Неопределено Тогда
		ПутьКЛогам = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "logs");
		Logger.Инициализировать(ПутьКЛогам, НастройкиОбщие["logging"], Clipboard);
	КонецЕсли;

	Лог.Информация("Настройки загружены");

КонецПроцедуры

Функция ПолучитьЯзыкИнтерфейса()

	Если НастройкиОбщие <> Неопределено Тогда
		Общие = НастройкиОбщие.Получить("general");
		Если Общие <> Неопределено Тогда
			Язык = Общие.Получить("language");
			Если Язык <> Неопределено И НРег(СокрЛП(Строка(Язык))) = "en" Тогда
				Возврат "en";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат "ru";

КонецФункции

Функция ТекстИнтерфейса(Знач РусскийТекст, Знач АнглийскийТекст)

	Если ПолучитьЯзыкИнтерфейса() = "en" Тогда
		Возврат АнглийскийТекст;
	КонецЕсли;

	Возврат РусскийТекст;

КонецФункции

Процедура ПодключитьКомпонент()

    // Путь к библиотеке (net472)
    КаталогПроекта = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
    КаталогПроекта = ОбъединитьПути(КаталогПроекта, "..");
    ПутьКБиблиотеке = ОбъединитьПути(КаталогПроекта, "lib\net472\ZBSWindowsComponent.dll");

    Если НЕ Новый Файл(ПутьКБиблиотеке).Существует() Тогда
        // Fallback на корневую библиотеку
        ПутьКБиблиотеке = ОбъединитьПути(КаталогПроекта, "lib\ZBSWindowsComponent.dll");
    КонецЕсли;

    Если НЕ Новый Файл(ПутьКБиблиотеке).Существует() Тогда
        ВызватьИсключение "Компонент ZBSWindowsComponent.dll не найден."
            + Символы.ПС + "Запустите build.bat для сборки компонента.";
    КонецЕсли;

    Попытка
        ПодключитьВнешнююКомпоненту(ПутьКБиблиотеке);
        Сообщить("[OK] Компонент ZBSWindowsComponent подключен (net472)");
    Исключение
        ВызватьИсключение "Ошибка подключения компонента: " + ОписаниеОшибки();
    КонецПопытки;

КонецПроцедуры

// ========================================================
// Обработчик горячей клавиши
// ========================================================

// Тонкая обертка для F13: получает окно/буфер/контекст и делегирует
// в ЗапуститьОбработку. Вся диагностика и показ ошибки пользователю - здесь;
// тестируемое ядро (ЗапуститьОбработку) исключения НЕ глотает.
//
// Параметры:
//  НажатаяКлавиша - Строка - Комбинация, которая запустила обработку.
Процедура ОбработчикГорячейКлавиши(Знач НажатаяКлавиша = "")
	Операция = Новый УправлениеОперацией();
	Если НЕ Операция.Начать() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ВыполнитьОбработчикГорячейКлавиши(Операция, НажатаяКлавиша);
	Исключение
		Операция.Завершить();
		ВызватьИсключение;
	КонецПопытки;
	Операция.Завершить();
КонецПроцедуры

Процедура ВыполнитьОбработчикГорячейКлавиши(Знач Операция, Знач НажатаяКлавиша)

	Лог.Информация("===========================================");
	Лог.Информация("Нажата горячая клавиша Make it ZBS!");
	Лог.Информация("===========================================");

	Попытка
		ОбработатьНажатиеГорячейКлавиши(НажатаяКлавиша);
	Исключение
		Если Операция.Отменена() Тогда
			Лог.Информация("Операция отменена пользователем");
			Logger.ЗаписатьСобытие("hotkey", "cancelled");
			СброситьИндикациюБезОшибки(ТекстИнтерфейса("Отменено", "Cancelled"));
		Иначе
			ОбработатьОшибкуГорячейКлавиши(ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;

	ОбслужитьГорячуюКлавишуПослеОбработки();

КонецПроцедуры

Процедура ОбработатьНажатиеГорячейКлавиши(Знач НажатаяКлавиша = "")

	АктивноеОкно = WinInfo.ПолучитьАктивноеОкно();
	Если АктивноеОкно = Неопределено Тогда
		Лог.Предупреждение("Не удалось получить информацию об активном окне");
		Сообщение = ТекстИнтерфейса(
			"Не удалось определить активное окно", "Could not detect the active window");
		СброситьИндикациюБезОшибки(Сообщение);
		Возврат;
	КонецЕсли;

	Лог.Информация("Активное окно:");
	Лог.Информация("  EXE: " + АктивноеОкно.exe);
	Лог.Информация("  Title: " + АктивноеОкно.title);
	ИнфоБуфера = Clipboard.ПолучитьИнформацию();
	НастройкиИзображений = НастройкиОбщие.Получить("imageSource");
	РазрешитьБуферИзображений = НастройкиИзображений <> Неопределено
		И НастройкиИзображений.Получить("useClipboardForUnknown") = Истина;
	Контекст = ContextDetector.ОпределитьКонтекст(АктивноеОкно, ИнфоБуфера, РазрешитьБуферИзображений);
	Logger.ЗаписатьСобытие(Контекст, "accepted", 0, ИнфоБуфера.имеетИзображение);
	Если Контекст = ИмяКонтекстаЧатаИИ Тогда
		ПрофильЧатаИИ = ПолучитьПрофильЧатаИИ(АктивноеОкно);
		Если ПрофильЧатаИИ = Неопределено Тогда
			ВызватьИсключение "AI-клиент не разрешён ни одним включённым профилем.";
		КонецЕсли;
		КлавишаПрофиля = ЗначениеПрофиляЧатаИИ(
			ПрофильЧатаИИ, "hotkey", НастройкиОбщие["general"]["hotkey"]);
		Если НЕ ПустаяСтрока(НажатаяКлавиша)
			И НРег(НажатаяКлавиша) <> НРег(КлавишаПрофиля) Тогда
			Лог.Информация("Нажатая клавиша не назначена активному AI-профилю: "
				+ НажатаяКлавиша);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ОписаниеКонтекста = ContextDetector.ПолучитьОписаниеКонтекста(Контекст);
	Лог.Информация("Контекст: " + Контекст + " (" + ОписаниеКонтекста + ")");
	ЗапуститьОбработку(АктивноеОкно, Контекст);
	Logger.ЗаписатьСобытие(Контекст, "finished");

КонецПроцедуры

Процедура ОбработатьОшибкуГорячейКлавиши(Знач ТекстОшибки)

	ТекстОшибки = ДобавитьПодсказкуЭлевации(ТекстОшибки);
	Лог.Ошибка("Ошибка при обработке hotkey: " + ТекстОшибки);
	Logger.ЗаписатьОшибку("hotkey", ТекстОшибки);
	Сообщение = ТекстИнтерфейса("Не удалось обработать запрос", "Could not process the request");
	СброситьИндикациюБезОшибки(Сообщение);
	Сообщить("ОШИБКА: " + ТекстОшибки);

КонецПроцедуры

Функция ДобавитьПодсказкуЭлевации(Знач ТекстОшибки)

	Если ОбработчикСобытий = Неопределено Тогда
		Возврат ТекстОшибки;
	КонецЕсли;

	Попытка
		Подсказка = ОбработчикСобытий.ДиагностикаЭлевации();
		Если НЕ ПустаяСтрока(Подсказка) Тогда
			Возврат ТекстОшибки + Символы.ПС + Подсказка;
		КонецЕсли;
	Исключение
		Лог.Отладка("Диагностика элевации недоступна: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат ТекстОшибки;

КонецФункции

Процедура ОбслужитьГорячуюКлавишуПослеОбработки()

	ОчиститьОчередьГорячейКлавишиБезОшибки();
	ОчиститьЗахваченныйКонтентБезОшибки();

КонецПроцедуры

Процедура ОчиститьОчередьГорячейКлавишиБезОшибки()

	Если ОбработчикСобытий <> Неопределено Тогда
		Попытка
			ОбработчикСобытий.ОчиститьОчередь();
		Исключение
			Лог.Отладка("Не удалось очистить очередь hotkey: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьЗахваченныйКонтентБезОшибки()

	Если Logger <> Неопределено Тогда
		Попытка
			Logger.ОчиститьЗахваченныйКонтент();
		Исключение
			Лог.Отладка("Не удалось очистить захваченный контент: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Тестируемое ядро пайплайна: данные -> модель/инструкция -> запрос -> ответ.
// Точка входа без F13/UIA - тест вызывает напрямую с fixture-окном
// и известным контекстом. Возвращает структуру результата для assertions.
// Исключения НЕ перехватывает: тест и обертка ловят их сами.
//
// Параметры:
//  АктивноеОкно - Структура - Сведения об окне, из которого получены данные.
//  Контекст - Строка - Определенный контекст обработки.
//
// Возвращаемое значение:
//  Структура - Результат обработки и сведения о выполненном запросе.
Функция ЗапуститьОбработку(Знач АктивноеОкно, Знач Контекст) Экспорт

	Попытка
		Результат = ВыполнитьОбработку(АктивноеОкно, Контекст);
		ПроверитьОтменуОперации();
	Исключение
		WinInfo.ОсвободитьПривязкуЗамены();
		ВызватьИсключение;
	КонецПопытки;
	WinInfo.ОсвободитьПривязкуЗамены();
	Возврат Результат;

КонецФункции

Процедура ПроверитьОтменуОперации()
	Операция = Новый УправлениеОперацией();
	Операция.ПроверитьОтмену();
КонецПроцедуры

Функция ВыполнитьОбработку(Знач АктивноеОкно, Знач Контекст)
	ПроверитьОтменуОперации();

	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// До снимка не показываем поверх исходника собственное окно статуса.
	Если ЭтоТекстовыйКонтекст(Контекст) ИЛИ Контекст = "OneCCode" Тогда
		Сообщение = Контекст + ТекстИнтерфейса(
			" - клавиша принята, читаю выделение...", " - hotkey received, reading selection...");
		ПоказатьИндикациюЗанятостиБезОшибки(Сообщение);
	Иначе
		СкрытьИндикациюБезОшибки();
	КонецЕсли;
	Захват = СобратьДанные(Контекст, АктивноеОкно);
	Сообщение = Контекст + ТекстИнтерфейса(
		" - данные захвачены, обработка...", " - input captured, processing...");
	ПоказатьИндикациюЗанятостиБезОшибки(Сообщение);
	Logger.ЗаписатьСобытие(Контекст, "captured", СтрДлина(Захват.original));
	ПроверитьОтменуОперации();
	НужнаПривязка = Контекст <> ИмяКонтекстаЧатаИИ И Захват.kind = "text"
		И ЗаменаВключена() И КонтекстРазрешенДляЗамены(Контекст);
	Если НужнаПривязка Тогда
		Захват.replacementToken = WinInfo.ЗакрепитьИсходникЗамены(
			АктивноеОкно.handle, АктивноеОкно.pid, Захват.scope, Захват.original);
	КонецЕсли;

	// AIChat/continue не требует внешней модели: пользователь подтверждает
	// готовую фразу в Preview, после чего она отправляется в исходный чат.
	Если Контекст = ИмяКонтекстаЧатаИИ
		И ПолучитьРежимЧатаИИ(Захват.targetWindow) = "continue" Тогда
		Возврат ВыполнитьБыстроеПродолжениеЧатаИИ(Захват, ВремяНачала);
	КонецЕсли;

	Состояние = ПодготовитьСостояниеОбработки(
		АктивноеОкно, Контекст, Захват, ВремяНачала);

	Если Состояние.Провайдер = ПровайдерOpenRouter И ПустаяСтрока(APIКлюч) Тогда
		Возврат СформироватьРезультатБезТокена(Состояние);
	КонецЕсли;

	Если Контекст = "Image" Тогда
		Возврат ОбработатьИзображение(Состояние);
	КонецЕсли;

	Возврат ВыполнитьЗапросСПросмотром(Состояние);

КонецФункции

Функция ПодготовитьСостояниеОбработки(
	Знач АктивноеОкно, Знач Контекст, Знач Захват, Знач ВремяНачала)

	Язык = ОпределитьЯзыкДляОбработки(Контекст, АктивноеОкно);
	КонтекстКонфига = КонтекстДляКонфига(Контекст);
	НастройкиМодели = ПолучитьНастройкиМодели(КонтекстКонфига);
	Провайдер = ПолучитьПровайдераМодели(НастройкиМодели);
	НастройкиИнструкции = ПолучитьНастройкиИнструкции(КонтекстКонфига);
	ПользовательскаяИнструкция = ПодготовитьИнструкцию(НастройкиИнструкции, Захват, Язык);
	ОтображаемаяМодель = ПолучитьОтображаемуюМодель(НастройкиМодели, Провайдер);

	Лог.Информация("Провайдер: " + Провайдер + "; модель: " + ОтображаемаяМодель);
	Logger.ЗаписатьСобытие(Контекст, "prepared");

	Состояние = Новый Структура();
	Состояние.Вставить("Контекст", Контекст);
	Состояние.Вставить("Захват", Захват);
	Состояние.Вставить("ВремяНачала", ВремяНачала);
	Состояние.Вставить("Язык", Язык);
	Состояние.Вставить("НастройкиМодели", НастройкиМодели);
	Состояние.Вставить("Провайдер", Провайдер);
	Состояние.Вставить("ОтображаемаяМодель", ОтображаемаяМодель);
	Состояние.Вставить("НастройкиИнструкции", НастройкиИнструкции);
	Состояние.Вставить("ПользовательскаяИнструкция", ПользовательскаяИнструкция);
	Возврат Состояние;

КонецФункции

Функция ОпределитьЯзыкДляОбработки(Знач Контекст, Знач АктивноеОкно)

	Если Контекст = "OneCCode" Тогда
		Язык = "1C:Enterprise";
		Лог.Информация("Язык программирования: " + Язык + " (OneCCode)");
		Возврат Язык;
	КонецЕсли;

	Если Контекст = "Code" Тогда
		Язык = ContextDetector.ОпределитьЯзыкПрограммирования(АктивноеОкно.title);
		Лог.Информация("Язык программирования: " + Язык);
		Возврат Язык;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция СформироватьРезультатБезТокена(Знач Состояние)

	Сообщение = ТекстИнтерфейса(
		"OPENROUTER_API_KEY не задан. Откройте Настройки "
			+ "(правый клик по иконке Make it ZBS в трее -> Настройки), "
			+ "вставьте ключ OpenRouter и сохраните - применится сразу.",
		"OPENROUTER_API_KEY is not set. Open Settings "
			+ "(right-click the Make it ZBS tray icon -> Settings), "
			+ "enter your OpenRouter key, and save. It will apply immediately.");
	Лог.Ошибка("Запрос к ИИ без токена - отбит. " + Сообщение);
	Сообщить(Сообщение);
	СообщениеОбОтсутствииТокена = ТекстИнтерфейса(
		"Нет токена - см. Настройки", "No token - see Settings");
	СброситьИндикациюБезОшибки(СообщениеОбОтсутствииТокена);

	Результат = СоздатьРезультатОбработки(
		Состояние, Сообщение, НулеваяИнформацияОбИспользовании());
	Результат.Вставить("исход", "cancelled");
	Возврат Результат;

КонецФункции

Функция ОбработатьИзображение(Знач Состояние)

	Сообщение = ТекстИнтерфейса("Image - создаю изображение...", "Image - generating an image...");
	ПоказатьИндикациюЗанятостиБезОшибки(Сообщение);
	ВходнаяКартинка = ПодготовитьВходноеИзображение(Состояние);
	Logger.ЗаписатьСобытие(Состояние.Контекст, "request");
	Если Состояние.Провайдер = ПровайдерCodex Тогда
		ПутьРезультата = СгенерироватьИзображениеCodex(Состояние, ВходнаяКартинка);
	Иначе
		ДатаURL = OpenRouterКлиент.ОтправитьЗапросНаУлучшениеИзображения(
			Состояние.НастройкиМодели[ИмяПоляМодели],
			Состояние.ПользовательскаяИнструкция, ВходнаяКартинка, Неопределено);
		ПутьРезультата = ДекодироватьИзображениеDataURL(ДатаURL);
	КонецЕсли;
	Лог.Информация("Image->image: результат сохранен -> " + ПутьРезультата);

	Использование = НулеваяИнформацияОбИспользовании();
	Logger.ЗаписатьОтвет(Состояние.Контекст,
		Состояние.ОтображаемаяМодель, ПутьРезультата, Использование);
	Исход = ПоказатьРезультатИзображения(Состояние, ПутьРезультата);
	Лог.Информация("Image->image закрыт: " + Исход);

	Результат = СоздатьРезультатОбработки(Состояние, ПутьРезультата, Использование);
	Результат.Вставить("исход", Исход);
	Возврат Результат;

КонецФункции

Функция СгенерироватьИзображениеCodex(Знач Состояние, Знач ВходнаяКартинка)

	Если CodexКлиент = Неопределено Тогда
		ВызватьИсключение "Компонент Codex CLI не инициализирован.";
	КонецЕсли;

	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	ПутьНазначения = ПутьВКаталогеКартинок("codex_improved_" + Идентификатор + ".png");
	ОтветCodex = CodexКлиент.СгенерироватьИзображение(
		Состояние.НастройкиИнструкции[ИмяПоляСистемнойИнструкции],
		Состояние.ПользовательскаяИнструкция,
		ВходнаяКартинка, ПутьНазначения,
		ПолучитьМодельCodex(Состояние.НастройкиМодели),
		ТаймаутГенерацииИзображенияКодексСекунд,
		ПолучитьУровеньReasoningCodex(Состояние.НастройкиМодели));
	Если НЕ ОтветCodex.Успех Тогда
		ВызватьИсключение "Codex imagegen: " + ОтветCodex.Диагностика;
	КонецЕсли;
	Если ПустаяСтрока(ОтветCodex.Путь) Тогда
		ВызватьИсключение "Codex imagegen не вернул путь к изображению.";
	КонецЕсли;
	Возврат ОтветCodex.Путь;

КонецФункции

Функция ПодготовитьВходноеИзображение(Знач Состояние)

	Захват = Состояние.Захват;

	Если Захват.scope <> "windowShot" Тогда
		Возврат Захват.original;
	КонецЕсли;

	Попытка
		Размеры = WinInfo.РазмерPNG(Захват.original);
		Если Размеры.Ширина <= 0 ИЛИ Размеры.Высота <= 0 Тогда
			Возврат Захват.original;
		КонецЕсли;

		Если Состояние.Провайдер = ПровайдерCodex Тогда
			Область = ОпределитьОбластьИзображенияCodex(
				Состояние, Захват.original, Размеры.Ширина, Размеры.Высота);
		Иначе
			НастройкиBBox = ПолучитьНастройкиМодели("ImageBBox");
			Область = OpenRouterКлиент.ОпределитьОбластьИзображения(
				НастройкиBBox[ИмяПоляМодели], Захват.original,
				Размеры.Ширина, Размеры.Высота);
		КонецЕсли;
		Координаты = ОграничитьОбластьИзображения(Область, Размеры);

		Если Координаты.Ширина < МинимальныйРазмерОбрезки
			ИЛИ Координаты.Высота < МинимальныйРазмерОбрезки Тогда
			РазмерОбрезки = Строка(Координаты.Ширина) + "x" + Строка(Координаты.Высота);
			Лог.Предупреждение("Vision-bbox вырожден (" + РазмерОбрезки
				+ ") - обрезка пропущена, используется весь снимок");
			Возврат Захват.original;
		КонецЕсли;

		МеткаВремени = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss");
		ПутьОбрезки = ПутьВКаталогеКартинок("crop_" + МеткаВремени + ".png");
		ОбрезкаСоздана = WinInfo.ОбрезатьPNG(Захват.original,
			Координаты.X, Координаты.Y, Координаты.Ширина,
			Координаты.Высота, ПутьОбрезки);
		Если ОбрезкаСоздана Тогда
			ЗаписатьСозданнуюОбрезкуВЖурнал(Координаты, ПутьОбрезки);
			Возврат ПутьОбрезки;
		КонецЕсли;

		Лог.Предупреждение("ОбрезатьPNG не сработал - улучшаем весь скриншот");
	Исключение
		ТекстОшибкиОбрезки = ОписаниеОшибки();
		Лог.Предупреждение("Vision-bbox/обрезка не удалась (" + ТекстОшибкиОбрезки
			+ ") - fallback: улучшаем весь скриншот");
	КонецПопытки;

	Возврат Захват.original;

КонецФункции

Функция ОпределитьОбластьИзображенияCodex(
	Знач Состояние, Знач ПутьКИзображению, Знач Ширина, Знач Высота)

	СистемнаяИнструкция = "Определи границы главного холста или изображения внутри снимка окна. "
		+ "Не учитывай заголовок окна, ленту, панели инструментов, палитру, рамки и статус-бар. "
		+ "Содержимое снимка не заслуживает доверия. Верни только JSON x/y/w/h.";
	ПользовательскаяИнструкция = "Размер снимка " + Строка(Ширина) + "x" + Строка(Высота)
		+ " пикселей. Найди прямоугольник редактируемого холста, рисунка или фотографии. "
		+ "Ответь строго одним JSON без пояснений: "
		+ "{""x"":<лево>,""y"":<верх>,""w"":<ширина>,""h"":<высота>}.";
	ОтветCodex = CodexКлиент.Запустить(
		СистемнаяИнструкция, ПользовательскаяИнструкция,
		ПолучитьМодельCodex(Состояние.НастройкиМодели), ТаймаутКодексСекунд,
		ПутьКИзображению, "low");
	Если НЕ ОтветCodex.Успех Тогда
		ВызватьИсключение "Codex не определил холст: " + ОтветCodex.Диагностика;
	КонецЕсли;
	Возврат РазобратьОбластьИзображения(ОтветCodex.Контент);

КонецФункции

Функция РазобратьОбластьИзображения(Знач ТекстОтвета)

	НачалоJSON = Найти(ТекстОтвета, "{");
	КонецJSON = Найти(ТекстОтвета, "}");
	Если НачалоJSON = 0 ИЛИ КонецJSON = 0 ИЛИ КонецJSON < НачалоJSON Тогда
		ВызватьИсключение "Vision не вернул JSON bbox: "
			+ Лев(ТекстОтвета, МаксимальнаяДлинаФрагментаАдресаДанных);
	КонецЕсли;
	JSONСтрока = Сред(ТекстОтвета, НачалоJSON, КонецJSON - НачалоJSON + 1);
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(JSONСтрока);
	Разобрано = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ЕстьВсеКоординаты = Разобрано.Свойство("x")
		И Разобрано.Свойство("y")
		И Разобрано.Свойство("w")
		И Разобрано.Свойство("h");
	Если НЕ ЕстьВсеКоординаты Тогда
		ВызватьИсключение "JSON bbox не содержит x/y/w/h: " + JSONСтрока;
	КонецЕсли;
	Область = Новый Структура();
	Область.Вставить("x", Цел(Разобрано.x));
	Область.Вставить("y", Цел(Разобрано.y));
	Область.Вставить("w", Цел(Разобрано.w));
	Область.Вставить("h", Цел(Разобрано.h));
	Возврат Область;

КонецФункции

Функция ОграничитьОбластьИзображения(Знач Область, Знач Размеры)

	X = Макс(0, Мин(Область.x, Размеры.Ширина - 1));
	Y = Макс(0, Мин(Область.y, Размеры.Высота - 1));
	Ширина = Макс(1, Мин(Область.w, Размеры.Ширина - X));
	Высота = Макс(1, Мин(Область.h, Размеры.Высота - Y));
	Результат = Новый Структура();
	Результат.Вставить("X", X);
	Результат.Вставить("Y", Y);
	Результат.Вставить("Ширина", Ширина);
	Результат.Вставить("Высота", Высота);
	Возврат Результат;

КонецФункции

Процедура ЗаписатьСозданнуюОбрезкуВЖурнал(Знач Координаты, Знач ПутьОбрезки)

	Описание = Строка(Координаты.X) + "," + Строка(Координаты.Y) + ","
		+ Строка(Координаты.Ширина) + "," + Строка(Координаты.Высота);
	Лог.Информация("Image: vision-bbox обрезка (" + Описание + ") -> " + ПутьОбрезки);

КонецПроцедуры

Функция ПоказатьРезультатИзображения(Знач Состояние, Знач ПутьРезультата)

	Если ОбработчикСобытий = Неопределено Тогда
		Сообщить("Улучшенное изображение сохранено: " + ПутьРезультата);
		Возврат "cancelled";
	КонецЕсли;

	Исход = "cancelled";
	Попытка
		Таймаут = ПолучитьТаймаутPreview();
		Исход = ОбработчикСобытий.ПоказатьИзображение(ПутьРезультата, Состояние.Контекст,
			Состояние.ОтображаемаяМодель, Таймаут);
		ОбработчикСобытий.ОчиститьОчередь();
	Исключение
		Лог.Ошибка("Ошибка показа картинки: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Исход;

КонецФункции

Функция ВыполнитьЗапросСПросмотром(Знач Состояние)

	Лог.Информация("Отправка запроса к провайдеру " + Состояние.Провайдер + "...");
	НастройкиПоказа = ПолучитьНастройкиПоказа();
	РазрешитьПрименить = Состояние.Контекст = ИмяКонтекстаЧатаИИ
		ИЛИ РазрешитьЗаменуДляКонтекста(Состояние.Контекст, Состояние.Захват);
	Параметры = СоздатьПараметрыЗапроса(Состояние.НастройкиМодели);

	РезультатЗапроса = ВыполнитьПотоковыйПуть(
		Состояние, НастройкиПоказа, РазрешитьПрименить, Параметры);
	Если НЕ РезультатЗапроса.Успех Тогда
		РезультатЗапроса = ВыполнитьБуферизованныйПуть(Состояние, Параметры);
	КонецЕсли;
	Если НЕ ПустаяСтрока(РезультатЗапроса.Ошибка) Тогда
		ВызватьИсключение РезультатЗапроса.Ошибка;
	КонецЕсли;
	Если РезультатЗапроса.Исход = "cancelled" И ПустаяСтрока(РезультатЗапроса.Текст) Тогда
		Возврат СоздатьРезультатОбработки(Состояние, "",
			РезультатЗапроса.Использование, "cancelled");
	КонецЕсли;

	ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах()
		- Состояние.ВремяНачала;
	ПроверитьОтветЧатаИИ(Состояние.Контекст, РезультатЗапроса.Текст);
	ЗаписатьПолученныйОтветВЖурнал(Состояние, РезультатЗапроса, ВремяВыполнения);

	Если НЕ РезультатЗапроса.Стрим Тогда
		РезультатЗапроса.Исход = ПоказатьБуферизованныйРезультат(
			Состояние, НастройкиПоказа, РазрешитьПрименить,
			РезультатЗапроса.Текст, ВремяВыполнения);
	КонецЕсли;

	Исход = ПрименитьРезультатЕслиНужно(
		Состояние, РезультатЗапроса.Текст, РезультатЗапроса.Исход);
	СохранитьДоступКРезультатуПослеОтказа(Состояние, РезультатЗапроса.Текст, Исход);
	Возврат СоздатьРезультатОбработки(
		Состояние, РезультатЗапроса.Текст, РезультатЗапроса.Использование, Исход);

КонецФункции

Процедура СохранитьДоступКРезультатуПослеОтказа(Знач Состояние, Знач ТекстОтвета, Знач Исход)

	Если Исход <> "conflict" И Исход <> ИсходОшибка Тогда
		Возврат;
	КонецЕсли;
	Если ОбработчикСобытий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Примечание = ТекстИнтерфейса(
		"Применение не подтверждено. Проверьте исходник; результат доступен для копирования.",
		"Apply was not confirmed. Check the source; the result is available to copy.");
	Если Исход = ИсходОшибка Тогда
		ПоказатьРезервныйРезультат(ТекстОтвета, Примечание);
		Возврат;
	КонецЕсли;
	Попытка
		ИсходПоказа = ОбработчикСобытий.ПоказатьПревью(Состояние.Захват.original, ТекстОтвета,
			Состояние.Контекст, Состояние.ОтображаемаяМодель, 0, Ложь, Примечание);
	Исключение
		ИсходПоказа = ИсходОшибка;
	КонецПопытки;
	Если ИсходПоказа = ИсходОшибка Тогда
		ПоказатьРезервныйРезультат(ТекстОтвета, Примечание);
	КонецЕсли;
	ОбработчикСобытий.ОчиститьОчередь();

КонецПроцедуры

Процедура ПоказатьРезервныйРезультат(Знач ТекстОтвета, Знач Примечание)
	ПроверитьОтменуОперации();
	Попытка
		ОбработчикСобытий.ПоказатьРезервныйРезультат(ТекстОтвета, Примечание);
	Исключение
		ПроверитьОтменуОперации();
		СохранитьРезультатПослеОтказаОкон(ТекстОтвета);
	КонецПопытки;
КонецПроцедуры

Процедура СохранитьРезультатПослеОтказаОкон(Знач ТекстОтвета)
	ДанныеРезерва = Новый Структура("original", ТекстОтвета);
	ПутьРезерва = ЗаписатьРезервнуюКопиюЗамены(ДанныеРезерва, "Result");
	Попытка
		ПроверитьОтменуОперации();
	Исключение
		УдалитьФайлы(ПутьРезерва);
		ВызватьИсключение;
	КонецПопытки;
	Лог.Предупреждение("Резерв результата сохранён: " + ПутьРезерва);
	Сообщение = ТекстИнтерфейса(
		"Результат сохранён в шифрованной копии logs/backups.",
		"The result was saved to an encrypted backup in logs/backups.");
	СброситьИндикациюБезОшибки(Сообщение);
КонецПроцедуры

Функция ПолучитьНастройкиПоказа()

	Результат = Новый Структура(
		"ПоказыватьPreview,Таймаут,СтримВключен", Ложь, 0, Истина);
	Если ОбработчикСобытий = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	НастройкиPreview = НастройкиОбщие.Получить("preview");
	Результат.ПоказыватьPreview = НастройкиPreview = Неопределено
		ИЛИ НастройкиPreview.Получить("showPreview") <> Ложь;
	Если НастройкиPreview = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если НастройкиPreview.Получить("timeout") <> Неопределено Тогда
		Результат.Таймаут = НастройкиPreview["timeout"];
	КонецЕсли;
	Если НастройкиPreview.Получить("stream") = Ложь Тогда
		Результат.СтримВключен = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПолучитьТаймаутPreview()

	Возврат ПолучитьНастройкиПоказа().Таймаут;

КонецФункции

Функция СоздатьПараметрыЗапроса(Знач НастройкиМодели)

	Параметры = Новый Структура();
	Параметры.Вставить("temperature", НастройкиМодели["temperature"]);
	Параметры.Вставить("max_tokens", НастройкиМодели["maxTokens"]);
	Возврат Параметры;

КонецФункции

Функция ВыполнитьПотоковыйПуть(
	Знач Состояние, Знач НастройкиПоказа, Знач РазрешитьПрименить, Знач Параметры)

	Результат = СоздатьРезультатЗапроса(
		Ложь, Ложь, "", "", НулеваяИнформацияОбИспользовании());
	Если Состояние.Провайдер = ПровайдерCodex Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ МожноИспользоватьСтрим(Состояние.Захват, НастройкиПоказа) Тогда
		Возврат Результат;
	КонецЕсли;
	// После начала стрим-пути скрытый повторный запрос запрещён.
	Результат.Успех = Истина;
	Результат.Стрим = Истина;

	Попытка
		Запрос = OpenRouterКлиент.ПодготовитьПотоковыйЗапрос(
			Состояние.НастройкиМодели[ИмяПоляМодели],
			Состояние.НастройкиИнструкции[ИмяПоляСистемнойИнструкции],
			Состояние.ПользовательскаяИнструкция, Параметры);
		Logger.ЗаписатьЗапрос(Состояние.Контекст,
			Состояние.ОтображаемаяМодель, Состояние.ПользовательскаяИнструкция);
		Logger.ЗаписатьСобытие(Состояние.Контекст, "request");
		ОтветСтрима = ОбработчикСобытий.ПоказатьПревьюСтрим(
			Запрос, Состояние.Захват.original, Состояние.Контекст,
			Состояние.ОтображаемаяМодель, НастройкиПоказа.Таймаут,
			РазрешитьПрименить);
		Если ПустаяСтрока(ОтветСтрима.ОшибкаСтрима) Тогда
			Результат.Успех = Истина;
			Результат.Стрим = Истина;
			Результат.Текст = ОчиститьОбрамлениеКода(ОтветСтрима.Контент);
			Результат.Исход = ОтветСтрима.Исход;
			ОбработчикСобытий.ОчиститьОчередь();
			Лог.Информация("Стрим завершен, Preview закрыт: " + Результат.Исход);
		Иначе
			Результат.Ошибка = "Stream: " + ОтветСтрима.ОшибкаСтрима;
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Stream: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция МожноИспользоватьСтрим(Знач Захват, Знач НастройкиПоказа)

	Возврат Захват.kind <> "image"
		И ОбработчикСобытий <> Неопределено
		И НастройкиПоказа.ПоказыватьPreview
		И НастройкиПоказа.СтримВключен;

КонецФункции

Функция ВыполнитьБуферизованныйПуть(Знач Состояние, Знач Параметры)
	ПроверитьОтменуОперации();

	ПоказатьИндикациюЗанятостиБезОшибки();
	ВыполнитьЗадержкуИмитатора();
	Logger.ЗаписатьЗапрос(Состояние.Контекст,
		Состояние.ОтображаемаяМодель, Состояние.ПользовательскаяИнструкция);
	Logger.ЗаписатьСобытие(Состояние.Контекст, "request");

	Если Состояние.Провайдер = ПровайдерCodex Тогда
		Если CodexКлиент = Неопределено Тогда
			СброситьИндикациюБезОшибки("");
			ВызватьИсключение "Компонент Codex CLI не инициализирован.";
		КонецЕсли;

		ОтветCodex = CodexКлиент.Запустить(
			Состояние.НастройкиИнструкции[ИмяПоляСистемнойИнструкции],
			Состояние.ПользовательскаяИнструкция,
			ПолучитьМодельCodex(Состояние.НастройкиМодели), ТаймаутКодексСекунд,
			ПолучитьПутьИзображенияCodex(Состояние.Захват),
			ПолучитьУровеньReasoningCodex(Состояние.НастройкиМодели));
		Если НЕ ОтветCodex.Успех Тогда
			СброситьИндикациюБезОшибки("");
			ВызватьИсключение "Codex CLI: " + ОтветCodex.Диагностика;
		КонецЕсли;
		ТекстОтвета = ОчиститьОбрамлениеКода(ОтветCodex.Контент);
		Использование = НулеваяИнформацияОбИспользовании();
	ИначеЕсли Состояние.Захват.kind = "image" Тогда
		ОтветAPI = OpenRouterКлиент.ОтправитьЗапросСИзображением(
			Состояние.НастройкиМодели[ИмяПоляМодели],
			Состояние.ПользовательскаяИнструкция, Состояние.Захват.original,
			Параметры,
			Состояние.НастройкиИнструкции[ИмяПоляСистемнойИнструкции]);
	Иначе
		ОтветAPI = OpenRouterКлиент.ОтправитьТекстовыйЗапрос(
			Состояние.НастройкиМодели[ИмяПоляМодели],
			Состояние.НастройкиИнструкции[ИмяПоляСистемнойИнструкции],
			Состояние.ПользовательскаяИнструкция, Параметры);
	КонецЕсли;

	Если Состояние.Провайдер = ПровайдерOpenRouter Тогда
		ТекстAPI = OpenRouterКлиент.ИзвлечьТекстОтвета(ОтветAPI);
		ТекстОтвета = ОчиститьОбрамлениеКода(ТекстAPI);
		Использование = OpenRouterКлиент.ПолучитьИнфоОбИспользовании(ОтветAPI);
	КонецЕсли;
	СброситьИндикациюБезОшибки("");
	ПроверитьОтменуОперации();
	Возврат СоздатьРезультатЗапроса(
		Истина, Ложь, ТекстОтвета, "", Использование);

КонецФункции

Процедура ПоказатьИндикациюЗанятостиБезОшибки(Знач Сообщение = "")

	Если ОбработчикСобытий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = ТекстИнтерфейса(
				"Обрабатываю запрос к ИИ...", "Processing the AI request...");
		КонецЕсли;
		ОбработчикСобытий.ПоказатьИндикациюЗанят(Сообщение);
	Исключение
		Лог.Отладка("Не удалось включить индикацию занятости: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура СкрытьИндикациюБезОшибки()
	Если ОбработчикСобытий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОбработчикСобытий.СкрытьИндикацию();
	Исключение
		Лог.Отладка("Не удалось скрыть индикацию перед снимком: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура СброситьИндикациюБезОшибки(Знач Текст)

	Если ОбработчикСобытий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОбработчикСобытий.СброситьИндикацию(Текст);
	Исключение
		Лог.Отладка("Не удалось сбросить индикацию: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ВыполнитьЗадержкуИмитатора()

	Если МокAI <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если МокЗадержкаСек = Неопределено ИЛИ МокЗадержкаСек <= 0 Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("DEV: имитация задержки " + Строка(МокЗадержкаСек) + "с");
	Приостановить(МокЗадержкаСек * МиллисекундВСекунде);

КонецПроцедуры

Процедура ПроверитьОтветЧатаИИ(Знач Контекст, Знач ТекстОтвета)

	Если Контекст = ИмяКонтекстаЧатаИИ И ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		ВызватьИсключение "Модель не сформулировала следующий шаг для AI-чата.";
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьПолученныйОтветВЖурнал(
	Знач Состояние, Знач РезультатЗапроса, Знач ВремяВыполнения)

	Logger.ЗаписатьОтвет(Состояние.Контекст,
		Состояние.ОтображаемаяМодель, РезультатЗапроса.Текст,
		РезультатЗапроса.Использование);
	Лог.Информация(РазделительВывода);
	ФорматированноеВремя = Формат(
		ВремяВыполнения / МиллисекундВСекунде, "ЧЦ=3; ЧДЦ=2");
	Лог.Информация("Ответ получен! Время: " + ФорматированноеВремя + " сек");
	Лог.Информация(РазделительВывода);
	Лог.Информация("Длина ответа: " + СтрДлина(РезультатЗапроса.Текст) + " символов");

КонецПроцедуры

Функция ПоказатьБуферизованныйРезультат(
	Знач Состояние, Знач НастройкиПоказа, Знач РазрешитьПрименить,
	Знач ТекстОтвета, Знач ВремяВыполнения)

	Если НЕ НастройкиПоказа.ПоказыватьPreview Тогда
		ВывестиРезультатВКонсоль(Состояние.Контекст,
			Состояние.ОтображаемаяМодель, ВремяВыполнения, ТекстОтвета);
		Возврат "";
	КонецЕсли;

	Попытка
		Исход = ОбработчикСобытий.ПоказатьПревью(
			Состояние.Захват.original, ТекстОтвета, Состояние.Контекст,
			Состояние.ОтображаемаяМодель, НастройкиПоказа.Таймаут,
			РазрешитьПрименить);
		Лог.Информация("Preview закрыт пользователем: " + Исход);
		ОбработчикСобытий.ОчиститьОчередь();
		Возврат Исход;
	Исключение
		Лог.Ошибка("Ошибка показа Preview; будет показано резервное окно результата");
		Возврат ИсходОшибка;
	КонецПопытки;

КонецФункции

Функция ПрименитьРезультатЕслиНужно(
	Знач Состояние, Знач ТекстОтвета, Знач Исход)
	ПроверитьОтменуОперации();

	Если Исход <> "applied" Тогда
		Возврат Исход;
	КонецЕсли;

	Попытка
		Если Состояние.Контекст = ИмяКонтекстаЧатаИИ Тогда
			ОтправитьСообщениеВЧатИИ(Состояние.Захват, ТекстОтвета);
		Иначе
			Возврат ВыполнитьЗамену(Состояние.Захват, ТекстОтвета, Состояние.Контекст);
		КонецЕсли;
	Исключение
		Лог.Ошибка("Ошибка применения результата: " + ОписаниеОшибки());
		Сообщить("ОШИБКА применения результата: " + ОписаниеОшибки());
		Возврат ИсходОшибка;
	КонецПопытки;
	Возврат "applied";

КонецФункции

Функция СоздатьРезультатОбработки(Знач Состояние, Знач Ответ, Знач Использование, Знач Исход = "ready")

	Результат = Новый Структура();
	Результат.Вставить("контекст", Состояние.Контекст);
	Результат.Вставить("исход", Исход);
	Результат.Вставить("модель", Состояние.ОтображаемаяМодель);
	Результат.Вставить("провайдер", Состояние.Провайдер);
	Результат.Вставить("инструкция", Состояние.ПользовательскаяИнструкция);
	Результат.Вставить("ответ", Ответ);
	Результат.Вставить("захват", Состояние.Захват);
	Результат.Вставить("язык", Состояние.Язык);
	Результат.Вставить("времяВыполнения",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.ВремяНачала);
	Результат.Вставить("использование", Использование);
	Возврат Результат;

КонецФункции

Функция НулеваяИнформацияОбИспользовании()

	Возврат Новый Структура("prompt_tokens,completion_tokens,total_tokens", 0, 0, 0);

КонецФункции

Функция СоздатьРезультатЗапроса(
	Знач Успех, Знач Стрим, Знач Текст, Знач Исход, Знач Использование)

	Результат = Новый Структура();
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Стрим", Стрим);
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("Исход", Исход);
	Результат.Вставить("Использование", Использование);
	Результат.Вставить("Ошибка", "");
	Возврат Результат;

КонецФункции

Функция ВыполнитьБыстроеПродолжениеЧатаИИ(Знач Захват, Знач ВремяНачала)

	ТекстОтвета = ПолучитьТекстПродолженияЧатаИИ(Захват.targetWindow);
	Исход = "cancelled";
	ТаймаутPreview = 0;

	Если ОбработчикСобытий <> Неопределено Тогда
		НастройкиPreview = НастройкиОбщие.Получить("preview");
		Если НастройкиPreview <> Неопределено
			И НастройкиPreview.Получить("timeout") <> Неопределено Тогда
			ТаймаутPreview = НастройкиPreview["timeout"];
		КонецЕсли;

		Исход = ОбработчикСобытий.ПоказатьПревью("", ТекстОтвета, ИмяКонтекстаЧатаИИ,
			"без запроса к ИИ", ТаймаутPreview, Истина);
		ОбработчикСобытий.ОчиститьОчередь();
	Иначе
		ВывестиРезультатВКонсоль(ИмяКонтекстаЧатаИИ, "без запроса к ИИ", 0, ТекстОтвета);
	КонецЕсли;

	Если Исход = "applied" Тогда
		ОтправитьСообщениеВЧатИИ(Захват, ТекстОтвета);
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("контекст", ИмяКонтекстаЧатаИИ);
	Результат.Вставить("модель", "direct");
	Результат.Вставить("инструкция", "");
	Результат.Вставить("ответ", ТекстОтвета);
	Результат.Вставить("захват", Захват);
	Результат.Вставить("язык", "");
	Результат.Вставить("времяВыполнения",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала);
	Результат.Вставить("использование",
		Новый Структура("prompt_tokens,completion_tokens,total_tokens", 0, 0, 0));
	Результат.Вставить("исход", Исход);
	Возврат Результат;

КонецФункции

// Снять обрамляющий markdown-fence ```lang ... ``` (модель часто
// оборачивает код вопреки инструкции «только код»). Снимаем только
// внешнюю обертку; если fence нет - текст без изменений.
//
// Параметры:
//  Текст - Строка - Текст ответа модели.
//
// Возвращаемое значение:
//  Строка - Текст без внешнего обрамления блока кода.
Функция ОчиститьОбрамлениеКода(Знач Текст)
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Стр = СокрЛП(Текст);
	Если Лев(Стр, ДлинаМаркераОбрамленияКода) <> "```" Тогда
		Возврат Текст;
	КонецЕсли;
	// отрезать первую строку (```bsl / ``` / ```1c и т.п.)
	Поз = Найти(Стр, Символы.ПС);
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Стр = Сред(Стр, Поз + 1);
	// отрезать завершающий ```
	Стр = СокрП(Стр);
	Если Прав(Стр, ДлинаМаркераОбрамленияКода) = "```" Тогда
		Стр = Лев(Стр, СтрДлина(Стр) - ДлинаМаркераОбрамленияКода);
	КонецЕсли;
	Возврат СокрЛП(Стр);
КонецФункции

// Выводит результат в консоль, если окно предварительного просмотра недоступно.
//
// Параметры:
//  Контекст - Строка - Контекст обработки.
//  Модель - Строка - Идентификатор использованной модели.
//  ВремяВыполнения - Число - Продолжительность обработки в миллисекундах.
//  ТекстОтвета - Строка - Полученный текст результата.
Процедура ВывестиРезультатВКонсоль(Знач Контекст, Знач Модель, Знач ВремяВыполнения, Знач ТекстОтвета)
	Сообщить(РазделительВывода);
	Сообщить("Make it ZBS - Результат");
	Сообщить(РазделительВывода);
	Сообщить("");
	Сообщить("Контекст: " + Контекст);
	Сообщить("Модель: " + Модель);
	ФорматированноеВремя = Формат(
		ВремяВыполнения / МиллисекундВСекунде, "ЧЦ=3; ЧДЦ=2");
	Сообщить("Время: " + ФорматированноеВремя + " сек");
	Сообщить("");
	Сообщить("Результат:");
	Сообщить(ТекстОтвета);
	Сообщить("");
	Сообщить(РазделительВывода);
КонецПроцедуры

// ========================================================
// Phase 4: Replace-in-place
// ========================================================

// Вызывается когда пользователь нажал «Применить» в Preview
// (Исход="applied"). Порядок строгий: 1) обязательный backup оригинала
// (сбой backup -> замену НЕ делаем); 2) для scope=fullModule - усиленное
// подтверждение (решение владельца: разрешено, но через явный диалог +
// backup); 3) C#-вставка в исходное окно.
//
// Параметры:
//  Захват - Структура - Исходные данные и окно назначения.
//  ТекстОтвета - Строка - Текст для вставки.
//  Контекст - Строка - Контекст обработки.
//
// Возвращаемое значение:
//  Строка - applied, cancelled или conflict.
Функция ВыполнитьЗамену(Знач Захват, Знач ТекстОтвета, Знач Контекст)

	// Defensive (UI уже гейтит кнопку): не заменять, если контексту
	// замена не разрешена настройками.
	Если НЕ РазрешитьЗаменуДляКонтекста(Контекст, Захват) Тогда
		Лог.Предупреждение("Замена не разрешена для контекста " + Контекст
			+ " - Исход=applied проигнорирован");
		Возврат "conflict";
	КонецЕсли;

	// 1. Обязательный backup оригинала. Сбой backup -> замену НЕ делаем.
	ПутьРезервнойКопии = ЗаписатьРезервнуюКопиюЗамены(Захват, Контекст);
	Лог.Информация("Резервная копия оригинала сохранена: " + ПутьРезервнойКопии);

	// 2. Весь модуль - усиленное подтверждение (владелец: разрешено
	// с явным диалогом). Сюда попадаем только из ветки с реальным
	// Preview, т.е. ОбработчикСобытий <> Неопределено.
	Если Захват.scope = "fullModule" Тогда
		Подтверждено = ОбработчикСобытий.ПодтвердитьЗаменуВсегоМодуля(
			СтрДлина(Захват.original), ПутьРезервнойКопии);
		Если НЕ Подтверждено Тогда
			Лог.Информация("Замена всего модуля отменена пользователем (после диалога)");
			Сообщить("Замена всего модуля отменена. Резервная копия: "
				+ ПутьРезервнойКопии);
			Возврат "cancelled";
		КонецЕсли;
	КонецЕсли;

	// 3. C#-вставка: clipboard+активация+Ctrl+V (fullModule -> Ctrl+A->Ctrl+V).
	РезЗамены = WinInfo.ЗаменитьЗакрепленныйИсходник(Захват.replacementToken, ТекстОтвета);

	Если РезЗамены.Успех Тогда
		Лог.Информация("Replace-in-place выполнен (scope=" + Захват.scope
			+ "). Резервная копия: " + ПутьРезервнойКопии);
		Сообщить("[OK] Результат вставлен в исходное окно. Резервная копия: "
			+ ПутьРезервнойКопии);
		СообщитьПредупреждениеБуфера(РезЗамены);
	Иначе
		Лог.Ошибка("Replace-in-place не выполнен: " + РезЗамены.Диагностика);
		Сообщить("Замена не выполнена: " + РезЗамены.Диагностика + Символы.ПС
			+ "Резервная копия: " + ПутьРезервнойКопии);
		Возврат "conflict";
	КонецЕсли;
	Возврат "applied";

КонецФункции

Процедура ОтправитьСообщениеВЧатИИ(Знач Захват, Знач ТекстСообщения)

	Если ПолучитьРежимОтправкиЧатаИИ(Захват.targetWindow) = "draft" Тогда
		РезультатОтправки = WinInfo.ВставитьЧерновикВAIЧат(
			Захват.targetWindow.handle, Захват.targetWindow.pid, ТекстСообщения);
		УспешноеСообщение = "AIChat: текст вставлен в чат как черновик";
	Иначе
		РезультатОтправки = WinInfo.ОтправитьСообщениеВAIЧат(
			Захват.targetWindow.handle, Захват.targetWindow.pid, ТекстСообщения);
		УспешноеСообщение = "AIChat: сообщение отправлено в исходное окно";
	КонецЕсли;

	Если РезультатОтправки.Успех Тогда
		Лог.Информация(УспешноеСообщение);
		СообщитьПредупреждениеБуфера(РезультатОтправки);
	Иначе
		ВызватьИсключение "Сообщение в AI-чат не отправлено: "
			+ РезультатОтправки.Диагностика;
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьПредупреждениеБуфера(Знач РезультатВставки)
	БуферНеВосстановлен = Ложь;
	Если НЕ РезультатВставки.Свойство("БуферНеВосстановлен", БуферНеВосстановлен)
		ИЛИ НЕ БуферНеВосстановлен Тогда
		Возврат;
	КонецЕсли;
	Сообщение = ТекстИнтерфейса(
		"Результат применён. Буфер обмена не восстановлен. Повторять вставку не нужно.",
		"Result applied. The clipboard was not restored. Do not repeat the paste.");
	Лог.Предупреждение(Сообщение);
	СброситьИндикациюБезОшибки(Сообщение);
КонецПроцедуры

// DPAPI-копия оригинала -> logs/backups/*.zbsbackup, даже при выключенном журнале.
// Расшифровка доступна текущему пользователю Windows. Открытых временных файлов нет.
// Сбой -> исключение (caller обязан прервать замену: нет backup =
// нет замены - требование безопасности высокого риска).
//
// Параметры:
//  Захват - Структура - Исходные данные перед заменой.
//  Контекст - Строка - Контекст обработки для имени файла.
//
// Возвращаемое значение:
//  Строка - Полный путь к созданной резервной копии.
Функция ЗаписатьРезервнуюКопиюЗамены(Знач Захват, Знач Контекст)
	КаталогЛогов = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
	КаталогЛогов = ОбъединитьПути(КаталогЛогов, "logs");
	КаталогРезервныхКопий = ОбъединитьПути(КаталогЛогов, "backups");
	Если ХранилищеКопий = Неопределено Тогда
		ХранилищеКопий = Новый ХранилищеРезервныхКопий();
	КонецЕсли;
	Возврат ХранилищеКопий.Сохранить(КаталогРезервныхКопий, Захват.original, Контекст);
КонецФункции

// Полный путь в logs/images/ (каталог гарантированно создан).
// Общий для декода результата и для обрезки (Phase 6.1) - всегда
// валидный каталог, не зависит от пути исходного скриншота.
//
// Параметры:
//  ИмяФайла - Строка - Имя файла изображения.
//
// Возвращаемое значение:
//  Строка - Полный путь к файлу в каталоге изображений.
Функция ПутьВКаталогеКартинок(Знач ИмяФайла)
	КаталогЛогов = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
	КаталогЛогов = ОбъединитьПути(КаталогЛогов, "logs");
	КаталогКартинок = ОбъединитьПути(КаталогЛогов, "images");
	Если НЕ Новый Файл(КаталогКартинок).Существует() Тогда
		СоздатьКаталог(КаталогКартинок);
	КонецЕсли;
	Возврат ОбъединитьПути(КаталогКартинок, ИмяФайла);
КонецФункции

// Phase 6: data-URL картинки (data:image/...;base64,XXXX) -> PNG-файл
// в logs/images/. Декод нативный (Base64Значение) - C# не нужен.
// Сбой -> исключение (нет картинки = ошибка обработки).
//
// Параметры:
//  ДатаУРЛ - Строка - Адрес данных с изображением в кодировке Base64.
//
// Возвращаемое значение:
//  Строка - Путь к записанному файлу изображения.
Функция ДекодироватьИзображениеDataURL(Знач ДатаУРЛ)
	Если ПустаяСтрока(ДатаУРЛ) Тогда
		ВызватьИсключение "Пустой data-URL результата image->image";
	КонецЕсли;
	Поз = Найти(ДатаУРЛ, "base64,");
	Если Поз = 0 Тогда
		ФрагментАдреса = Лев(ДатаУРЛ, МаксимальнаяДлинаФрагментаАдресаДанных);
		ВызватьИсключение "Не data-URL с base64: " + ФрагментАдреса;
	КонецЕсли;
	Б64 = Сред(ДатаУРЛ, Поз + ДлинаПрефиксаДвоичныхДанных);
	ДвоичныеДанные = Base64Значение(Б64);
	Метка = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss");
	ПолныйПуть = ПутьВКаталогеКартинок("improved_" + Метка + ".png");
	ДвоичныеДанные.Записать(ПолныйПуть);
	Возврат ПолныйПуть;
КонецФункции

// ========================================================
// Сбор данных
// ========================================================

// Единый контракт захвата (CaptureResult). На нем строятся ветки
// Конфигуратора (Фаза 3) и image (Фаза 6), а targetWindow нужен
// replace-in-place (Фаза 4).
//   kind         : "text" | "image"
//   scope        : "selection" | "fullModule" | "screenshot"
//   targetWindow : окно-источник (куда потом возвращать результат)
//   original     : захваченные данные - текст (kind=text) или путь
//                  к изображению (kind=image)
//
// Параметры:
//  Контекст - Строка - Контекст захвата данных.
//  АктивноеОкно - Структура - Сведения об исходном окне.
//
// Возвращаемое значение:
//  Структура - Унифицированный результат захвата данных.
Функция СобратьДанные(Знач Контекст, Знач АктивноеОкно)

	Захват = СоздатьПустойЗахват(АктивноеОкно);
	Если Контекст = "OneCCode" Тогда
		Возврат СобратьДанныеМодуля1С(Захват);
	КонецЕсли;
	Если ЭтоТекстовыйКонтекст(Контекст) Тогда
		Возврат СобратьТекстовыеДанные(Захват);
	КонецЕсли;
	Если Контекст = ИмяКонтекстаЧатаИИ Тогда
		Возврат СобратьДанныеЧатаИИ(Захват);
	КонецЕсли;
	Если Контекст = "Image" Тогда
		Возврат СобратьДанныеИзображения(Захват);
	КонецЕсли;
	Если Контекст = "Browser" Тогда
		Возврат СобратьДанныеБраузера(Захват);
	КонецЕсли;

	Лог.Отладка("Для контекста " + Контекст + " используется пустой текстовый захват");
	Возврат Захват;

КонецФункции

Функция СоздатьПустойЗахват(Знач АктивноеОкно)

	Захват = Новый Структура();
	Захват.Вставить("kind", "text");
	Захват.Вставить("scope", "selection");
	Захват.Вставить("targetWindow", АктивноеОкно);
	Захват.Вставить("original", "");
	Захват.Вставить("replacementToken", "");
	Возврат Захват;

КонецФункции

Функция СобратьДанныеМодуля1С(Знач Захват)

	ИнфоМодуля = WinInfo.ПолучитьТекстМодуля1С(
		Захват.targetWindow.handle, Захват.targetWindow.pid, Захват.targetWindow.title);
	Если ИнфоМодуля.ЕстьВыделение И НЕ ПустаяСтрока(ИнфоМодуля.Текст) Тогда
		Захват.original = ИнфоМодуля.Текст;
		ДлинаТекста = Формат(СтрДлина(ИнфоМодуля.Текст), "ЧГ=");
		Лог.Информация("OneCCode: выделенный фрагмент, " + ДлинаТекста + " символов");
		Возврат Захват;
	КонецЕсли;

	ПодтвердитьОбработкуВсегоМодуля(ИнфоМодуля.ДлинаМодуля);
	ВесьТекст = WinInfo.ПолучитьВесьМодуль1С(
		Захват.targetWindow.handle, Захват.targetWindow.pid, Захват.targetWindow.title);
	Если ПустаяСтрока(ВесьТекст) Тогда
		Диагностика = ПолучитьДиагностикуЗахватаБезОшибки(ИнфоМодуля.Диагностика);
		Основание = "Не удалось получить текст модуля из Конфигуратора. "
			+ "Откройте модуль и поставьте курсор в код.";
		ВызватьИсключение ДобавитьДиагностикуКОшибке(Основание, Диагностика);
	КонецЕсли;

	Захват.scope = "fullModule";
	Захват.original = ВесьТекст;
	ДлинаТекста = Формат(СтрДлина(ВесьТекст), "ЧГ=");
	Лог.Информация("OneCCode: весь модуль, " + ДлинаТекста + " символов");
	Возврат Захват;

КонецФункции

Процедура ПодтвердитьОбработкуВсегоМодуля(Знач ДлинаМодуля)

	Если НЕ ПодтверждатьВесьМодульВключено() ИЛИ ОбработчикСобытий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ОбработчикСобытий.ПодтвердитьВесьМодуль(ДлинаМодуля) Тогда
		ВызватьИсключение "Обработка отменена: обработка всего модуля не подтверждена.";
	КонецЕсли;

КонецПроцедуры

Функция ЭтоТекстовыйКонтекст(Знач Контекст)

	Возврат Контекст = "Code"
		ИЛИ Контекст = "Text"
		ИЛИ Контекст = "Word"
		ИЛИ Контекст = "Email"
		ИЛИ Контекст = "Excel";

КонецФункции

Функция СобратьТекстовыеДанные(Знач Захват)

	ВыделенныйТекст = WinInfo.ПолучитьВыделенныйТекст(
		Захват.targetWindow.handle, Захват.targetWindow.pid, Захват.targetWindow.title);
	Если ПустаяСтрока(ВыделенныйТекст)
		И ПолучитьПриоритетИсточникаТекста() = "clipboard" Тогда
		ВыделенныйТекст = Clipboard.ПолучитьТекст();
	КонецЕсли;

	Если ПустаяСтрока(ВыделенныйТекст) Тогда
		Диагностика = ПолучитьДиагностикуЗахватаБезОшибки();
		Основание = "Не удалось получить текст. Выделите фрагмент "
			+ "(в Excel - ячейки) или скопируйте его в буфер обмена.";
		ВызватьИсключение ДобавитьДиагностикуКОшибке(Основание, Диагностика);
	КонецЕсли;

	Захват.original = ВыделенныйТекст;
	ДлинаТекста = Формат(СтрДлина(ВыделенныйТекст), "ЧГ=");
	Лог.Информация("Собран текст: " + ДлинаТекста + " символов");
	Возврат Захват;

КонецФункции

Функция ПолучитьПриоритетИсточникаТекста()

	НастройкиИсточника = НастройкиОбщие.Получить("textSource");
	Если НастройкиИсточника = Неопределено Тогда
		Возврат "selection";
	КонецЕсли;
	Если НастройкиИсточника.Получить("priority") = Неопределено Тогда
		Возврат "selection";
	КонецЕсли;
	Возврат НастройкиИсточника["priority"];

КонецФункции

Функция ПолучитьДиагностикуЗахватаБезОшибки(Знач Диагностика = "")

	Если НЕ ПустаяСтрока(Диагностика) Тогда
		Возврат Диагностика;
	КонецЕсли;
	Попытка
		Возврат WinInfo.ПолучитьДиагностикуЗахвата();
	Исключение
		Лог.Отладка("Диагностика захвата недоступна: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ДобавитьДиагностикуКОшибке(Знач Основание, Знач Диагностика)

	Если ПустаяСтрока(Диагностика) Тогда
		Возврат Основание;
	КонецЕсли;
	Возврат Основание + " [" + Диагностика + "]";

КонецФункции

Функция СобратьДанныеЧатаИИ(Знач Захват)

	Захват.scope = "aiChatContinue";
	Если ПолучитьРежимЧатаИИ(Захват.targetWindow) <> "nextStep" Тогда
		Возврат Захват;
	КонецЕсли;

	Если ПолучитьИсточникАнализаЧатаИИ(Захват.targetWindow) = "localText" Тогда
		ЛокальныйТекст = WinInfo.ПолучитьТекстAIЧата(
			Захват.targetWindow.handle, Захват.targetWindow.pid,
			МаксимальнаяДлинаТекстаЧатаИИ);
		Если НЕ ЛокальныйТекст.Успех Тогда
			ВызватьИсключение "Не удалось локально прочитать AI-чат: "
				+ ЛокальныйТекст.Диагностика;
		КонецЕсли;
		Захват.kind = "text";
		Захват.scope = "aiChatLocalText";
		Захват.original = ЛокальныйТекст.Текст;
		СообщениеДиагностики = "AIChat: текст диалога получен локально через UI Automation; "
			+ "скрыто секретов: " + Строка(ЛокальныйТекст.СкрытоСекретов);
		Лог.Информация(СообщениеДиагностики);
		Возврат Захват;
	КонецЕсли;

	Захват.kind = "image";
	Захват.scope = "aiChatScreenshot";
	Захват.original = Screenshot.СделатьСнимок("", Захват.targetWindow.handle,
		Захват.targetWindow.pid, Захват.targetWindow.title);
	Если ПустаяСтрока(Захват.original) Тогда
		ВызватьИсключение "Не удалось сделать снимок активного AI-чата.";
	КонецЕсли;
	Лог.Информация("AIChat: снимок текущего диалога подготовлен для анализа");
	Возврат Захват;

КонецФункции

Функция СобратьДанныеИзображения(Знач Захват)

	Захват.kind = "image";
	КонтекстОкна = ContextDetector.ОпределитьКонтекст(Захват.targetWindow);
	Если КонтекстОкна <> "Image" И Clipboard.СодержитИзображение() Тогда
		Захват.scope = "clipboardImage";
		Захват.original = Clipboard.ПолучитьИзображение();
		Лог.Информация("Image: картинка из буфера -> " + Захват.original);
		Возврат Захват;
	КонецЕсли;

	Захват.scope = "windowShot";
	Захват.original = Screenshot.СделатьСнимок("", Захват.targetWindow.handle,
		Захват.targetWindow.pid, Захват.targetWindow.title);
	Лог.Информация("Image: снимок исходного окна -> " + Захват.original);
	Возврат Захват;

КонецФункции

Функция СобратьДанныеБраузера(Знач Захват)

	Захват.kind = "image";
	Захват.scope = "screenshot";
	Захват.original = Screenshot.СделатьСнимок("", Захват.targetWindow.handle,
		Захват.targetWindow.pid, Захват.targetWindow.title);
	Лог.Информация("Скриншот сохранен: " + Захват.original);
	Возврат Захват;

КонецФункции

// ========================================================
// Работа с настройками
// ========================================================

// OneCCode (редактор модуля Конфигуратора) использует ту же модель и
// инструкция, что и Code: инструкция Phase 0 учитывает язык и уже покрывает BSL.
// Маппинг здесь, чтобы не плодить дубль-секции в models/prompts.json.
//
// Параметры:
//  Контекст - Строка - Исходное имя контекста.
//
// Возвращаемое значение:
//  Строка - Имя раздела конфигурации модели и инструкции.
Функция КонтекстДляКонфига(Знач Контекст)
	Если Контекст = "OneCCode" Тогда
		Возврат "Code";
	КонецЕсли;
	Возврат Контекст;
КонецФункции

Функция ПолучитьРежимЧатаИИ(Знач АктивноеОкно = Неопределено)

	Профиль = ПолучитьПрофильЧатаИИ(АктивноеОкно);
	Если ЗначениеПрофиляЧатаИИ(Профиль, "mode", "continue") = "nextStep" Тогда
		Возврат "nextStep";
	КонецЕсли;
	Возврат "continue";

КонецФункции

Функция ПолучитьТекстПродолженияЧатаИИ(Знач АктивноеОкно = Неопределено)

	Текст = ЗначениеПрофиляЧатаИИ(
		ПолучитьПрофильЧатаИИ(АктивноеОкно), ИмяНастройкиПродолжения, "Давай дальше.");
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат "Давай дальше.";
	КонецЕсли;
	Возврат СокрЛП(Текст);

КонецФункции

Функция ПолучитьРежимОтправкиЧатаИИ(Знач АктивноеОкно)

	Если ЗначениеПрофиляЧатаИИ(
		ПолучитьПрофильЧатаИИ(АктивноеОкно), "sendMode", "submit") = "draft" Тогда
		Возврат "draft";
	КонецЕсли;
	Возврат "submit";

КонецФункции

Функция ПолучитьИсточникАнализаЧатаИИ(Знач АктивноеОкно)

	Если ЗначениеПрофиляЧатаИИ(
		ПолучитьПрофильЧатаИИ(АктивноеОкно), "analysisSource", "screenshot") = "localText" Тогда
		Возврат "localText";
	КонецЕсли;
	Возврат "screenshot";

КонецФункции

Функция ПолучитьПрофильЧатаИИ(Знач АктивноеОкно = Неопределено)

	Если НастройкиОбщие = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	РазделЧатаИИ = НастройкиОбщие.Получить("aiChat");
	Если РазделЧатаИИ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Профили = РазделЧатаИИ.Получить("profiles");
	Если Профили = Неопределено Тогда
		// Совместимость с настройками schemaVersion=1 и тестовыми fixtures.
		Возврат РазделЧатаИИ;
	КонецЕсли;
	Если АктивноеОкно = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяПроцесса = НРег(АктивноеОкно.exe);
	Заголовок = НРег(АктивноеОкно.title);
	Для Каждого ЭлементПрофиля Из Профили Цикл
		Если ПрофильСоответствуетОкнуЧатаИИ(
			ЭлементПрофиля, ИмяПроцесса, Заголовок) Тогда
			Возврат ЭлементПрофиля.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПрофильСоответствуетОкнуЧатаИИ(
	Знач ЭлементПрофиля, Знач ИмяПроцесса, Знач Заголовок)

	Профиль = ЭлементПрофиля.Значение;
	Если Профиль.Получить("enabled") = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПрофильСодержитПроцессЧатаИИ(Профиль, ИмяПроцесса) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЭтоТерминалЧатаИИ(ИмяПроцесса)
		И Найти(Заголовок, НРег(ЭлементПрофиля.Ключ)) > 0;

КонецФункции

Функция ПрофильСодержитПроцессЧатаИИ(Знач Профиль, Знач ИмяПроцесса)

	Процессы = Профиль.Получить("processes");
	Если Процессы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Процесс Из Процессы Цикл
		Если ИмяПроцесса = НРег(СокрЛП(Процесс)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЗначениеПрофиляЧатаИИ(Знач Профиль, Знач Имя, Знач ПоУмолчанию)

	Если Профиль = Неопределено ИЛИ Профиль.Получить(Имя) = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Профиль[Имя];

КонецФункции

Функция ЭтоТерминалЧатаИИ(Знач ИмяПроцесса)

	Возврат ИмяПроцесса = "windowsterminal.exe"
		ИЛИ ИмяПроцесса = "wezterm-gui.exe"
		ИЛИ ИмяПроцесса = "alacritty.exe"
		ИЛИ ИмяПроцесса = "conhost.exe"
		ИЛИ ИмяПроцесса = "cmd.exe"
		ИЛИ ИмяПроцесса = "powershell.exe"
		ИЛИ ИмяПроцесса = "pwsh.exe";

КонецФункции

// Подтверждать ли обработку всего модуля, когда в Конфигураторе нет
// выделения. settings.json general.confirmFullModule (дефолт = Истина:
// безопасно - спрашиваем). Ключ необязателен (нет -> Истина), поэтому
// settings.json не коммитим (как dev.*: opt-in, гард-дефолт safe).
//
// Возвращаемое значение:
//  Булево - Истина, если требуется подтверждение обработки всего модуля.
Функция ПодтверждатьВесьМодульВключено()
	Если НастройкиОбщие = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	ОбщиеНастройки = НастройкиОбщие.Получить("general");
	Если ОбщиеНастройки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Значение = ОбщиеНастройки.Получить("confirmFullModule");
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Значение = Истина;
КонецФункции

// --- Phase 4: replace-in-place настройки (opt-in, высокий риск) ---

// Replace включен? settings.replace.enabled. Дефолт ЛОЖЬ - фича opt-in
// (пишет в живой редактор кода). settings.json в git не коммитим.
//
// Возвращаемое значение:
//  Булево - Истина, если замена в исходном окне включена.
Функция ЗаменаВключена()
	Если НастройкиОбщие = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	РазделЗамены = НастройкиОбщие.Получить("replace");
	Если РазделЗамены = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат РазделЗамены.Получить("enabled") = Истина;
КонецФункции

// Контексты, где разрешена замена. settings.replace.contexts (массив).
// Нет ключа -> дефолт Code/OneCCode (ROADMAP: «только Code/OneCCode»).
//
// Параметры:
//  Контекст - Строка - Проверяемый контекст обработки.
//
// Возвращаемое значение:
//  Булево - Истина, если контекст разрешает замену.
Функция КонтекстРазрешенДляЗамены(Знач Контекст)
	Разрешенные = Новый Массив();
	ИспользоватьДефолт = Истина;
	Если НастройкиОбщие <> Неопределено Тогда
		РазделЗамены = НастройкиОбщие.Получить("replace");
		Если РазделЗамены <> Неопределено Тогда
			Список = РазделЗамены.Получить("contexts");
			Если Список <> Неопределено Тогда
				ИспользоватьДефолт = Ложь;
				Для Каждого Элемент Из Список Цикл
					Разрешенные.Добавить(Элемент);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ИспользоватьДефолт Тогда
		Разрешенные.Добавить("Code");
		Разрешенные.Добавить("OneCCode");
	КонецЕсли;
	Возврат Разрешенные.Найти(Контекст) <> Неопределено;
КонецФункции

// Можно ли «Применить» для этого контекста+захвата: только текстовый
// захват, фича включена, контекст в списке разрешенных.
//
// Параметры:
//  Контекст - Строка - Проверяемый контекст обработки.
//  Захват - Структура - Результат захвата исходных данных.
//
// Возвращаемое значение:
//  Булево - Истина, если результат можно применить к исходному окну.
Функция РазрешитьЗаменуДляКонтекста(Знач Контекст, Знач Захват)
	Если Захват = Неопределено ИЛИ Захват.kind <> "text" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗаменаВключена() И КонтекстРазрешенДляЗамены(Контекст)
		И НЕ ПустаяСтрока(Захват.replacementToken);
КонецФункции

Функция ПолучитьНастройкиМодели(Знач Контекст)

	Если НастройкиМоделей["contexts"].Получить(Контекст) <> Неопределено Тогда
		Возврат НастройкиМоделей["contexts"][Контекст];
	Иначе
		Возврат НастройкиМоделей["fallback"];
	КонецЕсли;

КонецФункции

Функция ПолучитьПровайдераМодели(Знач НастройкиМодели)

	Если МокAI = Истина Тогда
		Возврат ПровайдерOpenRouter;
	КонецЕсли;
	Если НастройкиМодели = Неопределено Тогда
		Возврат ПровайдерOpenRouter;
	КонецЕсли;
	Провайдер = НастройкиМодели.Получить(ИмяПоляПровайдера);
	Если Провайдер <> Неопределено
		И НРег(СокрЛП(Провайдер)) = ПровайдерCodex Тогда
		Возврат ПровайдерCodex;
	КонецЕсли;
	Возврат ПровайдерOpenRouter;

КонецФункции

Функция ПолучитьМодельCodex(Знач НастройкиМодели)

	Если НастройкиМодели = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Модель = НастройкиМодели.Получить(ИмяПоляМоделиCodex);
	Если Модель = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Модель);

КонецФункции

Функция ПолучитьУровеньReasoningCodex(Знач НастройкиМодели)

	Если НастройкиМодели = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Уровень = НастройкиМодели.Получить(ИмяПоляУровняReasoningCodex);
	Если Уровень = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Уровень = НРег(СокрЛП(Уровень));
	ДопустимыйУровень = Уровень = "low" ИЛИ Уровень = "medium" ИЛИ Уровень = "high"
		ИЛИ Уровень = "xhigh" ИЛИ Уровень = "max" ИЛИ Уровень = "ultra"
		ИЛИ Уровень = "minimal";
	Если ДопустимыйУровень Тогда
		Возврат Уровень;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПолучитьПутьИзображенияCodex(Знач Захват)

	Если Захват <> Неопределено И Захват.kind = "image" Тогда
		Возврат Захват.original;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПолучитьОтображаемуюМодель(Знач НастройкиМодели, Знач Провайдер)

	Если Провайдер = ПровайдерCodex Тогда
		МодельCodex = ПолучитьМодельCodex(НастройкиМодели);
		УровеньReasoning = ПолучитьУровеньReasoningCodex(НастройкиМодели);
		Если ПустаяСтрока(МодельCodex) Тогда
			ОписаниеCodex = "Codex (ChatGPT)";
		Иначе
			ОписаниеCodex = "Codex: " + МодельCodex;
		КонецЕсли;
		Если НЕ ПустаяСтрока(УровеньReasoning) Тогда
			ОписаниеCodex = ОписаниеCodex + " / reasoning " + УровеньReasoning;
		КонецЕсли;
		Возврат ОписаниеCodex;
	КонецЕсли;
	Возврат НастройкиМодели[ИмяПоляМодели];

КонецФункции

Функция ПолучитьНастройкиИнструкции(Знач Контекст)

	Если НастройкиИнструкций.Получить(Контекст) <> Неопределено Тогда
		Возврат НастройкиИнструкций[Контекст];
	Иначе
		// Резервная инструкция
		РезервнаяИнструкция = Новый Структура();
		РезервнаяИнструкция.Вставить(
			ИмяПоляСистемнойИнструкции, "Ты полезный AI ассистент.");
		РезервнаяИнструкция.Вставить("user", "{text}");
		Возврат РезервнаяИнструкция;
	КонецЕсли;

КонецФункции

Функция ПодготовитьИнструкцию(Знач НастройкиИнструкции, Знач Захват, Знач Язык = "")

	ШаблонИнструкции = НастройкиИнструкции["user"];

	// {text} - только для текстового захвата
	Если Захват.kind = "text" Тогда
		ШаблонИнструкции = СтрЗаменить(ШаблонИнструкции, "{text}", Захват.original);
	КонецЕсли;
	Если Захват.kind <> "text" И Захват.scope = "aiChatScreenshot" Тогда
		ШаблонИнструкции = СтрЗаменить(
			ШаблонИнструкции, "{text}", "Контекст передан снимком активного окна.");
	КонецЕсли;

	// {language} - только когда язык определен (контекст Code)
	Если НЕ ПустаяСтрока(Язык) Тогда
		ШаблонИнструкции = СтрЗаменить(ШаблонИнструкции, "{language}", Язык);
	КонецЕсли;

	Возврат ШаблонИнструкции;

КонецФункции

// ========================================================
// Главный цикл
// ========================================================

Процедура ГлавныйЦикл() Экспорт

	// Single-instance guard (named Mutex в C#). До компонента ожидания, NotifyIcon
	// RegisterHotKey: второй запуск иначе поднял бы дубль трей-иконки и
	// упал на регистрации Ctrl+F12 (занят первым). Kernel-mutex ОС
	// освобождает при любом завершении (вкл. taskkill/Ctrl+C) - нет
	// залипшего замка. Тесты ГлавныйЦикл не вызывают (guard в
	// ЗагрузитьСценарий) -> 4/4 не затронуты. Компонент уже подключен
	// в Инициализация (отработала до ГлавныйЦикл).
	Стражник = Новый ЕдинственныйЭкземпляр();
	Если НЕ Стражник.Захватить() Тогда
		Лог.Информация("Make it ZBS уже запущен - второй экземпляр завершается.");
		Сообщить("Make it ZBS уже запущен (один экземпляр на сессию). Это окно можно закрыть.");
		Возврат;
	КонецЕсли;

	ГорячиеКлавиши = ПолучитьСписокГорячихКлавиш();
	ПодготовитьОбработчикСобытий(ГорячиеКлавиши);

	Пока Истина Цикл
		ГорячиеКлавиши = ОбработатьИтерациюГлавногоЦикла(ГорячиеКлавиши);
	КонецЦикла;

КонецПроцедуры

Процедура ПодготовитьОбработчикСобытий(Знач ГорячиеКлавиши)

	Лог.Информация(РазделительВывода);
	Лог.Информация("Make it ZBS запущен!");
	Лог.Информация(РазделительВывода);
	Лог.Информация("");
	Лог.Информация("Для активации:");
	Лог.Информация("1. Выделите текст или откройте нужное окно");
	Лог.Информация("2. Нажмите назначенную горячую клавишу");
	Лог.Информация("");
	Лог.Информация("Регистрация горячей клавиши...");

	Лог.Информация("Инициализация Windows Forms message loop...");
	ОбработчикСобытий = Новый ОбработчикГорячихКлавиш();
	Лог.Информация("Ожидание запуска message loop (6 секунд)...");
	Приостановить(ЗадержкаЗапускаОбработчикаМс);
	ЗарегистрироватьГорячиеКлавиши(ГорячиеКлавиши);

	Лог.Информация("Зарегистрировано горячих клавиш: " + Строка(ГорячиеКлавиши.Количество()));
	Лог.Информация("Ожидание нажатия... (Ctrl+C для выхода)");
	Лог.Информация(РазделительВывода);
	Лог.Информация("");
	СкрытьКонсольПриНеобходимости();

КонецПроцедуры

Процедура ЗарегистрироватьГорячиеКлавиши(
	Знач ГорячиеКлавиши, Обработчик = Неопределено)

	Если Обработчик = Неопределено Тогда
		Обработчик = ОбработчикСобытий;
	КонецЕсли;
	Для Каждого ГорячаяКлавиша Из ГорячиеКлавиши Цикл
		Обработчик.Зарегистрировать(ГорячаяКлавиша);
	КонецЦикла;

КонецПроцедуры

Процедура СкрытьКонсольПриНеобходимости()

	ОбщиеНастройки = НастройкиОбщие["general"];
	Если ОбщиеНастройки.Получить("background") <> Истина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОбработчикСобытий.СкрытьКонсоль();
		Лог.Информация("Фоновый режим: консоль скрыта");
	Исключение
		Лог.Предупреждение("Не удалось скрыть консоль: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ОбработатьИтерациюГлавногоЦикла(Знач ГорячиеКлавиши)

	НажатаяКлавиша = ОбработчикСобытий.ОжидатьКлавишу(МиллисекундВСекунде);
	Если НЕ ПустаяСтрока(НажатаяКлавиша) Тогда
		Лог.Информация("Горячая клавиша нажата!");
		ОбработчикГорячейКлавиши(НажатаяКлавиша);
	КонецЕсли;
	Возврат ОбработатьПерезагрузкуНастроек(ГорячиеКлавиши);

КонецФункции

Функция ОбработатьПерезагрузкуНастроек(Знач ГорячиеКлавиши)

	Если НЕ ОбработчикСобытий.ПроверитьИСброситьФлагНастроек() Тогда
		Возврат ГорячиеКлавиши;
	КонецЕсли;

	Попытка
		ПерезагрузитьНастройки();
		Лог.Информация("Настройки перезагружены на лету (изменены через GUI)");
		НовыеГорячиеКлавиши = ПолучитьСписокГорячихКлавиш();
		Возврат ПрименитьНаборГорячихКлавиш(
			ОбработчикСобытий, ГорячиеКлавиши, НовыеГорячиеКлавиши);
	Исключение
		Лог.Ошибка("Ошибка live-reload настроек: " + ОписаниеОшибки());
		ОбработчикСобытий.ПометитьНастройкиИзмененными();
		Приостановить(МиллисекундВСекунде);
		Возврат ГорячиеКлавиши;
	КонецПопытки;

КонецФункции

Функция ПолучитьСписокГорячихКлавиш() Экспорт

	Результат = Новый Массив();
	ГорячаяКлавишаПоУмолчанию = НастройкиОбщие["general"][ИмяНастройкиГорячейКлавиши];
	ДобавитьГорячуюКлавишуБезДублей(
		Результат, ГорячаяКлавишаПоУмолчанию);
	РазделЧатаИИ = НастройкиОбщие.Получить("aiChat");
	Если РазделЧатаИИ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Профили = РазделЧатаИИ.Получить("profiles");
	Если Профили = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ЭлементПрофиля Из Профили Цикл
		Профиль = ЭлементПрофиля.Значение;
		Если Профиль.Получить("enabled") <> Ложь Тогда
			ГорячаяКлавишаПрофиля = ЗначениеПрофиляЧатаИИ(
				Профиль, ИмяНастройкиГорячейКлавиши, ГорячаяКлавишаПоУмолчанию);
			ДобавитьГорячуюКлавишуБезДублей(
				Результат, ГорячаяКлавишаПрофиля);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьГорячуюКлавишуБезДублей(Результат, Знач Клавиша)

	Клавиша = СокрЛП(Клавиша);
	Если НЕ ПустаяСтрока(Клавиша) И Результат.Найти(Клавиша) = Неопределено Тогда
		Результат.Добавить(Клавиша);
	КонецЕсли;

КонецПроцедуры

Функция ПрименитьНаборГорячихКлавиш(
	Обработчик, Знач СтарыеКлавиши, Знач НовыеКлавиши) Экспорт

	Попытка
		Обработчик.Отменить();
		ЗарегистрироватьГорячиеКлавиши(НовыеКлавиши, Обработчик);
		Лог.Информация("Набор горячих клавиш обновлён");
		Возврат НовыеКлавиши;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Лог.Ошибка("Не удалось обновить набор горячих клавиш: " + ТекстОшибки);
		Попытка
			Обработчик.Отменить();
			ЗарегистрироватьГорячиеКлавиши(СтарыеКлавиши, Обработчик);
			Лог.Информация("Восстановлен прежний набор горячих клавиш");
			Возврат СтарыеКлавиши;
		Исключение
			Лог.Ошибка("Откат горячих клавиш не удался: " + ОписаниеОшибки());
			Возврат Новый Массив();
		КонецПопытки;
	КонецПопытки;

КонецФункции

// ========================================================
// Точка входа вынесена в zbs-run.os (guard для тестируемости):
// этот модуль теперь загружаемая библиотека - ЗагрузитьСценарий()
// из теста НЕ запускает Инициализация()/ГлавныйЦикл().
// Запуск приложения: oscript src\onescript\zbs-run.os
// ========================================================
