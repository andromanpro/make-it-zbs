// ========================================================
// Make it ZBS - Точка входа (лаунчер)
// ========================================================
// Тонкая обертка: загружает zbs-main-polling.os как библиотеку
// и запускает приложение. Вынесено отдельно, чтобы тесты могли
// загружать главный модуль через ЗагрузитьСценарий() без запуска
// бесконечного ГлавныйЦикл().
// ========================================================

ПутьКЯдру = ОбъединитьПути(ТекущийСценарий().Каталог, "zbs-main-polling.os");
РазделительВывода = "========================================";

Попытка
	Приложение = ЗагрузитьСценарий(ПутьКЯдру);
	Приложение.Инициализация();
	Приложение.ГлавныйЦикл();
Исключение
	Сообщить("");
	Сообщить(РазделительВывода);
	Сообщить("КРИТИЧЕСКАЯ ОШИБКА");
	Сообщить(РазделительВывода);
	Сообщить(ОписаниеОшибки());
	Сообщить(РазделительВывода);
	ЗавершитьРаботу(1);
КонецПопытки;
