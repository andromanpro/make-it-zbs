// Консольная диагностика без файлов, внешних пакетов и глобальных настроек.
Перем МинимальныйУровень;
// Числовые уровни консольного журнала.
Перем УровеньОтладки;
// Уровень обычных информационных сообщений.
Перем УровеньИнформации;
// Уровень предупреждений о частичном отказе.
Перем УровеньПредупреждения;
// Уровень ошибок операции.
Перем УровеньОшибки;
// Уровень полного отключения консольного вывода.
Перем УровеньБезВывода;

Процедура ПриСозданииОбъекта()
	УровеньОтладки = 0;
	УровеньИнформации = 1;
	УровеньПредупреждения = 2;
	УровеньОшибки = 3;
	УровеньБезВывода = 4;
	МинимальныйУровень = УровеньИнформации;
КонецПроцедуры

// Устанавливает минимальную важность консольных сообщений.
//
// Параметры:
//  Уровень - Число - 0: отладка, 1: информация, 2: предупреждение, 3: ошибка, 4: выключен.
Процедура УстановитьУровень(Знач Уровень) Экспорт
	Если Уровень < УровеньОтладки Или Уровень > УровеньБезВывода Тогда
		ВызватьИсключение "Недопустимый уровень консольной диагностики";
	КонецЕсли;
	МинимальныйУровень = Уровень;
КонецПроцедуры

Процедура Отладка(Знач Текст) Экспорт
	Записать(УровеньОтладки, "DEBUG", Текст);
КонецПроцедуры

Процедура Информация(Знач Текст) Экспорт
	Записать(УровеньИнформации, "INFO", Текст);
КонецПроцедуры

Процедура Предупреждение(Знач Текст) Экспорт
	Записать(УровеньПредупреждения, "WARN", Текст);
КонецПроцедуры

Процедура Ошибка(Знач Текст) Экспорт
	Записать(УровеньОшибки, "ERROR", Текст);
КонецПроцедуры

Процедура Записать(Знач Уровень, Знач Имя, Знач Текст)
	Если Уровень >= МинимальныйУровень Тогда
		Сообщить(Имя + " - " + Текст);
	КонецЕсли;
КонецПроцедуры
