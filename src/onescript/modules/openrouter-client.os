// ========================================================
// OpenRouter API Клиент
// ========================================================
// HTTP клиент для взаимодействия с OpenRouter API
// Поддержка Claude, GPT-4, Gemini и других моделей
// ========================================================

// Ключ доступа к OpenRouter.
Перем APIКлюч;
// Базовый адрес OpenRouter API.
Перем БазовыйURL;
// Имя приложения для HTTP-заголовка X-Title.
Перем AppName;
// Адрес проекта для HTTP-заголовка HTTP-Referer.
Перем SiteURL;
// Журнал клиента; задаётся после инициализации.
Перем Лог;
// Имя поля JSON с ограничением количества токенов.
Перем ИмяПоляМаксимумТокенов;
// Имя поля JSON с текстовым содержимым.
Перем ИмяПоляТекст;
// Имя поля JSON со ссылкой на изображение.
Перем ИмяПоляСсылкаНаИзображение;
// Код успешного ответа HTTP.
Перем КодУспешногоОтвета;
// Максимальная длина фрагмента ответа в тексте ошибки.
Перем МаксимальнаяДлинаФрагментаОшибки;
// Буферизованный HTTPS-транспорт из штатного C#-компонента.
Перем HTTPТранспорт;

// ========================================================
// Инициализация
// ========================================================

Процедура ПриСозданииОбъекта()

	БазовыйURL = "https://openrouter.ai/api/v1";
	AppName = "MakeItZBS";
	SiteURL = "https://androman.pro";
	ИмяПоляМаксимумТокенов = "max_tokens";
	ИмяПоляТекст = "text";
	ИмяПоляСсылкаНаИзображение = "image_url";
	КодУспешногоОтвета = 200;
	МаксимальнаяДлинаФрагментаОшибки = 200;
	HTTPТранспорт = Новый ТранспортOpenRouterHTTP();

	// Логирование (будет установлено через Инициализировать)
	Лог = Неопределено;

КонецПроцедуры

// ========================================================
// Публичные методы
// ========================================================

// Инициализирует клиент OpenRouter.
//
// Параметры:
//  APIКлючПараметр - Строка - Ключ доступа к OpenRouter.
//  AppNameПараметр - Строка - Необязательное имя приложения для заголовка X-Title.
//  SiteURLПараметр - Строка - Необязательный адрес проекта для заголовка HTTP-Referer.
Процедура Инициализировать(Знач APIКлючПараметр,
	Знач AppNameПараметр = Неопределено, Знач SiteURLПараметр = Неопределено) Экспорт

	APIКлюч = APIКлючПараметр;

	Если AppNameПараметр <> Неопределено Тогда
		AppName = AppNameПараметр;
	КонецЕсли;

	Если SiteURLПараметр <> Неопределено Тогда
		SiteURL = SiteURLПараметр;
	КонецЕсли;

	ЛогИнформация("OpenRouter клиент инициализирован");

КонецПроцедуры

// Отправляет подготовленные сообщения выбранной модели.
//
// Параметры:
//  Модель - Строка - Идентификатор модели OpenRouter.
//  Сообщения - Массив - Сообщения запроса в формате OpenRouter.
//  Параметры - Структура - Необязательные параметры генерации.
//
// Возвращаемое значение:
//  Структура - Разобранный ответ OpenRouter.
Функция ОтправитьЗапрос(Знач Модель, Знач Сообщения, Знач Параметры = Неопределено) Экспорт

	Если ПустаяСтрока(APIКлюч) Тогда
		ВызватьИсключение "API ключ не установлен. Вызовите Инициализировать()";
	КонецЕсли;

	// Подготовить тело запроса
	ТелоЗапроса = Новый Структура();
	ТелоЗапроса.Вставить("model", Модель);
	ТелоЗапроса.Вставить("messages", Сообщения);

	// Отключить reasoning: DeepSeek v4 (pro/flash) на сложной инструкции
	// уходит в reasoning и съедает весь max_tokens бюджет -> пустой
	// content (completion_tokens упирается в лимит, response="").
	// Приложению нужен прямой результат, цепочка рассуждений не нужна.
	СтруктураReasoning = Новый Структура();
	СтруктураReasoning.Вставить("enabled", Ложь);
	ТелоЗапроса.Вставить("reasoning", СтруктураReasoning);

	// Добавить параметры если указаны
	Если Параметры <> Неопределено Тогда

		Если Параметры.Свойство("temperature") Тогда
			ТелоЗапроса.Вставить("temperature", Параметры.temperature);
		КонецЕсли;

		Если Параметры.Свойство(ИмяПоляМаксимумТокенов) Тогда
			ТелоЗапроса.Вставить(ИмяПоляМаксимумТокенов, Параметры.max_tokens);
		КонецЕсли;

		Если Параметры.Свойство("top_p") Тогда
			ТелоЗапроса.Вставить("top_p", Параметры.top_p);
		КонецЕсли;

	КонецЕсли;

	// Конвертировать в JSON
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ТелоЗапроса);
	JSONТело = Запись.Закрыть();

	ЛогОтладка("Отправка запроса к модели: " + Модель);
	ЛогОтладка("Тело запроса: " + JSONТело);

	// Выполнить HTTP запрос
	Попытка
		Ответ = ВыполнитьВебЗапрос("/chat/completions", "POST", JSONТело);
		Возврат ОбработатьОтвет(Ответ);
	Исключение
		ЛогОшибка("Ошибка при отправке запроса: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Отправляет системный и пользовательский текст модели.
//
// Параметры:
//  Модель - Строка - Идентификатор модели OpenRouter.
//  СистемнаяИнструкция - Строка - Системная инструкция модели.
//  ПользовательскаяИнструкция - Строка - Пользовательский запрос.
//  Параметры - Структура - Необязательные параметры генерации.
//
// Возвращаемое значение:
//  Структура - Разобранный ответ OpenRouter.
Функция ОтправитьТекстовыйЗапрос(Знач Модель, Знач СистемнаяИнструкция,
	Знач ПользовательскаяИнструкция, Знач Параметры = Неопределено) Экспорт

	Сообщения = Новый Массив();

	// System message
	Если НЕ ПустаяСтрока(СистемнаяИнструкция) Тогда
		СистемноеСообщение = Новый Структура();
		СистемноеСообщение.Вставить("role", "system");
		СистемноеСообщение.Вставить("content", СистемнаяИнструкция);
		Сообщения.Добавить(СистемноеСообщение);
	КонецЕсли;

	// User message
	ПользовательскоеСообщение = Новый Структура();
	ПользовательскоеСообщение.Вставить("role", "user");
	ПользовательскоеСообщение.Вставить("content", ПользовательскаяИнструкция);
	Сообщения.Добавить(ПользовательскоеСообщение);

	Возврат ОтправитьЗапрос(Модель, Сообщения, Параметры);

КонецФункции

// Phase 5: подготовить ПОТОКОВЫЙ запрос (stream:true) для C#-стримера.
// Возвращает Структуру {url, authHeader, bodyJson} - сам HTTP делает
// C#-компонент (1connector/платформа буферизуют, инкрементально не
// читают; подтверждено по исходникам). reasoning ВКЛЮЧЕН по verified-fix
// (reasoning.max_tokens 2000 + max_tokens>=16000 -> content непуст И
// reasoning виден; см. ROADMAP-v2 / memory gotcha). Отдельная функция,
// чтобы не дестабилизировать проверенный buffered ОтправитьЗапрос.
//
// Параметры:
//  Модель - Строка - Идентификатор модели OpenRouter.
//  СистемнаяИнструкция - Строка - Системная инструкция модели.
//  ПользовательскаяИнструкция - Строка - Пользовательский запрос.
//  Параметры - Структура - Необязательные параметры генерации.
//
// Возвращаемое значение:
//  Структура - Адрес, заголовок авторизации и JSON-тело потокового запроса.
Функция ПодготовитьПотоковыйЗапрос(Знач Модель, Знач СистемнаяИнструкция,
	Знач ПользовательскаяИнструкция, Знач Параметры = Неопределено) Экспорт

	Если ПустаяСтрока(APIКлюч) Тогда
		ВызватьИсключение "API ключ не установлен. Вызовите Инициализировать()";
	КонецЕсли;

	Сообщения = Новый Массив();
	Если НЕ ПустаяСтрока(СистемнаяИнструкция) Тогда
		СистемноеСообщение = Новый Структура();
		СистемноеСообщение.Вставить("role", "system");
		СистемноеСообщение.Вставить("content", СистемнаяИнструкция);
		Сообщения.Добавить(СистемноеСообщение);
	КонецЕсли;
	ПользовательскоеСообщение = Новый Структура();
	ПользовательскоеСообщение.Вставить("role", "user");
	ПользовательскоеСообщение.Вставить("content", ПользовательскаяИнструкция);
	Сообщения.Добавить(ПользовательскоеСообщение);

	ТелоЗапроса = Новый Структура();
	ТелоЗапроса.Вставить("model", Модель);
	ТелоЗапроса.Вставить("messages", Сообщения);
	ТелоЗапроса.Вставить("stream", Истина);

	// verified-fix: reasoning виден И content не съеден (capped).
	СтруктураReasoning = Новый Структура();
	СтруктураReasoning.Вставить(ИмяПоляМаксимумТокенов, 2000);
	ТелоЗапроса.Вставить("reasoning", СтруктураReasoning);

	// max_tokens >= 16000 обязателен для reasoning-моделей (иначе
	// reasoning съедает бюджет -> пустой content). Берем максимум.
	МаксТокены = 16000;
	Если Параметры <> Неопределено И Параметры.Свойство(ИмяПоляМаксимумТокенов)
		И Параметры.max_tokens > МаксТокены Тогда
		МаксТокены = Параметры.max_tokens;
	КонецЕсли;
	ТелоЗапроса.Вставить(ИмяПоляМаксимумТокенов, МаксТокены);

	Если Параметры <> Неопределено Тогда
		Если Параметры.Свойство("temperature") Тогда
			ТелоЗапроса.Вставить("temperature", Параметры.temperature);
		КонецЕсли;
		Если Параметры.Свойство("top_p") Тогда
			ТелоЗапроса.Вставить("top_p", Параметры.top_p);
		КонецЕсли;
	КонецЕсли;

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ТелоЗапроса);
	JSONТело = Запись.Закрыть();

	Результат = Новый Структура();
	Результат.Вставить("url", БазовыйURL + "/chat/completions");
	Результат.Вставить("authHeader", "Bearer " + APIКлюч);
	Результат.Вставить("bodyJson", JSONТело);
	ЛогОтладка("Потоковый запрос подготовлен для модели: " + Модель);
	Возврат Результат;

КонецФункции

// Phase 6: image->image. modalities:["image","text"], картинка на входе
// data-URL; ответ - сгенерированная картинка в
// choices[0].message.images[0].image_url.url (data-URL, спайк-verified).
// Buffered (image исключен из стрима). Возвращает data-URL результата.
//
// Параметры:
//  Модель - Строка - Идентификатор модели генерации изображения.
//  Инструкция - Строка - Инструкция по изменению изображения.
//  ПутьКИзображению - Строка - Путь к исходному изображению.
//  Параметры - Структура - Необязательные параметры генерации.
//
// Возвращаемое значение:
//  Строка - Адрес данных с улучшенным изображением.
Функция ОтправитьЗапросНаУлучшениеИзображения(Знач Модель, Знач Инструкция,
	Знач ПутьКИзображению, Знач Параметры = Неопределено) Экспорт

	Если ПустаяСтрока(APIКлюч) Тогда
		ВызватьИсключение "API ключ не установлен. Вызовите Инициализировать()";
	КонецЕсли;

	Base64Изображение = ПрочитатьИзображениеBase64(ПутьКИзображению);

	СодержимоеМассив = Новый Массив();
	ТекстоваяЧасть = Новый Структура();
	ТекстоваяЧасть.Вставить("type", ИмяПоляТекст);
	ТекстоваяЧасть.Вставить(ИмяПоляТекст, Инструкция);
	СодержимоеМассив.Добавить(ТекстоваяЧасть);
	ИзображениеЧасть = Новый Структура();
	ИзображениеЧасть.Вставить("type", ИмяПоляСсылкаНаИзображение);
	URLИзображения = Новый Структура();
	URLИзображения.Вставить("url", "data:image/png;base64," + Base64Изображение);
	ИзображениеЧасть.Вставить(ИмяПоляСсылкаНаИзображение, URLИзображения);
	СодержимоеМассив.Добавить(ИзображениеЧасть);
	Сообщение = Новый Структура();
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", СодержимоеМассив);
	Сообщения = Новый Массив();
	Сообщения.Добавить(Сообщение);

	Модальности = Новый Массив();
	Модальности.Добавить("image");
	Модальности.Добавить("text");

	ТелоЗапроса = Новый Структура();
	ТелоЗапроса.Вставить("model", Модель);
	ТелоЗапроса.Вставить("messages", Сообщения);
	ТелоЗапроса.Вставить("modalities", Модальности);
	Если Параметры <> Неопределено И Параметры.Свойство("temperature") Тогда
		ТелоЗапроса.Вставить("temperature", Параметры.temperature);
	КонецЕсли;

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ТелоЗапроса);
	JSONТело = Запись.Закрыть();

	ЛогОтладка("Image->image запрос, модель: " + Модель);
	Ответ = ВыполнитьВебЗапрос("/chat/completions", "POST", JSONТело);
	Результат = ОбработатьОтвет(Ответ);

	Попытка
		Если Результат.Свойство("choices") И Результат.choices.Количество() > 0 Тогда
			СообщениеОтвета = Результат.choices[0].message;
			Если СообщениеОтвета.Свойство("images")
				И СообщениеОтвета.images.Количество() > 0 Тогда
				ОбъектИзображения = СообщениеОтвета.images[0];
				Если ОбъектИзображения.Свойство(ИмяПоляСсылкаНаИзображение)
					И ОбъектИзображения.image_url.Свойство("url") Тогда
					Возврат ОбъектИзображения.image_url.url;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЛогОшибка("Не удалось извлечь картинку из ответа: " + ОписаниеОшибки());
	КонецПопытки;

	ВызватьИсключение "Ответ модели не содержит сгенерированной картинки "
		+ "(ожидался choices[0].message.images[0].image_url.url)";

КонецФункции

// Phase 6.1: шаг 1 двухшагового image->image. Vision-модель (текстовый
// ответ) возвращает bbox фотографии внутри скриншота окна. Возврат -
// Структура {x,y,w,h} в пикселях (клэмп делает оркестратор). Спайк-
// verified: gemini-2.5-flash, IoU 0.88-0.95, JSON парсится надежно.
//
// Параметры:
//  Модель - Строка - Идентификатор модели распознавания изображения.
//  ПутьКИзображению - Строка - Путь к снимку окна.
//  Ширина - Число - Ширина снимка в пикселях.
//  Высота - Число - Высота снимка в пикселях.
//
// Возвращаемое значение:
//  Структура - Координаты и размеры найденной области.
Функция ОпределитьОбластьИзображения(Знач Модель, Знач ПутьКИзображению, Знач Ширина, Знач Высота) Экспорт

	Если ПустаяСтрока(APIКлюч) Тогда
		ВызватьИсключение "API ключ не установлен. Вызовите Инициализировать()";
	КонецЕсли;

	Инструкция = "Это скриншот окна приложения " + Строка(Ширина) + "x" + Строка(Высота)
		+ " пикселей. На нем есть панели интерфейса (заголовок, панель инструментов,"
		+ " палитра, боковая панель, статус-бар и рамка окна) и один главный ХОЛСТ "
		+ "с рисунком, фотографией или редактируемым изображением. Определи "
		+ "прямоугольник именно содержимого ХОЛСТА без элементов интерфейса. "
		+ "Ответь СТРОГО одним JSON без пояснений:"
		+ " {""x"":<лево>,""y"":<верх>,""w"":<ширина>,""h"":<высота>} в"
		+ " пикселях, начало координат - левый верхний угол.";

	Base64Изображение = ПрочитатьИзображениеBase64(ПутьКИзображению);
	СодержимоеМассив = Новый Массив();
	ТекстоваяЧасть = Новый Структура();
	ТекстоваяЧасть.Вставить("type", ИмяПоляТекст);
	ТекстоваяЧасть.Вставить(ИмяПоляТекст, Инструкция);
	СодержимоеМассив.Добавить(ТекстоваяЧасть);
	ИзображениеЧасть = Новый Структура();
	ИзображениеЧасть.Вставить("type", ИмяПоляСсылкаНаИзображение);
	URLИзображения = Новый Структура();
	URLИзображения.Вставить("url", "data:image/png;base64," + Base64Изображение);
	ИзображениеЧасть.Вставить(ИмяПоляСсылкаНаИзображение, URLИзображения);
	СодержимоеМассив.Добавить(ИзображениеЧасть);
	Сообщение = Новый Структура();
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", СодержимоеМассив);
	Сообщения = Новый Массив();
	Сообщения.Добавить(Сообщение);

	ТелоЗапроса = Новый Структура();
	ТелоЗапроса.Вставить("model", Модель);
	ТелоЗапроса.Вставить("messages", Сообщения);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ТелоЗапроса);
	JSONТело = Запись.Закрыть();

	ЛогОтладка("Vision-bbox запрос, модель: " + Модель);
	Ответ = ВыполнитьВебЗапрос("/chat/completions", "POST", JSONТело);
	Результат = ОбработатьОтвет(Ответ);

	ТекстОтвета = ИзвлечьТекстОтвета(Результат);
	// модель часто оборачивает в ```json ... ```; берем подстроку {...}
	НачалоJSON = Найти(ТекстОтвета, "{");
	КонецJSON = Найти(ТекстОтвета, "}");
	Если НачалоJSON = 0 ИЛИ КонецJSON = 0 ИЛИ КонецJSON < НачалоJSON Тогда
		ВызватьИсключение "Vision не вернул JSON bbox: "
			+ Лев(ТекстОтвета, МаксимальнаяДлинаФрагментаОшибки);
	КонецЕсли;
	JSONСтрока = Сред(ТекстОтвета, НачалоJSON, КонецJSON - НачалоJSON + 1);

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(JSONСтрока);
	Разобрано = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	ВсеКоординатыЗаданы = Разобрано.Свойство("x")
		И Разобрано.Свойство("y")
		И Разобрано.Свойство("w")
		И Разобрано.Свойство("h");
	Если НЕ ВсеКоординатыЗаданы Тогда
		ВызватьИсключение "JSON bbox без ключей x/y/w/h: " + JSONСтрока;
	КонецЕсли;

	Область = Новый Структура();
	Область.Вставить("x", Цел(Разобрано.x));
	Область.Вставить("y", Цел(Разобрано.y));
	Область.Вставить("w", Цел(Разобрано.w));
	Область.Вставить("h", Цел(Разобрано.h));
	Возврат Область;

КонецФункции

// Отправляет текст и изображение модели распознавания.
//
// Параметры:
//  Модель - Строка - Идентификатор модели OpenRouter.
//  Текст - Строка - Пользовательский запрос.
//  ПутьКИзображению - Строка - Путь к исходному изображению.
//  Параметры - Структура - Необязательные параметры генерации.
//  СистемнаяИнструкция - Строка - Необязательная системная инструкция.
//
// Возвращаемое значение:
//  Структура - Разобранный ответ OpenRouter.
Функция ОтправитьЗапросСИзображением(Знач Модель, Знач Текст, Знач ПутьКИзображению,
	Знач Параметры = Неопределено, Знач СистемнаяИнструкция = "") Экспорт

	// Прочитать изображение и конвертировать в Base64
	Base64Изображение = ПрочитатьИзображениеBase64(ПутьКИзображению);

	Сообщения = Новый Массив();
	Если НЕ ПустаяСтрока(СистемнаяИнструкция) Тогда
		СистемноеСообщение = Новый Структура();
		СистемноеСообщение.Вставить("role", "system");
		СистемноеСообщение.Вставить("content", СистемнаяИнструкция);
		Сообщения.Добавить(СистемноеСообщение);
	КонецЕсли;

	// User message с изображением
	СодержимоеМассив = Новый Массив();

	// Текстовая часть
	ТекстоваяЧасть = Новый Структура();
	ТекстоваяЧасть.Вставить("type", ИмяПоляТекст);
	ТекстоваяЧасть.Вставить(ИмяПоляТекст, Текст);
	СодержимоеМассив.Добавить(ТекстоваяЧасть);

	// Часть с изображением
	ИзображениеЧасть = Новый Структура();
	ИзображениеЧасть.Вставить("type", ИмяПоляСсылкаНаИзображение);

	URLИзображения = Новый Структура();
	URLИзображения.Вставить("url", "data:image/png;base64," + Base64Изображение);

	ИзображениеЧасть.Вставить(ИмяПоляСсылкаНаИзображение, URLИзображения);
	СодержимоеМассив.Добавить(ИзображениеЧасть);

	Сообщение = Новый Структура();
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", СодержимоеМассив);

	Сообщения.Добавить(Сообщение);

	Возврат ОтправитьЗапрос(Модель, Сообщения, Параметры);

КонецФункции

// Получает список доступных моделей OpenRouter.
//
// Возвращаемое значение:
//  Структура - Разобранный ответ OpenRouter со списком моделей.
Функция ПолучитьСписокМоделей() Экспорт

	ЛогОтладка("Запрос списка моделей");

	Попытка
		Ответ = ВыполнитьВебЗапрос("/models", "GET");
		Возврат ОбработатьОтвет(Ответ);
	Исключение
		ЛогОшибка("Ошибка при получении списка моделей: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// ========================================================
// Внутренние методы
// ========================================================

Функция ВыполнитьВебЗапрос(Знач Путь, Знач Метод = "GET", Знач Тело = "")

	ПолныйURL = БазовыйURL + Путь;

	// Логирование запроса
	ЛогОтладка("HTTP " + Метод + ": " + ПолныйURL);

	Возврат HTTPТранспорт.Выполнить(
		ПолныйURL, Метод, Тело, "Bearer " + APIКлюч, SiteURL, AppName);

КонецФункции

Функция ОбработатьОтвет(Знач HTTPОтвет)

	КодСостояния = HTTPОтвет.statusCode;
	ТелоОтвета = HTTPОтвет.body;

	ЛогОтладка("Код ответа: " + КодСостояния);
	ЛогОтладка("Тело ответа: " + ТелоОтвета);

	// Проверить код ответа
	Если КодСостояния <> КодУспешногоОтвета Тогда

		// Попытаться распарсить ошибку из JSON
		Попытка
			Чтение = Новый ЧтениеJSON();
			Чтение.УстановитьСтроку(ТелоОтвета);
			ОшибкаJSON = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();

			ТекстОшибки = "HTTP " + КодСостояния;

			Если ОшибкаJSON.Свойство("error") Тогда
				Если ТипЗнч(ОшибкаJSON.error) = Тип("Структура") И ОшибкаJSON.error.Свойство("message") Тогда
					ТекстОшибки = ТекстОшибки + ": " + ОшибкаJSON.error.message;
				Иначе
					ТекстОшибки = ТекстОшибки + ": " + Строка(ОшибкаJSON.error);
				КонецЕсли;
			КонецЕсли;

			ВызватьИсключение ТекстОшибки;

		Исключение
			ВызватьИсключение "HTTP " + КодСостояния + ": " + ТелоОтвета;
		КонецПопытки;

	КонецЕсли;

	// Распарсить JSON ответ
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТелоОтвета);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция ПрочитатьИзображениеBase64(Знач ПутьКФайлу)

	ФайлОбъект = Новый Файл(ПутьКФайлу);

	Если НЕ ФайлОбъект.Существует() Тогда
		ВызватьИсключение "Файл изображения не найден: " + ПутьКФайлу;
	КонецЕсли;

	// Прочитать двоичные данные
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);

	// Конвертировать в Base64
	Base64Строка = Base64Строка(ДвоичныеДанные);

	Возврат Base64Строка;

КонецФункции

// ========================================================
// Логирование
// ========================================================

Процедура ЛогИнформация(Знач Сообщение)
	Если Лог <> Неопределено Тогда
		Лог.Информация(Сообщение);
	Иначе
		Сообщить("[INFO] " + Сообщение);
	КонецЕсли;
КонецПроцедуры

Процедура ЛогОтладка(Знач Сообщение)
	Если Лог <> Неопределено Тогда
		Лог.Отладка(Сообщение);
	КонецЕсли;
КонецПроцедуры

Процедура ЛогОшибка(Знач Сообщение)
	Если Лог <> Неопределено Тогда
		Лог.Ошибка(Сообщение);
	Иначе
		Сообщить("[ERROR] " + Сообщение);
	КонецЕсли;
КонецПроцедуры

// ========================================================
// Вспомогательные функции
// ========================================================

// Извлекает текст сообщения из ответа OpenRouter.
//
// Параметры:
//  РезультатAPI - Структура - Разобранный ответ OpenRouter.
//
// Возвращаемое значение:
//  Строка - Текст первого сообщения в ответе.
Функция ИзвлечьТекстОтвета(Знач РезультатAPI) Экспорт

	Попытка

		Если РезультатAPI.Свойство("choices") И РезультатAPI.choices.Количество() > 0 Тогда
			ПервыйВыбор = РезультатAPI.choices[0];

			Если ПервыйВыбор.Свойство("message") И ПервыйВыбор.message.Свойство("content") Тогда
				Возврат СокрЛП(ПервыйВыбор.message.content);
			КонецЕсли;
		КонецЕсли;

		ВызватьИсключение "Не удалось извлечь текст из ответа API";

	Исключение
		ЛогОшибка("Ошибка извлечения текста: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Получает статистику использования токенов.
//
// Параметры:
//  РезультатAPI - Структура - Разобранный ответ OpenRouter.
//
// Возвращаемое значение:
//  Структура - Количество токенов запроса, ответа и общий итог.
Функция ПолучитьИнфоОбИспользовании(Знач РезультатAPI) Экспорт

	Инфо = Новый Структура();
	Инфо.Вставить("prompt_tokens", 0);
	Инфо.Вставить("completion_tokens", 0);
	Инфо.Вставить("total_tokens", 0);

	Если РезультатAPI.Свойство("usage") Тогда

		Если РезультатAPI.usage.Свойство("prompt_tokens") Тогда
			Инфо.prompt_tokens = РезультатAPI.usage.prompt_tokens;
		КонецЕсли;

		Если РезультатAPI.usage.Свойство("completion_tokens") Тогда
			Инфо.completion_tokens = РезультатAPI.usage.completion_tokens;
		КонецЕсли;

		Если РезультатAPI.usage.Свойство("total_tokens") Тогда
			Инфо.total_tokens = РезультатAPI.usage.total_tokens;
		КонецЕсли;

	КонецЕсли;

	Возврат Инфо;

КонецФункции
