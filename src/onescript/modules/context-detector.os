	Для Каждого КлючЗначение Из РасширенияЯзыков Цикл
		Если СодержитРасширениеФайла(Заголовок, КлючЗначение.Ключ) Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "Unknown";

КонецФункции

// ========================================================
// Логирование
// ========================================================

Процедура ЛогИнформация(Знач Сообщение)
	Если Лог <> Неопределено Тогда
		Лог.Информация(Сообщение);
	КонецЕсли;
КонецПроцедуры
