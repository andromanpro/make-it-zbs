// ========================================================
// Context Detector - Определение контекста приложения
// ========================================================
// Умное определение типа активности пользователя
// для выбора подходящей модели ИИ и инструкции
// ========================================================

// Правила сопоставления процессов с контекстами.
Перем ПравилаКонтекстов;
// Журнал модуля; может быть недоступен при ранней инициализации.
Перем Лог;
// Приоритет контекста чата с ИИ.
Перем ПриоритетЧатаИИ;
// Приоритет обычного прикладного контекста.
Перем ПриоритетОбычногоПриложения;
// Приоритет браузера.
Перем ПриоритетБраузера;
// Приоритет текстового процессора.
Перем ПриоритетТекстовогоПроцессора;
// Приоритет приложения для работы с изображениями.
Перем ПриоритетИзображения;

// ========================================================
// Инициализация
// ========================================================

Процедура ПриСозданииОбъекта()

	ИнициализироватьПриоритеты();
	ИнициализироватьПравила();

	// Логирование
	Попытка
		Лог = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "console-log.os"));
		Лог.УстановитьУровень(1);
	Исключение
		Лог = Неопределено;
	КонецПопытки;

КонецПроцедуры

Процедура ИнициализироватьПриоритеты()

	ПриоритетЧатаИИ = 120;
	ПриоритетОбычногоПриложения = 100;
	ПриоритетБраузера = 90;
	ПриоритетТекстовогоПроцессора = 95;
	ПриоритетИзображения = 80;

КонецПроцедуры

Процедура ИнициализироватьПравила()

	ПравилаКонтекстов = Новый Структура();

	// AIChat - desktop-клиенты и CLI-агенты. Проверяется до clipboard Image:
	// скопированная картинка не должна менять смысл Ctrl+F12 в AI-чате.
	ПравилоAIChat = СоздатьПравилоКонтекста(ПриоритетЧатаИИ);
	ПравилоAIChat.процессы.Добавить("chatgpt.exe");      // Codex desktop / ChatGPT
	ПравилоAIChat.процессы.Добавить("codex.exe");
	ПравилоAIChat.процессы.Добавить("claude.exe");
	ПравилоAIChat.процессы.Добавить("opencode.exe");
	ПравилаКонтекстов.Вставить("AIChat", ПравилоAIChat);

	// Code - редакторы кода
	ПравилоCode = СоздатьПравилоКонтекста(ПриоритетОбычногоПриложения);
	ПравилоCode.процессы.Добавить("code.exe");           // VS Code
	ПравилоCode.процессы.Добавить("devenv.exe");        // Visual Studio
	ПравилоCode.процессы.Добавить("idea64.exe");        // IntelliJ IDEA
	ПравилоCode.процессы.Добавить("idea.exe");
	ПравилоCode.процессы.Добавить("rider64.exe");       // JetBrains Rider
	ПравилоCode.процессы.Добавить("pycharm64.exe");     // PyCharm
	ПравилоCode.процессы.Добавить("webstorm64.exe");    // WebStorm
	ПравилоCode.процессы.Добавить("phpstorm64.exe");    // PhpStorm
	ПравилоCode.процессы.Добавить("notepad++.exe");     // Notepad++
	ПравилоCode.процессы.Добавить("sublime_text.exe");  // Sublime Text
	ПравилоCode.процессы.Добавить("atom.exe");          // Atom
	ПравилаКонтекстов.Вставить("Code", ПравилоCode);

	// Browser - браузеры
	ПравилоBrowser = СоздатьПравилоКонтекста(ПриоритетБраузера);
	ПравилоBrowser.процессы.Добавить("chrome.exe");
	ПравилоBrowser.процессы.Добавить("firefox.exe");
	ПравилоBrowser.процессы.Добавить("msedge.exe");
	ПравилоBrowser.процессы.Добавить("opera.exe");
	ПравилоBrowser.процессы.Добавить("brave.exe");
	ПравилоBrowser.процессы.Добавить("vivaldi.exe");
	ПравилаКонтекстов.Вставить("Browser", ПравилоBrowser);

	// Excel - Microsoft Excel
	ПравилоExcel = СоздатьПравилоКонтекста(ПриоритетОбычногоПриложения);
	ПравилоExcel.процессы.Добавить("excel.exe");
	ПравилаКонтекстов.Вставить("Excel", ПравилоExcel);

	// Email - почтовые клиенты
	ПравилоEmail = СоздатьПравилоКонтекста(ПриоритетОбычногоПриложения);
	ПравилоEmail.процессы.Добавить("outlook.exe");
	ПравилоEmail.процессы.Добавить("thunderbird.exe");
	ПравилоEmail.процессы.Добавить("mailbird.exe");
	ПравилаКонтекстов.Вставить("Email", ПравилоEmail);

	// Word - текстовые процессоры
	ПравилоWord = СоздатьПравилоКонтекста(ПриоритетТекстовогоПроцессора);
	ПравилоWord.процессы.Добавить("winword.exe");
	ПравилоWord.процессы.Добавить("writer.exe");  // LibreOffice Writer
	ПравилаКонтекстов.Вставить("Word", ПравилоWord);

	// Image - приложения для изображений. Остаток картинки в буфере не
	// должен переключать Word, редактор кода или браузер в генерацию PNG.
	ПравилоImage = СоздатьПравилоКонтекста(ПриоритетИзображения);
	ПравилоImage.процессы.Добавить("mspaint.exe");       // Microsoft Paint
	ПравилоImage.процессы.Добавить("paint.exe");         // Старые версии Paint
	ПравилоImage.процессы.Добавить("photos.exe");        // Windows Photos
	ПравилоImage.процессы.Добавить("microsoft.photos.exe");  // Photos (WindowsApps)
	ПравилоImage.процессы.Добавить("i_view64.exe");      // IrfanView
	ПравилоImage.процессы.Добавить("i_view32.exe");
	ПравилоImage.процессы.Добавить("imageglass.exe");    // ImageGlass
	ПравилоImage.процессы.Добавить("nomacs.exe");        // nomacs
	ПравилоImage.процессы.Добавить("xnview.exe");        // XnView
	ПравилоImage.процессы.Добавить("xnviewmp.exe");
	ПравилаКонтекстов.Вставить("Image", ПравилоImage);

КонецПроцедуры
Функция СоздатьПравилоКонтекста(Знач Приоритет)

	Правило = Новый Структура();
	Правило.Вставить("процессы", Новый Массив());
	Правило.Вставить("приоритет", Приоритет);
	Возврат Правило;

КонецФункции

// ========================================================
// Публичные методы
// ========================================================

// Определяет контекст на основе активного окна и буфера обмена.
//
// Параметры:
//  ИнформацияОбОкне - Структура - Имя процесса и заголовок активного окна.
//  ИнформацияОБуфере - Структура, Неопределено - Признаки содержимого буфера обмена.
//  РазрешитьИзображениеИзБуфера - Булево - Явное разрешение режима Image для неизвестного приложения.
//
// Возвращаемое значение:
//  Строка - Имя обнаруженного контекста.
Функция ОпределитьКонтекст(Знач ИнформацияОбОкне, Знач ИнформацияОБуфере = Неопределено,
	Знач РазрешитьИзображениеИзБуфера = Ложь) Экспорт

	ИмяПроцесса = НРег(ИнформацияОбОкне.exe);
	Заголовок = НРег(ИнформацияОбОкне.title);

	// 0. AI-клиент имеет приоритет над содержимым clipboard. Иначе случайно
	// оставленная картинка уводит хоткей в Image вместо продолжения диалога.
	Если ЭтоЧатИИ(ИмяПроцесса, Заголовок) Тогда
		ЛогИнформация("Контекст определен: AIChat");
		Возврат "AIChat";
	КонецЕсли;

	// 1.5. 1С Конфигуратор (редактор модуля). Разведка Phase 3 на
	// реальном 1С (ЗУП 3.1, платформа 8.3.27): окно редактора модуля =
	// exe «1cv8», заголовок содержит «Модуль - Конфигуратор - <Конфа>».
	// Проверяем ДО общих правил: «1cv8» нет ни в одном списке процессов,
	// без этой ветки контекст свалился бы в Text. Признак «конфигуратор»
	// в заголовке отделяет Конфигуратор от 1С:Предприятия (там в title
	// нет слова «Конфигуратор»).
	Если ИмяПроцесса = "1cv8.exe"
		И Найти(НРег(ИнформацияОбОкне.title), "конфигуратор") > 0 Тогда
		ЛогИнформация("Контекст определен: OneCCode (редактор модуля 1С Конфигуратора)");
		Возврат "OneCCode";
	КонецЕсли;

	// 2. Определить по процессу приложения
	Для Каждого КлючЗначение Из ПравилаКонтекстов Цикл

		ИмяКонтекста = КлючЗначение.Ключ;
		Правило = КлючЗначение.Значение;

		Для Каждого Процесс Из Правило.процессы Цикл
			Если ИмяПроцесса = НРег(Процесс) Тогда
				ЛогИнформация("Контекст определен по процессу '" + ИмяПроцесса + "': " + ИмяКонтекста);
				Возврат ИмяКонтекста;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	// URL проверяется раньше расширений: www.google.com не является .go-файлом.
	Если ЗаголовокСодержитВебАдрес(Заголовок) Тогда
		ЛогИнформация("Контекст определен по заголовку (URL): Browser");
		Возврат "Browser";
	КонецЕсли;

	// 3. Определить по заголовку окна (расширенная логика)
	// Признаки редактора кода в заголовке
	Если ЗаголовокСодержитРасширениеКода(Заголовок) Тогда
		ЛогИнформация("Контекст определен по заголовку (расширение файла): Code");
		Возврат "Code";
	КонецЕсли;

	// Буфер используется только когда приложение и заголовок не определили
	// контекст. Иначе старый скриншот подменяет выделенный текст документа.
	Если РазрешенБуферИзображений(ИнформацияОБуфере, РазрешитьИзображениеИзБуфера) Тогда
		ЛогИнформация("Контекст явно разрешен по буферу обмена: Image");
		Возврат "Image";
	КонецЕсли;

	// По умолчанию - Text
	ЛогИнформация("Контекст по умолчанию: Text");
	Возврат "Text";

КонецФункции
Функция РазрешенБуферИзображений(Знач Информация, Знач Разрешить)
	Если НЕ Разрешить ИЛИ Информация = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Информация.имеетИзображение;
КонецФункции

Функция ЗаголовокСодержитРасширениеКода(Знач Заголовок)

	Расширения = Новый Массив;
	Расширения.Добавить(".cs");
	Расширения.Добавить(".js");
	Расширения.Добавить(".py");
	Расширения.Добавить(".java");
	Расширения.Добавить(".cpp");
	Расширения.Добавить(".go");

	Для Каждого Расширение Из Расширения Цикл
		Если СодержитРасширениеФайла(Заголовок, Расширение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СодержитРасширениеФайла(Знач Заголовок, Знач Расширение)

	Остаток = Заголовок;
	Разделители = " )]}|*" + Символы.Таб + Символы.ПС + Символы.ВК;
	Пока НЕ ПустаяСтрока(Остаток) Цикл
		Позиция = Найти(Остаток, Расширение);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		СледующаяПозиция = Позиция + СтрДлина(Расширение);
		Если СледующаяПозиция > СтрДлина(Остаток)
			ИЛИ Найти(Разделители, Сред(Остаток, СледующаяПозиция, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Остаток = Сред(Остаток, СледующаяПозиция);
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЗаголовокСодержитВебАдрес(Знач Заголовок)

	Возврат Найти(Заголовок, "http://") > 0
		ИЛИ Найти(Заголовок, "https://") > 0
		ИЛИ Найти(Заголовок, "www.") > 0;

КонецФункции

Функция ЭтоЧатИИ(Знач ИмяПроцесса, Знач Заголовок)

	ПравилоAIChat = Неопределено;
	Если ПравилаКонтекстов.Свойство("AIChat", ПравилоAIChat) Тогда
		Для Каждого Процесс Из ПравилоAIChat.процессы Цикл
			Если ИмяПроцесса = НРег(Процесс) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// CLI-агенты живут внутри терминала, поэтому имя процесса сообщает
	// только оболочку. Заголовок проверяем лишь для известных терминалов,
	// чтобы файл CLAUDE.md в VS Code не превращал обычный Code в AIChat.
	Терминалы = Новый Массив();
	Терминалы.Добавить("windowsterminal.exe");
	Терминалы.Добавить("wezterm-gui.exe");
	Терминалы.Добавить("alacritty.exe");
	Терминалы.Добавить("conhost.exe");
	Терминалы.Добавить("cmd.exe");
	Терминалы.Добавить("powershell.exe");
	Терминалы.Добавить("pwsh.exe");

	ЭтоТерминал = Ложь;
	Для Каждого Процесс Из Терминалы Цикл
		Если ИмяПроцесса = Процесс Тогда
			ЭтоТерминал = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЭтоТерминал Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЭтоЗаголовокКлиента(Заголовок, "codex")
		ИЛИ ЭтоЗаголовокКлиента(Заголовок, "claude")
		ИЛИ ЭтоЗаголовокКлиента(Заголовок, "opencode");

КонецФункции

Функция ЭтоЗаголовокКлиента(Знач Заголовок, Знач Имя)
	Если Лев(Заголовок, СтрДлина(Имя)) <> Имя Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрДлина(Заголовок) = СтрДлина(Имя)
		ИЛИ Найти(" -:|", Сред(Заголовок, СтрДлина(Имя) + 1, 1)) > 0;
КонецФункции

// Получить описание контекста
// Возвращает пользовательское описание контекста.
//
// Параметры:
//  ИмяКонтекста - Строка - Имя контекста.
//
// Возвращаемое значение:
//  Строка - Описание назначения контекста.
Функция ПолучитьОписаниеКонтекста(Знач ИмяКонтекста) Экспорт

	Описания = Новый Соответствие();
	Описания.Вставить("AIChat", "AI-клиент - продолжение текущей задачи");
	Описания.Вставить("Code", "Редактор кода - рефакторинг и улучшение");
	Описания.Вставить("OneCCode", "1С Конфигуратор - рефакторинг модуля");
	Описания.Вставить("Browser", "Веб-браузер - анализ страницы");
	Описания.Вставить("Excel", "Microsoft Excel - анализ данных");
	Описания.Вставить("Email", "Почтовый клиент - умный ответ");
	Описания.Вставить("Word", "Текстовый процессор - улучшение документа");
	Описания.Вставить("Image", "Изображение - анализ и генерация");
	Описания.Вставить("Text", "Текст - улучшение стиля и грамматики");

	Описание = Описания.Получить(ИмяКонтекста);

	Если Описание = Неопределено Тогда
		Возврат "Неизвестный контекст";
	Иначе
		Возврат Описание;
	КонецЕсли;

КонецФункции

// Проверить, поддерживается ли vision для контекста
// Определяет, требуется ли контексту обработка изображения.
//
// Параметры:
//  ИмяКонтекста - Строка - Имя контекста.
//
// Возвращаемое значение:
//  Булево - Истина, если контекст использует компьютерное зрение.
Функция ТребуетсяVision(Знач ИмяКонтекста) Экспорт

	VisionКонтексты = Новый Массив();
	VisionКонтексты.Добавить("AIChat");
	VisionКонтексты.Добавить("Browser");
	VisionКонтексты.Добавить("Image");

	Возврат VisionКонтексты.Найти(ИмяКонтекста) <> Неопределено;

КонецФункции

// Добавить пользовательское правило контекста
// Добавляет или заменяет правило определения контекста.
//
// Параметры:
//  ИмяКонтекста - Строка - Имя контекста.
//  СписокПроцессов - Массив из Строка - Имена процессов приложения.
//  Приоритет - Число - Приоритет правила.
Процедура ДобавитьПравило(Знач ИмяКонтекста, Знач СписокПроцессов, Знач Приоритет = 50) Экспорт

	Правило = Новый Структура();
	Правило.Вставить("процессы", СписокПроцессов);
	Правило.Вставить("приоритет", Приоритет);

	ПравилаКонтекстов.Вставить(ИмяКонтекста, Правило);

	ЛогИнформация("Добавлено правило для контекста: " + ИмяКонтекста);

КонецПроцедуры

// Получить все доступные контексты
// Возвращает имена всех зарегистрированных контекстов.
//
// Возвращаемое значение:
//  Массив из Строка - Имена контекстов.
Функция ПолучитьВсеКонтексты() Экспорт

	Результат = Новый Массив();

	Для Каждого КлючЗначение Из ПравилаКонтекстов Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Определить язык программирования по расширению файла
// Определяет язык программирования по заголовку окна редактора.
//
// Параметры:
//  ЗаголовокОкна - Строка - Заголовок активного окна.
//
// Возвращаемое значение:
//  Строка - Имя языка или Unknown.
Функция ОпределитьЯзыкПрограммирования(Знач ЗаголовокОкна) Экспорт

	Заголовок = НРег(ЗаголовокОкна);

	РасширенияЯзыков = Новый Соответствие();
	РасширенияЯзыков.Вставить(".cs", "C#");
	РасширенияЯзыков.Вставить(".js", "JavaScript");
	РасширенияЯзыков.Вставить(".ts", "TypeScript");
	РасширенияЯзыков.Вставить(".py", "Python");
	РасширенияЯзыков.Вставить(".java", "Java");
	РасширенияЯзыков.Вставить(".cpp", "C++");
	РасширенияЯзыков.Вставить(".c", "C");
	РасширенияЯзыков.Вставить(".go", "Go");
