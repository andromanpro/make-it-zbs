// ========================================================
// Logger - Система записи запросов и ответов в журнал
// ========================================================
// Сохранение истории взаимодействия с AI
// Полезно для отладки и анализа
// ========================================================

// Корневой каталог файловых журналов.
Перем КаталогЛогов;
// Разрешение сохранять пользовательские запросы.
Перем СохранятьЗапросы;
// Разрешение сохранять ответы модели.
Перем СохранятьОтветы;
// Главный выключатель всех каналов, включая ошибки и сессии.
Перем ЛогированиеВключено;
// Технический режим исключает содержимое запросов, ответов и ошибок.
Перем ТолькоДиагностика;
// Ограничение количества файлов каждого типа.
Перем МаксимальноеКоличествоФайлов;
// Тип записи с ответом модели.
Перем ТипЗаписиОтвет;
// Тип записи с ошибкой.
Перем ТипЗаписиОшибка;
// Длина случайного суффикса имени файла.
Перем ДлинаСлучайногоСуффикса;
// Количество временных захваченных файлов каждого типа.
Перем МаксимальноеКоличествоВременныхФайлов;
// Компонент владеет путями и защитой активных временных файлов.
Перем КомпонентВременныхФайлов;

// ========================================================
// Инициализация
// ========================================================

Процедура ПриСозданииОбъекта()

	КаталогЛогов = "";
	СохранятьЗапросы = Истина;
	СохранятьОтветы = Истина;
	ЛогированиеВключено = Истина;
	ТолькоДиагностика = Ложь;
	МаксимальноеКоличествоФайлов = 100;
	ТипЗаписиОтвет = "response";
	ТипЗаписиОшибка = "error";
	ДлинаСлучайногоСуффикса = 8;
	МаксимальноеКоличествоВременныхФайлов = 20;

КонецПроцедуры

// ========================================================
// Публичные методы
// ========================================================

// Инициализирует файловый журнал.
//
// Параметры:
//  КаталогЛоговПараметр - Строка - Каталог для файлов журнала.
//  Настройки - Структура, Неопределено - Параметры хранения и очистки.
//  ВременныеФайлы - БуферОбменаРасширенный, Неопределено - Владелец каталога захваченных файлов.
Процедура Инициализировать(Знач КаталогЛоговПараметр, Знач Настройки = Неопределено,
	Знач ВременныеФайлы = Неопределено) Экспорт

	КаталогЛогов = КаталогЛоговПараметр;
	КомпонентВременныхФайлов = ВременныеФайлы;
	ТолькоДиагностика = Ложь;
	ЛогированиеВключено = Истина;
	СохранятьЗапросы = Истина;
	СохранятьОтветы = Истина;
	МаксимальноеКоличествоФайлов = 100;

	// Создать каталог если не существует
	КаталогОбъект = Новый Файл(КаталогЛогов);
	Если НЕ КаталогОбъект.Существует() Тогда
		СоздатьКаталог(КаталогЛогов);
	КонецЕсли;

	// Применить настройки
	Если Настройки <> Неопределено Тогда

		// Phase 13.4 (Codex audit P2): logging.enabled - ГЛАВНЫЙ выключатель.
		// Раньше игнорировался: logger читал только logRequests/logResponses,
		// поэтому enabled=false НЕ выключал логи. Теперь enabled=false -
		// hard-off (перебивает logRequests/logResponses): не пишем ничего.
		// Приватность: raw prompt/response могут содержать выделенный
		// текст/код пользователя. Ключ может отсутствовать -> дефолт Истина
		// (текущее поведение сохраняется). Phase 15: ЛогированиеВключено -
		// модульная переменная, чтобы enabled=false гасил ВСЕ каналы,
		// включая ошибки/сессии (раньше запись ошибки сохраняла контент
		// мимо выключателя - фрагмент ответа модели в тексте ошибки).
		ЛогированиеВключено = Истина;
		ТолькоДиагностика = Настройки.Получить("diagnosticsOnly") = Истина;
		Если Настройки.Получить("enabled") <> Неопределено Тогда
			ЛогированиеВключено = Настройки["enabled"];
		КонецЕсли;

		Если НЕ ЛогированиеВключено Тогда
			СохранятьЗапросы = Ложь;
			СохранятьОтветы = Ложь;
		Иначе
			Если Настройки.Получить("logRequests") <> Неопределено Тогда
				СохранятьЗапросы = Настройки["logRequests"];
			КонецЕсли;

			Если Настройки.Получить("logResponses") <> Неопределено Тогда
				СохранятьОтветы = Настройки["logResponses"];
			КонецЕсли;
		КонецЕсли;

		Если Настройки.Получить("maxLogFiles") <> Неопределено Тогда
			МаксимальноеКоличествоФайлов = Настройки["maxLogFiles"];
		КонецЕсли;

	КонецЕсли;

	ПрименитьТехническийРежим();

	// Очистить старые логи + захваченные артефакты (retention, Phase 15)
	ОчиститьСтарыеЛоги();
	ОчиститьЗахваченныйКонтент();

КонецПроцедуры

// Записывает запрос к модели.
//
// Параметры:
//  Контекст - Строка - Контекст обработки.
//  Модель - Строка - Идентификатор модели.
//  Инструкция - Строка - Пользовательская инструкция.
//  ДополнительныеДанные - Произвольный, Неопределено - Дополнительные поля записи.
Процедура ЗаписатьЗапрос(Знач Контекст, Знач Модель, Знач Инструкция,
	Знач ДополнительныеДанные = Неопределено) Экспорт

	Если НЕ СохранятьЗапросы Тогда
		Возврат;
	КонецЕсли;

	Попытка

		// Создать структуру лога
		Лог = Новый Структура();
		Лог.Вставить("timestamp", ТекущаяДата());
		Лог.Вставить("type", "request");
		Лог.Вставить("context", Контекст);
		Лог.Вставить("model", Модель);
		Лог.Вставить("prompt", Инструкция);

		Если ДополнительныеДанные <> Неопределено Тогда
			Лог.Вставить("additional_data", ДополнительныеДанные);
		КонецЕсли;

		// Сохранить в файл
		ИмяФайла = СгенерироватьИмяФайла("request");
		СохранитьЛогВФайл(ИмяФайла, Лог);

	Исключение
		Сообщить("[Logger] Ошибка при записи запроса в журнал: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Записывает ответ модели.
//
// Параметры:
//  Контекст - Строка - Контекст обработки.
//  Модель - Строка - Идентификатор модели.
//  Ответ - Строка - Текст или путь результата.
//  ИнфоОбИспользовании - Структура, Неопределено - Статистика токенов.
Процедура ЗаписатьОтвет(Знач Контекст, Знач Модель, Знач Ответ,
	Знач ИнфоОбИспользовании = Неопределено) Экспорт

	Если НЕ СохранятьОтветы Тогда
		Возврат;
	КонецЕсли;

	Попытка

		// Создать структуру лога
		Лог = Новый Структура();
		Лог.Вставить("timestamp", ТекущаяДата());
		Лог.Вставить("type", ТипЗаписиОтвет);
		Лог.Вставить("context", Контекст);
		Лог.Вставить("model", Модель);
		Лог.Вставить("response", Ответ);

		Если ИнфоОбИспользовании <> Неопределено Тогда
			Лог.Вставить("usage", ИнфоОбИспользовании);
		КонецЕсли;

		// Сохранить в файл
		ИмяФайла = СгенерироватьИмяФайла(ТипЗаписиОтвет);
		СохранитьЛогВФайл(ИмяФайла, Лог);

	Исключение
		Сообщить("[Logger] Ошибка при записи ответа в журнал: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Записывает полную сессию обработки.
//
// Параметры:
//  Контекст - Строка - Контекст обработки.
//  Модель - Строка - Идентификатор модели.
//  Запрос - Строка - Текст запроса.
//  Ответ - Строка - Текст ответа.
//  ВремяВыполнения - Число - Продолжительность обработки в миллисекундах.
Процедура ЗаписатьСессию(Знач Контекст, Знач Модель, Знач Запрос, Знач Ответ,
	Знач ВремяВыполнения = 0) Экспорт

	// Phase 15: hard-off. Сессия = запрос+ответ (полный контент пользователя).
	Если НЕ ЛогированиеВключено ИЛИ ТолькоДиагностика Тогда
		Возврат;
	КонецЕсли;

	Попытка

		// Создать структуру лога
		Лог = Новый Структура();
		Лог.Вставить("timestamp", ТекущаяДата());
		Лог.Вставить("type", "session");
		Лог.Вставить("context", Контекст);
		Лог.Вставить("model", Модель);
		Лог.Вставить("request", Запрос);
		Лог.Вставить("response", Ответ);
		Лог.Вставить("execution_time_ms", ВремяВыполнения);

		// Сохранить в файл
		ИмяФайла = СгенерироватьИмяФайла("session");
		СохранитьЛогВФайл(ИмяФайла, Лог);

	Исключение
		Сообщить("[Logger] Ошибка при записи сессии в журнал: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Записывает ошибку обработки.
//
// Параметры:
//  Контекст - Строка - Контекст возникновения ошибки.
//  ТекстОшибки - Строка - Описание ошибки.
//  ДополнительныеДанные - Произвольный, Неопределено - Дополнительные поля записи.
Процедура ЗаписатьОшибку(Знач Контекст, Знач ТекстОшибки,
	Знач ДополнительныеДанные = Неопределено) Экспорт

	// Phase 15: hard-off. В текст ошибки попадают фрагменты ответа модели
	// (обработанный контент пользователя) - при выключенной записи журналов
	// не пишем и их.
	Если НЕ ЛогированиеВключено Тогда
		Возврат;
	КонецЕсли;
	Если ТолькоДиагностика Тогда
		ЗаписатьСобытие(Контекст, "error");
		Возврат;
	КонецЕсли;

	Попытка

		// Создать структуру лога
		Лог = Новый Структура();
		Лог.Вставить("timestamp", ТекущаяДата());
		Лог.Вставить("type", ТипЗаписиОшибка);
		Лог.Вставить("context", Контекст);
		Лог.Вставить("error", ТекстОшибки);

		Если ДополнительныеДанные <> Неопределено Тогда
			Лог.Вставить("additional_data", ДополнительныеДанные);
		КонецЕсли;

		// Сохранить в файл
		ИмяФайла = СгенерироватьИмяФайла(ТипЗаписиОшибка);
		СохранитьЛогВФайл(ИмяФайла, Лог);

	Исключение
		Сообщить("[Logger] Ошибка при записи ошибки в журнал: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Техническое событие: только фиксированные служебные поля, без контента.
//
// Параметры:
//  Контекст - Строка - Имя контекста приложения.
//  Этап - Строка - Служебный этап операции.
//  Размер - Число - Число захваченных символов.
//  ИзображениеВБуфере - Булево - Признак картинки на момент команды.
Процедура ЗаписатьСобытие(Знач Контекст, Знач Этап, Знач Размер = 0,
	Знач ИзображениеВБуфере = Ложь) Экспорт

	Если НЕ ЛогированиеВключено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Запись = Новый Структура();
		Запись.Вставить("timestamp", ТекущаяДата());
		Запись.Вставить("type", "diagnostic");
		Запись.Вставить("context", Контекст);
		Запись.Вставить("stage", Этап);
		Запись.Вставить("characters", Размер);
		Запись.Вставить("clipboardImage", ИзображениеВБуфере);
		СохранитьЛогВФайл(СгенерироватьИмяФайла("diagnostic"), Запись);
	Исключение
		Сообщить("[Logger] Не удалось записать техническое событие");
	КонецПопытки;

КонецПроцедуры

// Получить последние логи
// Возвращает последние записи журнала.
//
// Параметры:
//  Количество - Число - Максимальное количество записей.
//
// Возвращаемое значение:
//  Массив - Данные последних записей.
Функция ПолучитьПоследниеЛоги(Знач Количество = 10) Экспорт

	Результат = Новый Массив();

	Попытка

		// Получить список файлов логов
		ФайлыЛогов = НайтиФайлы(КаталогЛогов, "*.json");

		// Сортировать по времени модификации (новые первыми)
		ФайлыМассив = Новый ТаблицаЗначений();
		ФайлыМассив.Колонки.Добавить("Файл");
		ФайлыМассив.Колонки.Добавить("Дата");
		Для Каждого Файл Из ФайлыЛогов Цикл
			СтрокаФайла = ФайлыМассив.Добавить();
			СтрокаФайла.Файл = Файл;
			СтрокаФайла.Дата = Файл.ПолучитьВремяИзменения();
		КонецЦикла;
		ФайлыМассив.Сортировать("Дата Убыв");

		// Взять последние N файлов
		Счетчик = 0;
		Для Каждого СтрокаФайла Из ФайлыМассив Цикл
			Файл = СтрокаФайла.Файл;

			Если Счетчик >= Количество Тогда
				Прервать;
			КонецЕсли;

			// Прочитать и распарсить JSON
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			JSONТекст = Чтение.Прочитать();
			Чтение.Закрыть();

			ЧтениеJSON = Новый ЧтениеJSON();
			ЧтениеJSON.УстановитьСтроку(JSONТекст);
			ДанныеЛога = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			Результат.Добавить(ДанныеЛога);
			Счетчик = Счетчик + 1;

		КонецЦикла;

	Исключение
		Сообщить("[Logger] Ошибка при чтении логов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Очистить все логи
Процедура ОчиститьВсеЛоги() Экспорт

	Попытка

		ФайлыЛогов = НайтиФайлы(КаталогЛогов, "*.json");

		Для Каждого Файл Из ФайлыЛогов Цикл
			УдалитьФайлы(Файл.ПолноеИмя);
		КонецЦикла;

		Сообщить("[Logger] Все логи очищены");

	Исключение
		Сообщить("[Logger] Ошибка при очистке логов: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// ========================================================
// Внутренние методы
// ========================================================

Процедура ПрименитьТехническийРежим()
	Если ТолькоДиагностика Тогда
		СохранятьЗапросы = Ложь;
		СохранятьОтветы = Ложь;
	КонецЕсли;
КонецПроцедуры

Функция СгенерироватьИмяФайла(Знач Префикс)

	ВремяШтамп = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss");
	Случайное = Строка(Новый УникальныйИдентификатор());
	Случайное = СтрЗаменить(Случайное, "-", "");
	СлучайноеКороткое = Лев(Случайное, ДлинаСлучайногоСуффикса);

	ИмяФайла = Префикс + "_" + ВремяШтамп + "_" + СлучайноеКороткое + ".json";

	Возврат ОбъединитьПути(КаталогЛогов, ИмяФайла);

КонецФункции

Процедура СохранитьЛогВФайл(Знач ПутьКФайлу, Знач ДанныеЛога)

	// Конвертировать в JSON с отступами
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, ДанныеЛога);
	JSONТекст = Запись.Закрыть();

	// Записать в файл UTF-8 без BOM.
	// ЗаписьТекста(UTF8) пишет BOM (efbbbf) даже с ВыводитьBOM=Ложь -
	// проверено на oscript 1.9.4.16. Поэтому через двоичные данные.
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(JSONТекст, "UTF-8", Ложь);
	ДвоичныеДанные.Записать(ПутьКФайлу);

	// Долгоживущий tray-процесс может неделями не перезапускаться. Поэтому
	// лимит соблюдаем после каждой записи, а не только при Инициализировать().
	ОчиститьСтарыеЛоги();

КонецПроцедуры

// Оставляет не более заданного количества свежих файлов по маске.
//
// Параметры:
//  Каталог - Строка - Каталог для очистки.
//  Маска - Строка - Маска имён файлов.
//  МаксФайлов - Число - Максимальное количество файлов.
//
// старейшие. Phase 15: сортировка по времени изменения через ТаблицаЗначений
// (раньше был TODO - удалялись произвольные файлы в порядке НайтиФайлы, а не
// старейшие; кап maxLogFiles не соблюдался).
Процедура ОчиститьКаталогПоКоличеству(Знач Каталог, Знач Маска, Знач МаксФайлов)

	Попытка
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Возврат;
		КонецЕсли;

		Файлы = НайтиФайлы(Каталог, Маска);
		Если Файлы.Количество() <= МаксФайлов Тогда
			Возврат;
		КонецЕсли;

		ТЗ = Новый ТаблицаЗначений();
		ТЗ.Колонки.Добавить("Путь");
		ТЗ.Колонки.Добавить("Дата");
		Для Каждого Файл Из Файлы Цикл
			Если Файл.ЭтоФайл() Тогда
				Стр = ТЗ.Добавить();
				Стр.Путь = Файл.ПолноеИмя;
				Стр.Дата = Файл.ПолучитьВремяИзменения();
			КонецЕсли;
		КонецЦикла;

		ТЗ.Сортировать("Дата Возр");  // старейшие первыми

		КоличествоДляУдаления = ТЗ.Количество() - МаксФайлов;
		Для Инд = 0 По КоличествоДляУдаления - 1 Цикл
			Попытка
				УдалитьФайлы(ТЗ[Инд].Путь);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;

	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

Процедура ОчиститьСтарыеЛоги()
	ОчиститьКаталогПоКоличеству(КаталогЛогов, "*.json", МаксимальноеКоличествоФайлов);
КонецПроцедуры

// Phase 15 (аудит privacy): захваченные артефакты - скриншоты окон, картинки
// из буфера, резервные копии оригиналов перед заменой - копились БЕССРОЧНО (retention
// был только для logs/*.json). Самые чувствительные данные (снимки экрана,
// исходный код/текст пользователя) не должны накапливаться. Ограничиваем как
// логи, независимо от logging.enabled (артефакты - транспорт, не журнал).
Процедура ОчиститьЗахваченныйКонтент() Экспорт
	ОчиститьКаталогПоКоличеству(ОбъединитьПути(КаталогЛогов, "images"), "*.png", МаксимальноеКоличествоФайлов);
	ОчиститьКаталогПоКоличеству(ОбъединитьПути(КаталогЛогов, "backups"), "*.txt", МаксимальноеКоличествоФайлов);
	ОчиститьКаталогПоКоличеству(ОбъединитьПути(КаталогЛогов, "backups"), "*.zbsbackup", МаксимальноеКоличествоФайлов);
	Если КомпонентВременныхФайлов <> Неопределено Тогда
		Попытка
			КомпонентВременныхФайлов.ОчиститьВременныеФайлы(МаксимальноеКоличествоВременныхФайлов);
		Исключение
			// Недоступный каталог не должен останавливать запрос; следующая очистка повторит попытку.
			Возврат;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры
