<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="make-it-zbs-vendor" value="vendor/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="make-it-zbs-vendor"><package pattern="MakeItZBS.OneScript*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
