// Mock ИнформацияОбОкне - без реального UIA/Win32.
// Повторяет интерфейс WindowInfo, используемый в ЗапуститьОбработку:
//   ПолучитьВыделенныйТекст(), ПолучитьАктивноеОкно(),
//   ПолучитьТекстМодуля1С(), ПолучитьВесьМодуль1С() (Phase 3, OneCCode)

Перем ВыделенныйТекст;
Перем АктивноеОкно;
Перем ВыделениеМодуля1С;
Перем ВесьМодуль1С;
Перем ПоследняяВставка;
Перем ПоследняяОтправкаAIЧат;
Перем ПоследнийЧерновикAIЧат;
Перем ТекстAIЧата;
Перем ТекстAIЧатаУспех;
Перем ТекстAIЧатаДиагностика;
Перем РезультатВставкиУспех;
Перем РезультатВставкиДиаг;
Перем РазмерКартинки;
Перем ПоследнийКроп;
Перем РезультатКропа;
Перем ПривязкаЗамены; // Структура - захваченный источник для замены.
Перем ПривязкаДоступна; // Булево - можно ли подтвердить источник.
Перем ОшибкаЗахвата;
Перем ИсточникЗахвата; // Структура - параметры последнего захвата.
Перем БуферНеВосстановлен; // Булево - отдельный исход восстановления после успешной вставки.

Процедура ПриСозданииОбъекта()
	ВыделенныйТекст = "";
	АктивноеОкно = Неопределено;
	ВыделениеМодуля1С = "";
	ВесьМодуль1С = "";
	ПоследняяВставка = Неопределено;
	ПоследняяОтправкаAIЧат = Неопределено;
	ПоследнийЧерновикAIЧат = Неопределено;
	ТекстAIЧата = "";
	ТекстAIЧатаУспех = Истина;
	ТекстAIЧатаДиагностика = "";
	РезультатВставкиУспех = Истина;
	РезультатВставкиДиаг = "";
	РазмерКартинки = Новый Структура("Ширина,Высота", 300, 220);
	ПоследнийКроп = Неопределено;
	РезультатКропа = Истина;
	ПривязкаДоступна = Истина;
	ОшибкаЗахвата = "";
	БуферНеВосстановлен = Ложь;
КонецПроцедуры

Процедура УстановитьВыделенныйТекст(Знач Текст) Экспорт
	ВыделенныйТекст = Текст;
КонецПроцедуры

Функция ПолучитьВыделенныйТекст(Знач Дескриптор = 0, Знач ИдентификаторПроцесса = 0,
	Знач Заголовок = "") Экспорт
	ЗапомнитьИсточникЗахвата(Дескриптор, ИдентификаторПроцесса, Заголовок);
	Если НЕ ПустаяСтрока(ОшибкаЗахвата) Тогда
		ВызватьИсключение ОшибкаЗахвата;
	КонецЕсли;
	Возврат ВыделенныйТекст;
КонецФункции

Процедура УстановитьОшибкуЗахвата(Знач Текст) Экспорт
	ОшибкаЗахвата = Текст;
КонецПроцедуры

Процедура ЗапомнитьИсточникЗахвата(Знач Дескриптор, Знач ИдентификаторПроцесса, Знач Заголовок)
	ИсточникЗахвата = Новый Структура("handle,pid,title", Дескриптор, ИдентификаторПроцесса, Заголовок);
КонецПроцедуры

Функция ПолучитьИсточникЗахвата() Экспорт
	Возврат ИсточникЗахвата;
КонецФункции

Процедура УстановитьАктивноеОкно(Знач Окно) Экспорт
	АктивноеОкно = Окно;
КонецПроцедуры

Функция ПолучитьАктивноеОкно() Экспорт
	Возврат АктивноеОкно;
КонецФункции

// Контракт реального WindowInfo (шаг 3): диагностика захвата
Функция ПолучитьДиагностикуЗахвата() Экспорт
	Возврат "";
КонецФункции

// --- Phase 3: контракт OneCCode (редактор модуля Конфигуратора) ---
// Выделение = "" -> нет выделения (ветка «весь модуль»);
// ВесьТекст - что отдаст ПолучитьВесьМодуль1С() и длина для диалога.
Процедура УстановитьМодуль1С(Знач Выделение, Знач ВесьТекст) Экспорт
	ВыделениеМодуля1С = Выделение;
	ВесьМодуль1С = ВесьТекст;
КонецПроцедуры

Функция ПолучитьТекстМодуля1С(Знач Дескриптор = 0, Знач ИдентификаторПроцесса = 0,
	Знач Заголовок = "") Экспорт
	ЗапомнитьИсточникЗахвата(Дескриптор, ИдентификаторПроцесса, Заголовок);
	Инфо = Новый Структура();
	Инфо.Вставить("ЕстьВыделение", НЕ ПустаяСтрока(ВыделениеМодуля1С));
	Инфо.Вставить("Текст", ВыделениеМодуля1С);
	Инфо.Вставить("ДлинаМодуля", СтрДлина(ВесьМодуль1С));
	Инфо.Вставить("Диагностика", "");
	Возврат Инфо;
КонецФункции

Функция ПолучитьВесьМодуль1С(Знач Дескриптор = 0, Знач ИдентификаторПроцесса = 0,
	Знач Заголовок = "") Экспорт
	ЗапомнитьИсточникЗахвата(Дескриптор, ИдентификаторПроцесса, Заголовок);
	Возврат ВесьМодуль1С;
КонецФункции

// --- Phase 4: контракт replace-in-place ---
// Параметры:
//  Доступна - Булево - доступность проверки источника.
Процедура УстановитьДоступностьПривязки(Знач Доступна) Экспорт
	ПривязкаДоступна = Доступна;
КонецПроцедуры

Функция ЗакрепитьИсходникЗамены(Знач Хэндл, Знач ИДПроцесса, Знач Режим, Знач Оригинал) Экспорт
	ПривязкаЗамены = Новый Структура();
	ПривязкаЗамены.Вставить("handle", Хэндл);
	ПривязкаЗамены.Вставить("pid", ИДПроцесса);
	ПривязкаЗамены.Вставить("mode", Режим);
	ПривязкаЗамены.Вставить("original", Оригинал);
	Если НЕ ПривязкаДоступна Тогда
		Возврат "";
	КонецЕсли;
	Возврат "test-anchor";
КонецФункции

Процедура ОсвободитьПривязкуЗамены() Экспорт
	ПривязкаЗамены = Неопределено;
КонецПроцедуры

Функция ЗаменитьЗакрепленныйИсходник(Знач Токен, Знач Текст) Экспорт
	Если Токен <> "test-anchor" ИЛИ ПривязкаЗамены = Неопределено Тогда
		ВызватьИсключение "invalid replacement anchor";
	КонецЕсли;
	Результат = ВставитьТекстВОкно(ПривязкаЗамены.handle, Текст, ПривязкаЗамены.mode);
	ПоследняяВставка.Вставить("pid", ПривязкаЗамены.pid);
	Возврат Результат;
КонецФункции

Процедура УстановитьРезультатВставки(Знач Успех, Знач Диагностика = "",
	Знач ОшибкаВосстановленияБуфера = Ложь) Экспорт
	РезультатВставкиУспех = Успех;
	РезультатВставкиДиаг = Диагностика;
	БуферНеВосстановлен = ОшибкаВосстановленияБуфера;
КонецПроцедуры

Функция ВставитьТекстВОкно(Знач ХэндлОкна, Знач Текст, Знач Режим) Экспорт
	ПоследняяВставка = Новый Структура();
	ПоследняяВставка.Вставить("handle", ХэндлОкна);
	ПоследняяВставка.Вставить("текст", Текст);
	ПоследняяВставка.Вставить("режим", Режим);
	Рез = Новый Структура();
	Рез.Вставить("Успех", РезультатВставкиУспех);
	Рез.Вставить("БуферНеВосстановлен", БуферНеВосстановлен);
	Рез.Вставить("Диагностика", РезультатВставкиДиаг);
	Возврат Рез;
КонецФункции

// Неопределено = ВставитьТекстВОкно ни разу не вызывалась
Функция ПолучитьПоследнююВставку() Экспорт
	Возврат ПоследняяВставка;
КонецФункции

Функция ОтправитьСообщениеВAIЧат(Знач ХэндлОкна, Знач ИдентификаторПроцесса, Знач Текст) Экспорт
	ПоследняяОтправкаAIЧат = Новый Структура();
	ПоследняяОтправкаAIЧат.Вставить("handle", ХэндлОкна);
	ПоследняяОтправкаAIЧат.Вставить("pid", ИдентификаторПроцесса);
	ПоследняяОтправкаAIЧат.Вставить("текст", Текст);
	Рез = Новый Структура();
	Рез.Вставить("Успех", РезультатВставкиУспех);
	Рез.Вставить("Диагностика", РезультатВставкиДиаг);
	Возврат Рез;
КонецФункции

Функция ПолучитьПоследнююОтправкуAIЧат() Экспорт
	Возврат ПоследняяОтправкаAIЧат;
КонецФункции

Процедура УстановитьТекстAIЧата(
	Знач Текст, Знач Успех = Истина, Знач Диагностика = "") Экспорт
	ТекстAIЧата = Текст;
	ТекстAIЧатаУспех = Успех;
	ТекстAIЧатаДиагностика = Диагностика;
КонецПроцедуры

Функция ПолучитьТекстAIЧата(
	Знач ХэндлОкна, Знач ИдентификаторПроцесса, Знач МаксимумСимволов) Экспорт
	Рез = Новый Структура();
	Рез.Вставить("Успех", ТекстAIЧатаУспех);
	Рез.Вставить("Текст", ТекстAIЧата);
	Рез.Вставить("Диагностика", ТекстAIЧатаДиагностика);
	Рез.Вставить("СкрытоСекретов", 1);
	Возврат Рез;
КонецФункции

Функция ВставитьЧерновикВAIЧат(
	Знач ХэндлОкна, Знач ИдентификаторПроцесса, Знач Текст) Экспорт
	ПоследнийЧерновикAIЧат = Новый Структура(
		"handle,pid,текст", ХэндлОкна, ИдентификаторПроцесса, Текст);
	Рез = Новый Структура();
	Рез.Вставить("Успех", РезультатВставкиУспех);
	Рез.Вставить("Диагностика", РезультатВставкиДиаг);
	Возврат Рез;
КонецФункции

Функция ПолучитьПоследнийЧерновикAIЧат() Экспорт
	Возврат ПоследнийЧерновикAIЧат;
КонецФункции

Процедура СброситьВставку() Экспорт
	ПоследняяВставка = Неопределено;
	ПоследняяОтправкаAIЧат = Неопределено;
	ПоследнийЧерновикAIЧат = Неопределено;
	РезультатВставкиУспех = Истина;
	РезультатВставкиДиаг = "";
КонецПроцедуры

// --- Phase 6.1: размер/кроп PNG ---
Процедура УстановитьРазмерКартинки(Знач Ш, Знач В) Экспорт
	РазмерКартинки = Новый Структура("Ширина,Высота", Ш, В);
КонецПроцедуры

Процедура УстановитьРезультатКропа(Знач Успех) Экспорт
	РезультатКропа = Успех;
КонецПроцедуры

Функция РазмерPNG(Знач Путь) Экспорт
	Рез = Новый Структура();
	Рез.Вставить("Ширина", РазмерКартинки.Ширина);
	Рез.Вставить("Высота", РазмерКартинки.Высота);
	Рез.Вставить("Диагностика", "");
	Возврат Рез;
КонецФункции

Функция ОбрезатьPNG(Знач ИсхПуть, Знач X, Знач Y, Знач Ш, Знач В, Знач ЦельПуть) Экспорт
	ПоследнийКроп = Новый Структура();
	ПоследнийКроп.Вставить("исх", ИсхПуть);
	ПоследнийКроп.Вставить("x", X);
	ПоследнийКроп.Вставить("y", Y);
	ПоследнийКроп.Вставить("w", Ш);
	ПоследнийКроп.Вставить("h", В);
	ПоследнийКроп.Вставить("цель", ЦельПуть);
	Возврат РезультатКропа;
КонецФункции

Функция ПолучитьПоследнийКроп() Экспорт
	Возврат ПоследнийКроп;
КонецФункции

Процедура СброситьКроп() Экспорт
	ПоследнийКроп = Неопределено;
	РезультатКропа = Истина;
КонецПроцедуры
