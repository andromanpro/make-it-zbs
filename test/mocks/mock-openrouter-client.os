// ========================================================
// Mock OpenRouter API Client
// ========================================================
// Заглушка для тестирования без реальных HTTP запросов.
// Повторяет публичный интерфейс openrouter-client.os:
//   - Инициализировать()
//   - ОтправитьТекстовыйЗапрос()
//   - ОтправитьЗапросСИзображением()
//   - ИзвлечьТекстОтвета()
//   - ПолучитьИнфоОбИспользовании()
// ========================================================

Перем APIКлюч;
Перем ПодготовленныйОтвет;
Перем РежимОшибки;
Перем ТекстОшибки;
Перем ИсторияЗапросов;
Перем БBoxОбласть;
Перем СчетчикИниц;  // Phase 15: трекер вызовов Инициализировать (тест live-reload ключа)
Перем ОтменаПередОтветом; // Булево - имитация отмены сразу перед возвратом ответа.

// ========================================================
// Инициализация
// ========================================================

Процедура ПриСозданииОбъекта()

	APIКлюч = "";
	ПодготовленныйОтвет = Неопределено;
	РежимОшибки = Ложь;
	ТекстОшибки = "";
	ИсторияЗапросов = Новый Массив();
	БBoxОбласть = Неопределено;
	СчетчикИниц = 0;
	ОтменаПередОтветом = Ложь;

КонецПроцедуры

// ========================================================
// Настройка поведения мока
// ========================================================

// Задать ответ, который будет возвращаться на все запросы.
// ОтветJSON - строка JSON или Структура (уже распарсенная)
Процедура УстановитьОтвет(Знач ОтветJSON) Экспорт

	Если ТипЗнч(ОтветJSON) = Тип("Строка") Тогда
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(ОтветJSON);
		ПодготовленныйОтвет = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Иначе
		ПодготовленныйОтвет = ОтветJSON;
	КонецЕсли;

КонецПроцедуры

// Загрузить ответ из fixture файла
Процедура ЗагрузитьОтветИзФайла(Знач ПутьКФайлу) Экспорт

	ФайлОбъект = Новый Файл(ПутьКФайлу);
	Если НЕ ФайлОбъект.Существует() Тогда
		ВызватьИсключение "Fixture файл не найден: " + ПутьКФайлу;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекстJSON = Чтение.Прочитать();
	Чтение.Закрыть();

	УстановитьОтвет(ТекстJSON);

КонецПроцедуры

// Включить режим ошибки: все запросы будут вызывать исключение
Процедура УстановитьРежимОшибки(Знач ТекстОшибкиПараметр) Экспорт

	РежимОшибки = Истина;
	ТекстОшибки = ТекстОшибкиПараметр;

КонецПроцедуры

// Выключить режим ошибки
Процедура СброситьРежимОшибки() Экспорт

	РежимОшибки = Ложь;
	ТекстОшибки = "";

КонецПроцедуры

// Получить историю вызовов (для проверки что запросы были сделаны)
Функция ПолучитьИсториюЗапросов() Экспорт

	Возврат ИсторияЗапросов;

КонецФункции

// Очистить историю запросов
Процедура ОчиститьИсторию() Экспорт

	ИсторияЗапросов = Новый Массив();

КонецПроцедуры

// ========================================================
// Публичные методы (интерфейс openrouter-client.os)
// ========================================================

Процедура Инициализировать(Знач APIКлючПараметр, Знач AppNameПараметр = Неопределено, Знач SiteURLПараметр = Неопределено) Экспорт

	APIКлюч = APIКлючПараметр;
	СчетчикИниц = СчетчикИниц + 1;

КонецПроцедуры

// Phase 15: сколько раз вызывался Инициализировать (для теста, что
// ПерезагрузитьНастройки переинициализирует клиент новым ключом).
Функция ПолучитьСчетчикИниц() Экспорт
	Возврат СчетчикИниц;
КонецФункции

Функция ПолучитьТекущийКлюч() Экспорт
	Возврат APIКлюч;
КонецФункции

Процедура УстановитьОтменуПередОтветом(Знач Отменить) Экспорт
	ОтменаПередОтветом = Отменить;
КонецПроцедуры

Функция ОтправитьТекстовыйЗапрос(Знач Модель, Знач СистемнаяИнструкция, Знач ПользовательскаяИнструкция, Знач Параметры = Неопределено) Экспорт

	// Записать в историю
	ЗаписьИстории = Новый Структура();
	ЗаписьИстории.Вставить("тип", "текстовый");
	ЗаписьИстории.Вставить("модель", Модель);
	ЗаписьИстории.Вставить("системнаяИнструкция", СистемнаяИнструкция);
	ЗаписьИстории.Вставить("пользовательскаяИнструкция", ПользовательскаяИнструкция);
	ЗаписьИстории.Вставить("параметры", Параметры);
	ИсторияЗапросов.Добавить(ЗаписьИстории);

	// Проверить режим ошибки
	Если РежимОшибки Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	// Проверить что ответ подготовлен
	Если ПодготовленныйОтвет = Неопределено Тогда
		ВызватьИсключение "Mock: ответ не установлен. Вызовите УстановитьОтвет() или ЗагрузитьОтветИзФайла()";
	КонецЕсли;

	Если ОтменаПередОтветом Тогда
		Операция = Новый УправлениеОперацией();
		Операция.Отменить();
	КонецЕсли;
	Возврат ПодготовленныйОтвет;

КонецФункции

// Phase 5: интерфейс openrouter-client.ПодготовитьПотоковыйЗапрос.
// Возвращает фиктивные url/authHeader/bodyJson (реальный стрим в тестах
// эмулирует мок-ОбработчикСобытий.ПоказатьПревьюСтрим, сюда HTTP не идет).
Функция ПодготовитьПотоковыйЗапрос(Знач Модель, Знач СистемнаяИнструкция, Знач ПользовательскаяИнструкция, Знач Параметры = Неопределено) Экспорт

	ЗаписьИстории = Новый Структура();
	ЗаписьИстории.Вставить("тип", "стрим-подготовка");
	ЗаписьИстории.Вставить("модель", Модель);
	ЗаписьИстории.Вставить("пользовательскаяИнструкция", ПользовательскаяИнструкция);
	ИсторияЗапросов.Добавить(ЗаписьИстории);

	Результат = Новый Структура();
	Результат.Вставить("url", "https://mock.local/api/v1/chat/completions");
	Результат.Вставить("authHeader", "Bearer mock-key");
	Результат.Вставить("bodyJson", "{""model"":""" + Модель + """,""stream"":true}");
	Возврат Результат;

КонецФункции

// Phase 6: image->image. Возвращает валидный data-URL (по умолчанию
// 1x1 PNG - чтобы реальный ДекодироватьИзображениеDataURL/Base64Значение
// отработал и записал PNG). История для проверки что вызвано.
Функция ОтправитьЗапросНаУлучшениеИзображения(Знач Модель, Знач Инструкция, Знач ПутьКИзображению, Знач Параметры = Неопределено) Экспорт
	ЗаписьИстории = Новый Структура();
	ЗаписьИстории.Вставить("тип", "image-to-image");
	ЗаписьИстории.Вставить("модель", Модель);
	ЗаписьИстории.Вставить("путьКИзображению", ПутьКИзображению);
	ИсторияЗапросов.Добавить(ЗаписьИстории);
	Если РежимОшибки Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Б64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+P+/HgAFhAJ/wlseKgAAAABJRU5ErkJggg==";
	Возврат "data:image/png;base64," + Б64;
КонецФункции

// Phase 6.1: vision-bbox. Возвращает настраиваемый прямоугольник
// (по умолчанию правдоподобный). История - для проверки вызова.
Процедура УстановитьОбластьИзображения(Знач X, Знач Y, Знач Ш, Знач В) Экспорт
	БBoxОбласть = Новый Структура("x,y,w,h", X, Y, Ш, В);
КонецПроцедуры

Функция ОпределитьОбластьИзображения(Знач Модель, Знач ПутьКИзображению, Знач Ширина, Знач Высота) Экспорт
	ЗаписьИстории = Новый Структура();
	ЗаписьИстории.Вставить("тип", "vision-bbox");
	ЗаписьИстории.Вставить("модель", Модель);
	ИсторияЗапросов.Добавить(ЗаписьИстории);
	Если РежимОшибки Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Если БBoxОбласть = Неопределено Тогда
		Возврат Новый Структура("x,y,w,h", 10, 40, 200, 150);
	КонецЕсли;
	Возврат БBoxОбласть;
КонецФункции

Функция ОтправитьЗапросСИзображением(Знач Модель, Знач Текст, Знач ПутьКИзображению,
	Знач Параметры = Неопределено, Знач СистемнаяИнструкция = "") Экспорт

	// Записать в историю
	ЗаписьИстории = Новый Структура();
	ЗаписьИстории.Вставить("тип", "vision");
	ЗаписьИстории.Вставить("модель", Модель);
	ЗаписьИстории.Вставить("текст", Текст);
	ЗаписьИстории.Вставить("путьКИзображению", ПутьКИзображению);
	ЗаписьИстории.Вставить("параметры", Параметры);
	ЗаписьИстории.Вставить("системнаяИнструкция", СистемнаяИнструкция);
	ИсторияЗапросов.Добавить(ЗаписьИстории);

	// Проверить режим ошибки
	Если РежимОшибки Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	// Проверить что ответ подготовлен
	Если ПодготовленныйОтвет = Неопределено Тогда
		ВызватьИсключение "Mock: ответ не установлен. Вызовите УстановитьОтвет() или ЗагрузитьОтветИзФайла()";
	КонецЕсли;

	Возврат ПодготовленныйОтвет;

КонецФункции

// Извлечь текст из результата API (идентично openrouter-client.os)
Функция ИзвлечьТекстОтвета(Знач РезультатAPI) Экспорт

	Попытка

		Если РезультатAPI.Свойство("choices") И РезультатAPI.choices.Количество() > 0 Тогда
			ПервыйВыбор = РезультатAPI.choices[0];

			Если ПервыйВыбор.Свойство("message") И ПервыйВыбор.message.Свойство("content") Тогда
				Возврат СокрЛП(ПервыйВыбор.message.content);
			КонецЕсли;
		КонецЕсли;

		ВызватьИсключение "Не удалось извлечь текст из ответа API";

	Исключение
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Получить информацию об использовании токенов (идентично openrouter-client.os)
Функция ПолучитьИнфоОбИспользовании(Знач РезультатAPI) Экспорт

	Инфо = Новый Структура();
	Инфо.Вставить("prompt_tokens", 0);
	Инфо.Вставить("completion_tokens", 0);
	Инфо.Вставить("total_tokens", 0);

	Если РезультатAPI.Свойство("usage") Тогда

		Если РезультатAPI.usage.Свойство("prompt_tokens") Тогда
			Инфо.prompt_tokens = РезультатAPI.usage.prompt_tokens;
		КонецЕсли;

		Если РезультатAPI.usage.Свойство("completion_tokens") Тогда
			Инфо.completion_tokens = РезультатAPI.usage.completion_tokens;
		КонецЕсли;

		Если РезультатAPI.usage.Свойство("total_tokens") Тогда
			Инфо.total_tokens = РезультатAPI.usage.total_tokens;
		КонецЕсли;

	КонецЕсли;

	Возврат Инфо;

КонецФункции
