Перем История;
Перем Ответ;
Перем Ошибка;
Перем ПутьИзображения;
Перем ОшибкаИзображения;

Процедура ПриСозданииОбъекта()
	История = Новый Массив();
	Ответ = "Ответ локального Codex";
	Ошибка = "";
	ПутьИзображения = "codex-generated.png";
	ОшибкаИзображения = "";
КонецПроцедуры

Процедура УстановитьОтвет(Знач Значение) Экспорт
	Ответ = Значение;
	Ошибка = "";
КонецПроцедуры

Процедура УстановитьОшибку(Знач Значение) Экспорт
	Ошибка = Значение;
КонецПроцедуры

Процедура УстановитьОтветИзображения(Знач Значение) Экспорт
	ПутьИзображения = Значение;
	ОшибкаИзображения = "";
КонецПроцедуры

Процедура УстановитьОшибкуИзображения(Знач Значение) Экспорт
	ОшибкаИзображения = Значение;
КонецПроцедуры

Процедура ОчиститьИсторию() Экспорт
	История = Новый Массив();
КонецПроцедуры

Функция ПолучитьИсторию() Экспорт
	Возврат История;
КонецФункции

Функция Запустить(
	Знач СистемнаяИнструкция, Знач ПользовательскаяИнструкция,
	Знач Модель = "", Знач ТаймаутСек = 180,
	Знач ПутьИзображения = "", Знач УровеньReasoning = "") Экспорт

	Запись = Новый Структура();
	Запись.Вставить("тип", "text");
	Запись.Вставить("системнаяИнструкция", СистемнаяИнструкция);
	Запись.Вставить("пользовательскаяИнструкция", ПользовательскаяИнструкция);
	Запись.Вставить("модель", Модель);
	Запись.Вставить("таймаут", ТаймаутСек);
	Запись.Вставить("изображение", ПутьИзображения);
	Запись.Вставить("reasoning", УровеньReasoning);
	История.Добавить(Запись);

	Результат = Новый Структура();
	Результат.Вставить("Успех", ПустаяСтрока(Ошибка));
	Результат.Вставить("Контент", ?(ПустаяСтрока(Ошибка), Ответ, ""));
	Результат.Вставить("Диагностика", Ошибка);
	Возврат Результат;

КонецФункции

Функция СгенерироватьИзображение(
	Знач СистемнаяИнструкция, Знач ПользовательскаяИнструкция,
	Знач ВходноеИзображение, Знач ВыходноеИзображение,
	Знач Модель = "", Знач ТаймаутСек = 600,
	Знач УровеньReasoning = "") Экспорт

	Запись = Новый Структура();
	Запись.Вставить("тип", "imagegen");
	Запись.Вставить("системнаяИнструкция", СистемнаяИнструкция);
	Запись.Вставить("пользовательскаяИнструкция", ПользовательскаяИнструкция);
	Запись.Вставить("изображение", ВходноеИзображение);
	Запись.Вставить("назначение", ВыходноеИзображение);
	Запись.Вставить("модель", Модель);
	Запись.Вставить("таймаут", ТаймаутСек);
	Запись.Вставить("reasoning", УровеньReasoning);
	История.Добавить(Запись);

	Результат = Новый Структура();
	Результат.Вставить("Успех", ПустаяСтрока(ОшибкаИзображения));
	Результат.Вставить("Путь", ?(ПустаяСтрока(ОшибкаИзображения),
		ПутьИзображения, ""));
	Результат.Вставить("Диагностика", ОшибкаИзображения);
	Возврат Результат;

КонецФункции
