// Mock ОбработчикГорячихКлавиш - для тестов ветки replace-in-place
// (Phase 4). Без реального WinForms/hotkey. Повторяет интерфейс,
// используемый ЗапуститьОбработку: ПоказатьПревью, ОчиститьОчередь,
// ПодтвердитьЗаменуВсегоМодуля, индикация (noop).

Перем ИсходПревью;
Перем РезультатПодтверждения;
Перем ПоследнийAllowApply;
Перем БылПоказПревью;
Перем БылоПодтверждение;
Перем СтримИсход;
Перем СтримКонтент;
Перем СтримОшибка;
Перем БылПоказСтрима;
Перем ИсходИзображения;
Перем ПутьПоказаннойКартинки;
Перем КоличествоПревью; // Число - количество открытий окна результата.
Перем ПоследнееПримечание; // Строка - причина повторного показа без Apply.
Перем ПоследнееПревью; // Структура - данные последнего окна результата.
Перем СообщенияСтатуса;
Перем ОшибкаПревью; // Строка - заданная ошибка основного окна результата.
Перем РезервныйРезультат; // Структура - ответ, переданный в независимое окно.
Перем ОшибкаПослеПоказа; // Число - количество успешных показов до отказа.
Перем ОшибкаРезерва; // Строка - заданный отказ нативного окна результата.

Процедура ПриСозданииОбъекта()
	ИсходПревью = "cancelled";
	РезультатПодтверждения = Истина;
	ПоследнийAllowApply = Неопределено;
	БылПоказПревью = Ложь;
	КоличествоПревью = 0;
	ПоследнееПримечание = "";
	БылоПодтверждение = Ложь;
	СтримИсход = "cancelled";
	СтримКонтент = "";
	// Потоковые тесты должны явно задать результат или ожидаемую ошибку.
	СтримОшибка = "mock: стрим отключен по умолчанию";
	БылПоказСтрима = Ложь;
	ИсходИзображения = Неопределено;
	ПутьПоказаннойКартинки = "";
	СообщенияСтатуса = Новый Массив();
	ОшибкаПревью = "";
	ОшибкаПослеПоказа = 0;
	ОшибкаРезерва = "";
КонецПроцедуры

Процедура УстановитьОшибкуПревью(Знач Текст, Знач ПослеПоказа = 0) Экспорт
	ОшибкаПревью = Текст;
	ОшибкаПослеПоказа = ПослеПоказа;
КонецПроцедуры

Процедура ПоказатьРезервныйРезультат(Знач ТекстОтвета, Знач Примечание) Экспорт
	РезервныйРезультат = Новый Структура("Текст,Примечание", ТекстОтвета, Примечание);
	Если НЕ ПустаяСтрока(ОшибкаРезерва) Тогда
		ВызватьИсключение ОшибкаРезерва;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьОшибкуРезерва(Знач Текст) Экспорт
	ОшибкаРезерва = Текст;
КонецПроцедуры

Функция ПолучитьРезервныйРезультат() Экспорт
	Возврат РезервныйРезультат;
КонецФункции

Процедура УстановитьИсход(Знач Значение) Экспорт
	ИсходПревью = Значение;
КонецПроцедуры

Процедура УстановитьРезультатПодтверждения(Знач Значение) Экспорт
	РезультатПодтверждения = Значение;
КонецПроцедуры

// Сигнатура как у HotkeyPoller.ShowPreview Phase 4 (+allowApply 6-м)
Функция ПоказатьПревью(Знач Оригинал, Знач Результат, Знач Контекст,
		Знач Модель, Знач Таймаут, Знач РазрешитьПрименить, Знач Примечание = "") Экспорт
	БылПоказПревью = Истина;
	КоличествоПревью = КоличествоПревью + 1;
	Если НЕ ПустаяСтрока(ОшибкаПревью) И КоличествоПревью > ОшибкаПослеПоказа Тогда
		ВызватьИсключение ОшибкаПревью;
	КонецЕсли;
	ПоследнееПримечание = Примечание;
	ПоследнееПревью = Новый Структура();
	ПоследнееПревью.Вставить("Модель", Модель);
	ПоследнееПревью.Вставить("Таймаут", Таймаут);
	ПоследнееПревью.Вставить("Оригинал", Оригинал);
	ПоследнееПревью.Вставить("Результат", Результат);
	ПоследнееПревью.Вставить("Контекст", Контекст);
	ПоследнийAllowApply = РазрешитьПрименить;
	Возврат ИсходПревью;
КонецФункции

Функция ПолучитьКоличествоПревью() Экспорт
	Возврат КоличествоПревью;
КонецФункции

Функция ПолучитьПримечание() Экспорт
	Возврат ПоследнееПримечание;
КонецФункции

Функция ПолучитьПоследнееПревью() Экспорт
	Возврат ПоследнееПревью;
КонецФункции

Функция ПодтвердитьЗаменуВсегоМодуля(Знач ДлинаМодуля, Знач ПутьБэкапа) Экспорт
	БылоПодтверждение = Истина;
	Возврат РезультатПодтверждения;
КонецФункции

// Phase 15: был ли использован стрим-путь (тест тумблера preview.stream).
Функция ПолучитьБылПоказСтрима() Экспорт
	Возврат БылПоказСтрима;
КонецФункции

// Phase 3 capture-confirm (нет выделения в Конфигураторе). В apply-тестах
// захват детерминируем через general.confirmFullModule=Ложь, но метод
// нужен на случай вызова - возвращаем Истина (захват продолжается).
Функция ПодтвердитьВесьМодуль(Знач ДлинаМодуля) Экспорт
	Возврат Истина;
КонецФункции

// Phase 5: настроить успешный стрим (ОшибкаСтрима="" -> стрим-путь).
Процедура УстановитьСтримУспех(Знач Контент, Знач Исход = "cancelled") Экспорт
	СтримКонтент = Контент;
	СтримИсход = Исход;
	СтримОшибка = "";
КонецПроцедуры

Процедура УстановитьСтримОшибку(Знач Текст) Экспорт
	СтримОшибка = Текст;
КонецПроцедуры

// Сигнатура как HotkeyPoller.ShowPreviewStreaming (Phase 5)
Функция ПоказатьПревьюСтрим(Знач Запрос, Знач Оригинал, Знач Контекст, Знач Модель,
		Знач Таймаут, Знач РазрешитьПрименить) Экспорт
	БылПоказСтрима = Истина;
	ПоследнийAllowApply = РазрешитьПрименить;
	Рез = Новый Структура();
	Рез.Вставить("Исход", СтримИсход);
	Рез.Вставить("Контент", СтримКонтент);
	Рез.Вставить("ОшибкаСтрима", СтримОшибка);
	Возврат Рез;
КонецФункции

// Phase 6: показ результат-картинки. Настраиваемый исход; путь пишем.
Процедура УстановитьИсходИзображения(Знач Значение) Экспорт
	ИсходИзображения = Значение;
КонецПроцедуры

Функция ПоказатьИзображение(Знач ПутьКартинки, Знач Контекст, Знач Модель, Знач Таймаут) Экспорт
	ПутьПоказаннойКартинки = ПутьКартинки;
	Если ИсходИзображения = Неопределено Тогда
		Возврат "cancelled";
	КонецЕсли;
	Возврат ИсходИзображения;
КонецФункции

Функция ПолучитьПутьПоказаннойКартинки() Экспорт
	Возврат ПутьПоказаннойКартинки;
КонецФункции

Процедура ОчиститьОчередь() Экспорт
КонецПроцедуры

// Индикация - noop (в ЗапуститьОбработку вызовы обернуты Попыткой,
// но реализуем явно, чтобы не маскировать исключениями).
Процедура ПоказатьИндикациюЗанят(Знач Сообщение) Экспорт
	СообщенияСтатуса.Добавить(Сообщение);
КонецПроцедуры

Функция ПолучитьСообщенияСтатуса() Экспорт
	Возврат СообщенияСтатуса;
КонецФункции

Процедура СброситьИндикацию(Знач Сообщение) Экспорт
	СообщенияСтатуса.Добавить(Сообщение);
КонецПроцедуры

Процедура СкрытьИндикацию() Экспорт
КонецПроцедуры

Функция ДиагностикаЭлевации() Экспорт
	Возврат "";
КонецФункции

// --- геттеры для assertions ---
Функция ПолучитьПоследнийAllowApply() Экспорт
	Возврат ПоследнийAllowApply;
КонецФункции

Функция БылоПодтверждениеЗамены() Экспорт
	Возврат БылоПодтверждение;
КонецФункции

Функция БылПоказаСтрима() Экспорт
	Возврат БылПоказСтрима;
КонецФункции

Функция БылПоказаПревью() Экспорт
	Возврат БылПоказПревью;
КонецФункции
