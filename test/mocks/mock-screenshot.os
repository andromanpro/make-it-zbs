// Mock СнимокЭкрана - не делает реальный скриншот.
Перем ПутьСнимка;
Перем КоличествоСнимков;
Перем ПоследнийИсточник; // Структура - HWND, PID и заголовок исходника.

Процедура ПриСозданииОбъекта()
	ПутьСнимка = "mock-screenshot.png";
	КоличествоСнимков = 0;
КонецПроцедуры

Процедура УстановитьПутьСнимка(Знач Путь) Экспорт
	ПутьСнимка = Путь;
КонецПроцедуры

Функция СделатьСнимок(Знач ПутьНазначения, Знач Дескриптор = 0,
	Знач ИдентификаторПроцесса = 0, Знач Заголовок = "") Экспорт
	ПоследнийИсточник = Новый Структура("handle,pid", Дескриптор, ИдентификаторПроцесса);
	ПоследнийИсточник.Вставить("title", Заголовок);
	ПоследнийИсточник.Вставить("outputPath", ПутьНазначения);
	КоличествоСнимков = КоличествоСнимков + 1;
	Возврат ПутьСнимка;
КонецФункции

Функция ПолучитьКоличествоСнимков() Экспорт
	Возврат КоличествоСнимков;
КонецФункции

Функция ПолучитьПоследнийИсточник() Экспорт
	Возврат ПоследнийИсточник;
КонецФункции

Процедура Сбросить() Экспорт
	КоличествоСнимков = 0;
КонецПроцедуры
