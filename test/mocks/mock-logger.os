// Mock Logger - no-op, не пишет файлы логов в smoke-тестах.
// Интерфейс из ЗапуститьОбработку/ОбработчикHotkey.

Перем События; // Массив - технические события пайплайна.

Процедура ПриСозданииОбъекта()
	События = Новый Массив();
КонецПроцедуры

Процедура Инициализировать(Знач Каталог, Знач Настройки = Неопределено,
	Знач ВременныеФайлы = Неопределено) Экспорт
КонецПроцедуры

Процедура ЗаписатьСобытие(Знач Контекст, Знач Этап, Знач Размер = 0,
	Знач ИзображениеВБуфере = Ложь) Экспорт
	События.Добавить(Новый Структура("context,stage,characters", Контекст, Этап, Размер));
	События[События.Количество() - 1].Вставить("clipboardImage", ИзображениеВБуфере);
КонецПроцедуры

Функция ПолучитьСобытия() Экспорт
	Возврат События;
КонецФункции

Процедура ЗаписатьЗапрос(Знач Контекст, Знач Модель, Знач Промпт) Экспорт
КонецПроцедуры

Процедура ЗаписатьОтвет(Знач Контекст, Знач Модель, Знач Текст,
	Знач ИнфоОбИспользовании) Экспорт
КонецПроцедуры

Процедура ЗаписатьОшибку(Знач Контекст, Знач Текст) Экспорт
КонецПроцедуры
