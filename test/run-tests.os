// ========================================================
// Make it ZBS - Тестовый раннер
// ========================================================
// Запускает все юнит-тесты по очереди,
// собирает результаты Pass/Fail.
// ========================================================

Перем ВсегоНаборов;
Перем ПройденоНаборов;
Перем ПроваленоНаборов;
Перем КаталогТестов;

// ========================================================
// Запуск одного тестового файла
// ========================================================

Процедура ЗапуститьТест(Знач ИмяФайла, Знач Подпапка = "unit")

	ВсегоНаборов = ВсегоНаборов + 1;

	ПолныйПуть = ОбъединитьПути(КаталогТестов, Подпапка);
	ПолныйПуть = ОбъединитьПути(ПолныйПуть, ИмяФайла);

	ФайлОбъект = Новый Файл(ПолныйПуть);
	Если НЕ ФайлОбъект.Существует() Тогда
		Сообщить("[SKIP] " + ИмяФайла + " - файл не найден");
		ПроваленоНаборов = ПроваленоНаборов + 1;
		Возврат;
	КонецЕсли;

	Сообщить("");
	Сообщить(">>> Запуск: " + ИмяФайла);
	Сообщить("");

	Попытка

		// Дочерние тесты используют тот же рантайм, а не случайный oscript из PATH.
		Исполнитель = ОбъединитьПути(КаталогПрограммы(), "oscript.exe");
		КомандаЗапуска = """" + Исполнитель + """ -encoding=utf-8 """ + ПолныйПуть + """";
		Процесс = СоздатьПроцесс(КомандаЗапуска, КаталогТестов, Истина, Ложь, КодировкаТекста.UTF8);
		Процесс.Запустить();
		Процесс.ОжидатьЗавершения();

		КодВозврата = Процесс.КодВозврата;

		// Вывести stdout
		ВыводТеста = Процесс.ПотокВывода.Прочитать();
		Если НЕ ПустаяСтрока(ВыводТеста) Тогда
			Сообщить(ВыводТеста);
		КонецЕсли;

		// Вывести stderr
		ВыводОшибок = Процесс.ПотокОшибок.Прочитать();
		Если НЕ ПустаяСтрока(ВыводОшибок) Тогда
			Сообщить(ВыводОшибок);
		КонецЕсли;

		Если КодВозврата = 0 Тогда
			ПройденоНаборов = ПройденоНаборов + 1;
			Сообщить("");
			Сообщить("<<< [PASS] " + ИмяФайла);
		Иначе
			ПроваленоНаборов = ПроваленоНаборов + 1;
			Сообщить("");
			Сообщить("<<< [FAIL] " + ИмяФайла + " (код возврата: " + КодВозврата + ")");
		КонецЕсли;

	Исключение

		ПроваленоНаборов = ПроваленоНаборов + 1;
		Сообщить("");
		Сообщить("<<< [FAIL] " + ИмяФайла + " (исключение: " + ОписаниеОшибки() + ")");

	КонецПопытки;

КонецПроцедуры

// ========================================================
// Главная процедура
// ========================================================

ВсегоНаборов = 0;
ПройденоНаборов = 0;
ПроваленоНаборов = 0;

КаталогТестов = ТекущийСценарий().Каталог;

Сообщить("########################################");
Сообщить("# Make it ZBS - Тестовый раннер        #");
Сообщить("########################################");
Сообщить("");
Сообщить("Каталог тестов: " + КаталогТестов);

// Юнит-тесты
ЗапуститьТест("test-context-detector.os");
ЗапуститьТест("test-openrouter-parser.os");
ЗапуститьТест("test-logger.os");

// Smoke-тесты (пайплайн ЗапуститьОбработку + guard)
ЗапуститьТест("test-pipeline-smoke.os", "smoke");

// Итого
Сообщить("");
Сообщить("########################################");
Сообщить("# ИТОГИ                               #");
Сообщить("########################################");
Сообщить("");
Сообщить("Тестовых наборов: " + ВсегоНаборов);
Сообщить("Пройдено:         " + ПройденоНаборов);
Сообщить("Провалено:        " + ПроваленоНаборов);
Сообщить("");

Если ПроваленоНаборов > 0 Тогда
	Сообщить("РЕЗУЛЬТАТ: FAIL");
	Сообщить("");
	Сообщить("########################################");
	ЗавершитьРаботу(1);
Иначе
	Сообщить("РЕЗУЛЬТАТ: PASS");
	Сообщить("");
	Сообщить("########################################");
КонецЕсли;
