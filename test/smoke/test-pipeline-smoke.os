// ========================================================
// Smoke-тест пайплайна: ЗапуститьОбработку (seam из шага 1)
// ========================================================
// Регрессионная сеть ДО фикса P0: проверяет что
// контекст -> данные -> модель -> инструкция -> ответ
// собирается корректно, без F13/UIA/реального OpenRouter.
// Также проверяет guard: ЗагрузитьСценарий(zbs-main-polling.os)
// НЕ запускает бесконечный ГлавныйЦикл.
// ========================================================

Перем ВсегоТестов;
Перем Пройдено;
Перем Провалено;
Перем Приложение;
Перем МокOpenRouter;
Перем МокCodex;
Перем МокWinInfo;
Перем МокСкриншот;
Перем МокХранилищеКопий; // Сценарий - запись DPAPI-копий с управляемым отказом.

Процедура Утверждение(Знач Условие, Знач ОписаниеТеста)
	ВсегоТестов = ВсегоТестов + 1;
	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
	КонецЕсли;
КонецПроцедуры

Процедура УтверждениеРавно(Знач Ожидаемое, Знач Фактическое, Знач ОписаниеТеста)
	ВсегоТестов = ВсегоТестов + 1;
	Если Ожидаемое = Фактическое Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
		Сообщить("         Ожидалось: " + Ожидаемое);
		Сообщить("         Получено:  " + Фактическое);
	КонецЕсли;
КонецПроцедуры

Функция ПутьОт(Знач БазовыйКаталог, Знач Сегменты)
	Результат = БазовыйКаталог;
	Для Каждого Сегмент Из Сегменты Цикл
		Результат = ОбъединитьПути(Результат, Сегмент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Путь(Знач Сегмент1, Знач Сегмент2 = "", Знач Сегмент3 = "", Знач Сегмент4 = "", Знач Сегмент5 = "")
	Сегменты = Новый Массив();
	Сегменты.Добавить(Сегмент1);
	Если НЕ ПустаяСтрока(Сегмент2) Тогда Сегменты.Добавить(Сегмент2); КонецЕсли;
	Если НЕ ПустаяСтрока(Сегмент3) Тогда Сегменты.Добавить(Сегмент3); КонецЕсли;
	Если НЕ ПустаяСтрока(Сегмент4) Тогда Сегменты.Добавить(Сегмент4); КонецЕсли;
	Если НЕ ПустаяСтрока(Сегмент5) Тогда Сегменты.Добавить(Сегмент5); КонецЕсли;
	Возврат ПутьОт(ТекущийСценарий().Каталог, Сегменты);
КонецФункции

// Штатный JSON с явным чтением объектов в Соответствие, как в приложении.
Функция ЗагрузитьJSON(Знач ПутьКФайлу)
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекстJSON = Чтение.Прочитать();
	Чтение.Закрыть();

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

Функция СоздатьОкно(Знач ИмяПроцесса, Знач Заголовок)
	Окно = Новый Структура();
	Окно.Вставить("exe", ИмяПроцесса);
	Окно.Вставить("title", Заголовок);
	Окно.Вставить("class", "");
	Окно.Вставить("handle", 99001);
	Окно.Вставить("pid", 77001);
	Возврат Окно;
КонецФункции

// Settings-Соответствие с включенным replace (Phase 4). Захват в
// apply-тестах детерминируем: general.confirmFullModule=Ложь (Phase 3
// capture-диалог не вмешивается - тестируем именно replace).
Функция НастройкиСReplace(Знач Включить, Знач Контексты = Неопределено, Знач Стрим = Ложь)
	Н = ЗагрузитьJSON(Путь("..", "..", "config", "settings.json"));
	Разд = Новый Соответствие();
	Разд.Вставить("enabled", Включить);
	Если Контексты <> Неопределено Тогда
		Разд.Вставить("contexts", Контексты);
	КонецЕсли;
	Н.Вставить("replace", Разд);
	Н["preview"].Вставить("stream", Стрим);
	Общие = Н.Получить("general");
	Если Общие = Неопределено Тогда
		Общие = Новый Соответствие();
		Н.Вставить("general", Общие);
	КонецЕсли;
	Общие.Вставить("confirmFullModule", Ложь);
	Возврат Н;
КонецФункции

Функция НастройкиAIChat(Знач Режим, Знач ТекстПродолжения = "Давай дальше.")
	Н = ЗагрузитьJSON(Путь("..", "..", "config", "settings.json"));
	Раздел = Новый Соответствие();
	Раздел.Вставить("mode", Режим);
	Раздел.Вставить("continueText", ТекстПродолжения);
	Н.Вставить("aiChat", Раздел);
	Возврат Н;
КонецФункции

Функция НастройкиПрофиляAIChat(
	Знач ИмяПрофиля, Знач Режим, Знач Источник, Знач РежимОтправки)
	Н = ЗагрузитьJSON(Путь("..", "..", "config", "settings.json"));
	Профиль = Н["aiChat"]["profiles"][ИмяПрофиля];
	Профиль.Вставить("mode", Режим);
	Профиль.Вставить("analysisSource", Источник);
	Профиль.Вставить("sendMode", РежимОтправки);
	Н["preview"].Вставить("stream", Ложь);
	Возврат Н;
КонецФункции

Функция СвежийМокОбработчикСобытий()
	Возврат ЗагрузитьСценарий(Путь("..", "mocks", "mock-poller.os"));
КонецФункции

// ========================================================
// Подготовка: загрузка модуля + инъекция зависимостей
// ========================================================

Процедура Подготовить()
	ПодключитьВнешнююКомпоненту(Путь("..", "..", "lib", "net472", "ZBSWindowsComponent.dll"));

	// Если guard не сработает - ЗагрузитьСценарий зависнет в ГлавныйЦикл
	// и до Утверждения ниже исполнение не дойдет.
	Приложение = ЗагрузитьСценарий(Путь("..", "..", "src", "onescript", "zbs-main-polling.os"));
	Утверждение(Истина, "guard: zbs-main-polling.os загружен без запуска ГлавныйЦикл");

	КаталогМодулей = Путь("..", "..", "src", "onescript", "modules");
	Детектор = ЗагрузитьСценарий(ОбъединитьПути(КаталогМодулей, "context-detector.os"));

	КаталогКонфига = Путь("..", "..", "config");
	НастройкиОбщие    = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "settings.json"));
	НастройкиМоделей  = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "models.json"));
	НастройкиИнструкций = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "prompts.json"));

	КаталогМоков = Путь("..", "mocks");
	МокOpenRouter = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-openrouter-client.os"));
	МокCodex      = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-codex-client.os"));
	МокWinInfo    = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-wininfo.os"));
	МокБуфер      = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-clipboard.os"));
	МокСкриншот   = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-screenshot.os"));
	МокЛоггер     = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-logger.os"));
	МокЛог        = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "noop-log.os"));
	МокХранилищеКопий = ЗагрузитьСценарий(ОбъединитьПути(КаталогМоков, "mock-backup-store.os"));

	МокOpenRouter.ЗагрузитьОтветИзФайла(Путь("..", "fixtures", "api-response-success.json"));

	Зав = Новый Структура();
	Зав.Вставить("Лог", МокЛог);
	Зав.Вставить("НастройкиОбщие", НастройкиОбщие);
	Зав.Вставить("НастройкиМоделей", НастройкиМоделей);
	Зав.Вставить("НастройкиИнструкций", НастройкиИнструкций);
	Зав.Вставить("Screenshot", МокСкриншот);
	Зав.Вставить("WinInfo", МокWinInfo);
	Зав.Вставить("Clipboard", МокБуфер);
	Зав.Вставить("ХранилищеКопий", МокХранилищеКопий);
	Зав.Вставить("OpenRouterКлиент", МокOpenRouter);
	Зав.Вставить("CodexКлиент", МокCodex);
	Зав.Вставить("ContextDetector", Детектор);
	Зав.Вставить("Logger", МокЛоггер);
	Зав.Вставить("APIКлюч", "test-key");
	Зав.Вставить("МокAI", Истина);

	Приложение.УстановитьТестовыеЗависимости(Зав);
КонецПроцедуры

// ========================================================
// Тест 1: контекст Code
// ========================================================

Процедура ТестТекстовогоПроцессораСоСтарымИзображением()

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("Тестовый выделенный абзац Word");
	Обработчик = СвежийМокОбработчикСобытий();
	Зависимости = Новый Структура();
	Зависимости.Вставить("ОбработчикСобытий", Обработчик);
	Зависимости.Вставить("НастройкиОбщие", НастройкиСReplace(Ложь));
	Приложение.УстановитьТестовыеЗависимости(Зависимости);
	КаталогМодулей = Путь("..", "..", "src", "onescript", "modules");
	ПутьДетектора = ОбъединитьПути(КаталогМодулей, "context-detector.os");
	Детектор = ЗагрузитьСценарий(ПутьДетектора);
	Окно = СоздатьОкно("winword.exe", "Тест - Word");
	Буфер = Новый Структура("имеетИзображение", Истина);
	Контекст = Детектор.ОпределитьКонтекст(Окно, Буфер);
	УтверждениеРавно("Word", Контекст, "Старый скриншот не подменяет контекст Word");
	Результат = Приложение.ЗапуститьОбработку(Окно, Контекст);
	УтверждениеРавно("text", Результат.захват.kind, "Word захватывает текст, не картинку");
	Источник = МокWinInfo.ПолучитьИсточникЗахвата();
	УтверждениеРавно(Окно.title, Источник.title, "Захват Word привязан к заголовку исходного документа");
	Утверждение(Найти(Результат.инструкция, "Тестовый выделенный абзац Word") > 0,
		"Модель получает выделение Word");
	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "Один запрос, без image-to-image и повтора");
	УтверждениеРавно("текстовый", История[0].тип, "Word не вызывает генерацию PNG");
	Сообщения = Обработчик.ПолучитьСообщенияСтатуса();
	Утверждение(Сообщения.Количество() > 0 И Найти(Сообщения[0], "Word") > 0,
		"Ранний статус показывает контекст Word");

КонецПроцедуры

Процедура ТестСменаОкнаОтменяетДоAPI()
	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьОшибкуЗахвата("Исходное окно изменилось во время захвата");
	БылаОшибка = Ложь;
	Попытка
		Приложение.ЗапуститьОбработку(СоздатьОкно("winword.exe", "Тест - Word"), "Word");
	Исключение
		БылаОшибка = Истина;
	КонецПопытки;
	МокWinInfo.УстановитьОшибкуЗахвата("");
	Утверждение(БылаОшибка, "Смена источника прекращает обработку");
	УтверждениеРавно(0, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(),
		"Данные другого окна не отправляются, платного запроса нет");
КонецПроцедуры

Процедура ТестХолстаСоСтарымБуфером()
	МокOpenRouter.ОчиститьИсторию();
	Буфер = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	Буфер.УстановитьИзображение("stale-settings.png");
	МокСкриншот.Сбросить();
	МокСкриншот.УстановитьПутьСнимка("current-paint.png");
	Зависимости = Новый Структура("Clipboard", Буфер);
	Приложение.УстановитьТестовыеЗависимости(Зависимости);
	Окно = СоздатьОкно("mspaint.exe", "Рисунок - Paint");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Image");
	УтверждениеРавно("windowShot", Результат.захват.scope, "Paint использует свой рисунок, не старый clipboard");
	УтверждениеРавно("current-paint.png", Результат.захват.original, "Исходник взят из Paint");
	УтверждениеРавно(1, МокСкриншот.ПолучитьКоличествоСнимков(), "Один захват нужного окна");
	Источник = МокСкриншот.ПолучитьПоследнийИсточник();
	УтверждениеРавно(Окно.handle, Источник.handle, "Снимок привязан к исходному HWND");
	УтверждениеРавно(Окно.pid, Источник.pid, "Снимок привязан к исходному PID");
	ПутьБуфера = Путь("..", "mocks", "mock-clipboard.os");
	ПустойБуфер = ЗагрузитьСценарий(ПутьБуфера);
	ЗависимостиБуфера = Новый Структура("Clipboard", ПустойБуфер);
	Приложение.УстановитьТестовыеЗависимости(ЗависимостиБуфера);
КонецПроцедуры

Процедура ТестКонтекстCode()
	Сообщить("");
	Сообщить("--- Пайплайн: контекст Code ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("def foo():" + Символы.ПС + "    return 42");

	Окно = СоздатьОкно("code.exe", "app.py - Visual Studio Code");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Code");

	УтверждениеРавно("deepseek/deepseek-v4-flash", Результат.модель,
		"Code -> модель deepseek-v4-flash из models.json");
	Утверждение(Найти(Результат.инструкция, "def foo():") > 0,
		"Инструкция Code содержит выделенный текст");
	Утверждение(Найти(Результат.инструкция, "{text}") = 0,
		"Плейсхолдер {text} в инструкции подставлен (не осталось)");
	Утверждение(Найти(Результат.инструкция, "{language}") = 0,
		"Плейсхолдер {language} в инструкции подставлен (не осталось)");
	УтверждениеРавно("Python", Результат.язык,
		"Язык определен по .py в заголовке окна");
	УтверждениеРавно("function add(a, b) {" + Символы.ПС + "  return a + b;" + Символы.ПС + "}",
		Результат.ответ, "Ответ извлечен из fixture api-response-success");

	// Контракт CaptureResult
	Захват = Результат.захват;
	УтверждениеРавно("text", Захват.kind, "CaptureResult.kind = text для Code");
	УтверждениеРавно("selection", Захват.scope, "CaptureResult.scope = selection");
	УтверждениеРавно("code.exe", Захват.targetWindow.exe,
		"CaptureResult.targetWindow = окно-источник");
	Утверждение(Найти(Захват.original, "def foo():") > 0,
		"CaptureResult.original содержит захваченный текст");

	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "Ровно 1 запрос к OpenRouter");
	Если История.Количество() > 0 Тогда
		УтверждениеРавно("текстовый", История[0].тип, "Code -> текстовый запрос (не vision)");
		УтверждениеРавно("deepseek/deepseek-v4-flash", История[0].модель,
			"В OpenRouter ушла модель для Code");
	КонецЕсли;
КонецПроцедуры

// ========================================================
// Тест: контекст OneCCode (1С Конфигуратор) - Phase 3
// ========================================================

Процедура ТестКонтекстOneCCodeВыделение()
	Сообщить("");
	Сообщить("--- Пайплайн: OneCCode, выделенный фрагмент ---");

	МокOpenRouter.ОчиститьИсторию();
	Фрагмент = "Процедура Тест()" + Символы.ПС + "    Сообщить(1);" + Символы.ПС + "КонецПроцедуры";
	// Выделение непустое + есть «весь модуль» (не должен использоваться)
	МокWinInfo.УстановитьМодуль1С(Фрагмент, "весь модуль игнорируется при выделении");

	Окно = СоздатьОкно("1cv8.exe", "Модуль - Конфигуратор - Демо");
	Результат = Приложение.ЗапуститьОбработку(Окно, "OneCCode");

	УтверждениеРавно("deepseek/deepseek-v4-flash", Результат.модель,
		"OneCCode -> модель контекста Code (маппинг OneCCode->Code)");
	УтверждениеРавно("1C:Enterprise", Результат.язык,
		"OneCCode -> язык зафиксирован 1C:Enterprise");
	Утверждение(Найти(Результат.инструкция, "Процедура Тест()") > 0,
		"Инструкция OneCCode содержит выделенный фрагмент");
	Утверждение(Найти(Результат.инструкция, "{text}") = 0,
		"Плейсхолдер {text} подставлен");
	Утверждение(Найти(Результат.инструкция, "{language}") = 0,
		"Плейсхолдер {language} подставлен (язык 1С определен)");

	Захват = Результат.захват;
	УтверждениеРавно("text", Захват.kind, "CaptureResult.kind = text для OneCCode");
	УтверждениеРавно("selection", Захват.scope,
		"CaptureResult.scope = selection (есть выделение)");
	Утверждение(Найти(Захват.original, "Процедура Тест()") > 0,
		"CaptureResult.original = выделенный фрагмент (не весь модуль)");

	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "Ровно 1 запрос к OpenRouter (OneCCode выделение)");
	Если История.Количество() > 0 Тогда
		УтверждениеРавно("текстовый", История[0].тип, "OneCCode -> текстовый запрос (не vision)");
	КонецЕсли;
КонецПроцедуры

Процедура ТестКонтекстOneCCodeВесьМодуль()
	Сообщить("");
	Сообщить("--- Пайплайн: OneCCode, нет выделения -> весь модуль ---");

	МокOpenRouter.ОчиститьИсторию();
	ВесьМодуль = "Процедура Весь()" + Символы.ПС + "    Возврат;" + Символы.ПС + "КонецПроцедуры";
	// Выделение пустое -> ветка «весь модуль». ОбработчикСобытий в smoke = Неопределено,
	// поэтому подтверждение пропускается (диалог - ручной/manual-smoke).
	МокWinInfo.УстановитьМодуль1С("", ВесьМодуль);

	Окно = СоздатьОкно("1cv8.exe", "Модуль - Конфигуратор - Демо");
	Результат = Приложение.ЗапуститьОбработку(Окно, "OneCCode");

	Захват = Результат.захват;
	УтверждениеРавно("text", Захват.kind, "CaptureResult.kind = text (весь модуль)");
	УтверждениеРавно("fullModule", Захват.scope,
		"CaptureResult.scope = fullModule (нет выделения)");
	УтверждениеРавно(ВесьМодуль, Захват.original,
		"CaptureResult.original = весь модуль из UIA DocumentRange");
	УтверждениеРавно("1C:Enterprise", Результат.язык,
		"OneCCode весь модуль -> язык 1C:Enterprise");
	Утверждение(Найти(Результат.инструкция, "Процедура Весь()") > 0,
		"Инструкция содержит текст всего модуля");

	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "Ровно 1 запрос к OpenRouter (OneCCode весь модуль)");
КонецПроцедуры

