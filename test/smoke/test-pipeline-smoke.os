	Сообщить("");
	Сообщить("--- Пайплайн: контекст Text ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("привет  мир");

	Окно = СоздатьОкно("notepad.exe", "Безымянный - Блокнот");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Text");

	УтверждениеРавно("deepseek/deepseek-v4-flash", Результат.модель,
		"Text -> модель deepseek-v4-flash из models.json");
	Утверждение(Найти(Результат.инструкция, "привет  мир") > 0,
		"Инструкция Text содержит выделенный текст");

	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "Ровно 1 запрос к OpenRouter (Text)");
КонецПроцедуры

// Phase 13.5: Excel и Email собираются через выделение+буфер (Ctrl+C),
// как Code/Text/Word. Раньше Email не имел ветки, Excel слал TODO-заглушку.
Процедура ТестКонтекстExcel()
	Сообщить("");
	Сообщить("--- Пайплайн: контекст Excel (Phase 13.5) ---");

	МокOpenRouter.ОчиститьИсторию();
	// Excel отдает TSV выделенных ячеек через Ctrl+C -> буфер
	ДанныеЯчеек = "Товар" + Символы.Таб + "Цена" + Символы.ПС + "Хлеб" + Символы.Таб + "50";
	МокWinInfo.УстановитьВыделенныйТекст(ДанныеЯчеек);

	Окно = СоздатьОкно("excel.exe", "Книга1 - Excel");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Excel");

	УтверждениеРавно("deepseek/deepseek-v4-flash", Результат.модель,
		"Excel -> модель из models.json");
	Утверждение(Найти(Результат.инструкция, "Хлеб") > 0,
		"Инструкция Excel содержит данные ячеек");
	Утверждение(Найти(Результат.инструкция, "TODO") = 0,
		"Excel БОЛЬШЕ не отправляет TODO-заглушку в модель");
КонецПроцедуры

Процедура ТестКонтекстEmail()
	Сообщить("");
	Сообщить("--- Пайплайн: контекст Email (Phase 13.5) ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("Здравствуйте, прошу подтвердить встречу во вторник.");

	Окно = СоздатьОкно("outlook.exe", "Входящие - Outlook");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Email");

	УтверждениеРавно("deepseek/deepseek-v4-flash", Результат.модель,
		"Email -> модель из models.json");
	Утверждение(Найти(Результат.инструкция, "подтвердить встречу") > 0,
		"Инструкция Email содержит текст письма");
КонецПроцедуры

// ========================================================
// Тест 3: ПерезагрузитьНастройки() перечитывает конфиг с диска
// ========================================================

Процедура ТестПерезагрузкаНастроек()
	Сообщить("");
	Сообщить("--- Seam: ПерезагрузитьНастройки() ---");

	// Подменяем настройки моделей на заведомо фейковые в памяти
	ФейкCode = Новый Соответствие();
	ФейкCode.Вставить("model", "FAKE/reload-probe");
	ФейкCode.Вставить("temperature", 0.1);
	ФейкCode.Вставить("maxTokens", 128);
	ФейкКонтексты = Новый Соответствие();
	ФейкКонтексты.Вставить("Code", ФейкCode);
	ФейкФоллбэк = Новый Соответствие();
	ФейкФоллбэк.Вставить("model", "FAKE/fallback");
	ФейкФоллбэк.Вставить("temperature", 0.5);
	ФейкФоллбэк.Вставить("maxTokens", 256);
	ФейкМодели = Новый Соответствие();
	ФейкМодели.Вставить("contexts", ФейкКонтексты);
	ФейкМодели.Вставить("fallback", ФейкФоллбэк);

	Зав = Новый Структура();
	Зав.Вставить("НастройкиМоделей", ФейкМодели);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("Сообщить(1);");
	Окно = СоздатьОкно("code.exe", "modeule.bsl - Visual Studio Code");

	Результат = Приложение.ЗапуститьОбработку(Окно, "Code");
	УтверждениеРавно("FAKE/reload-probe", Результат.модель,
		"До reload: пайплайн использует подмененную модель из памяти");

	// Перечитать конфиги с диска
	УспехReload = Приложение.ПерезагрузитьНастройки();
	Утверждение(УспехReload = Истина, "ПерезагрузитьНастройки() вернула Истина");

	МокOpenRouter.ОчиститьИсторию();
	Результат2 = Приложение.ЗапуститьОбработку(Окно, "Code");
	УтверждениеРавно("deepseek/deepseek-v4-flash", Результат2.модель,
		"После reload: провайдер и модель взяты из models.json на диске");
	ЗавВосст = Новый Структура();
	ЗавВосст.Вставить("МокAI", Истина);
	Приложение.УстановитьТестовыеЗависимости(ЗавВосст);
КонецПроцедуры

// Phase 15.A: reload переинициализирует OpenRouter-клиент новым ключом
// (portable: ввод ключа в Настройках применяется без рестарта).
Процедура ТестReloadПереинициализируетКлюч()
	Сообщить("");
	Сообщить("--- Phase 15: reload переинициализирует OpenRouter-ключ ---");

	СвежийOR = ЗагрузитьСценарий(Путь("..", "mocks", "mock-openrouter-client.os"));
	Зав = Новый Структура();
	Зав.Вставить("OpenRouterКлиент", СвежийOR);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	СчетчикДо = СвежийOR.ПолучитьСчетчикИниц();
	Приложение.ПерезагрузитьНастройки();
	СчетчикПосле = СвежийOR.ПолучитьСчетчикИниц();

	Утверждение(СчетчикПосле > СчетчикДо,
		"reload дернул OpenRouterКлиент.Инициализировать (было " + СчетчикДо
		+ ", стало " + СчетчикПосле + ")");

	// Вернуть исходный мок в зависимости, чтобы не сломать соседние тесты
	ЗавВосст = Новый Структура();
	ЗавВосст.Вставить("OpenRouterКлиент", МокOpenRouter);
	ЗавВосст.Вставить("МокAI", Истина);
	Приложение.УстановитьТестовыеЗависимости(ЗавВосст);
КонецПроцедуры

// Phase 15.B (аудит privacy): textSource.priority="selection" не берет старый
// буфер при пустом выделении (иначе чужой скопированный текст молча уходит
// в модель); "clipboard" - берет (явное согласие).
Процедура ТестTextSourcePriority()
	Сообщить("");
	Сообщить("--- Phase 15: textSource.priority уважается ---");

	Окно = СоздатьОкно("notepad.exe", "Безымянный - Блокнот");

	// selection (дефолт): пустое выделение + непустой буфер -> в модель НЕ уходит
	МокWinInfo.УстановитьВыделенныйТекст("");         // выделения нет
	БуфSel = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	БуфSel.УстановитьТекст("СТАРЫЙ_БУФЕР_пароль");     // в буфере чужое
	Н1 = ЗагрузитьJSON(Путь("..", "..", "config", "settings.json"));
	ИсточникSel = Новый Соответствие();
	ИсточникSel.Вставить("priority", "selection");
	Н1.Вставить("textSource", ИсточникSel);
	Зав1 = Новый Структура();
	Зав1.Вставить("НастройкиОбщие", Н1);
	Зав1.Вставить("Clipboard", БуфSel);
	Приложение.УстановитьТестовыеЗависимости(Зав1);

	ОшибкаБыла = Ложь;
	Попытка
		Приложение.ЗапуститьОбработку(Окно, "Text");
	Исключение
		ОшибкаБыла = Истина;  // пустой текст -> «выделите фрагмент»
	КонецПопытки;
	Утверждение(ОшибкаБыла,
		"priority=selection: старый буфер НЕ берется -> пустой ввод -> ошибка (не утечка)");

	// clipboard: пустое выделение + буфер -> буфер берется
	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("");
	БуфClip = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	БуфClip.УстановитьТекст("текст-из-буфера");
	Н2 = ЗагрузитьJSON(Путь("..", "..", "config", "settings.json"));
	ИсточникClip = Новый Соответствие();
	ИсточникClip.Вставить("priority", "clipboard");
	Н2.Вставить("textSource", ИсточникClip);
	Зав2 = Новый Структура();
	Зав2.Вставить("НастройкиОбщие", Н2);
	Зав2.Вставить("Clipboard", БуфClip);
	Приложение.УстановитьТестовыеЗависимости(Зав2);

	Результат = Приложение.ЗапуститьОбработку(Окно, "Text");
	Утверждение(Найти(Результат.инструкция, "текст-из-буфера") > 0,
		"priority=clipboard: буфер берется как fallback (явное согласие)");
КонецПроцедуры

// Phase 15.A: тумблер трея preview.stream=false реально выключает стрим-путь
// (раньше ключ никто не читал - тумблер был плацебо).
Процедура ТестТумблерСтримВыключает()
	Сообщить("");
	Сообщить("--- Phase 15: preview.stream=false -> стрим-путь пропущен ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("текст для обработки");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьСтримУспех("streamed-контент", "cancelled");  // стрим доступен

	Н = ЗагрузитьJSON(Путь("..", "..", "config", "settings.json"));
	Preview = Н.Получить("preview");
	Если Preview = Неопределено Тогда
		Preview = Новый Соответствие();
		Н.Вставить("preview", Preview);
	КонецЕсли;
	Preview.Вставить("showPreview", Истина);
	Preview.Вставить("stream", Ложь);

	Зав = Новый Структура();
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Зав.Вставить("НастройкиОбщие", Н);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("notepad.exe", "Безымянный - Блокнот");
	Приложение.ЗапуститьОбработку(Окно, "Text");

	Утверждение(МокОбработчикСобытий.ПолучитьБылПоказСтрима() = Ложь,
		"preview.stream=false -> ПоказатьПревьюСтрим НЕ вызван (buffered путь)");

	// Контроль: с stream=true (по умолчанию) стрим-путь используется
	МокОбработчикСобытий2 = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий2.УстановитьСтримУспех("streamed-контент", "cancelled");
	Preview.Вставить("stream", Истина);
	Зав2 = Новый Структура();
	Зав2.Вставить("ОбработчикСобытий", МокОбработчикСобытий2);
	Зав2.Вставить("НастройкиОбщие", Н);
	Приложение.УстановитьТестовыеЗависимости(Зав2);
	Приложение.ЗапуститьОбработку(Окно, "Text");
	Утверждение(МокОбработчикСобытий2.ПолучитьБылПоказСтрима() = Истина,
		"preview.stream=true -> стрим-путь используется (контроль)");
КонецПроцедуры

// ========================================================
// Phase 4: replace-in-place (ветка Исход="applied")
// ========================================================

Процедура ТестЗаменаSelectionПрименена()
	Сообщить("");
	Сообщить("--- Replace: selection, replace.enabled, Исход=applied ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("def f():" + Символы.ПС + "    return 1");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("code.exe", "app.py - VS Code");
	Приложение.ЗапуститьОбработку(Окно, "Code");

	Утверждение(МокОбработчикСобытий.ПолучитьПоследнийAllowApply() = Истина,
		"allowApply=Истина (Code + replace.enabled)");
	ПутьКопии = МокХранилищеКопий.ПолучитьПоследнийПуть();
	Утверждение(Новый Файл(ПутьКопии).Расширение = ".zbsbackup", "Replace сохраняет шифрованный формат");
	Хранилище = Новый ХранилищеРезервныхКопий();
	УтверждениеРавно("def f():" + Символы.ПС + "    return 1", Хранилище.Прочитать(ПутьКопии),
		"DPAPI-копия содержит точный оригинал, доступный текущему пользователю");
	Вставка = МокWinInfo.ПолучитьПоследнююВставку();
	Утверждение(Вставка <> Неопределено, "ВставитьТекстВОкно вызвана при Исход=applied");
	Если Вставка <> Неопределено Тогда
		УтверждениеРавно("selection", Вставка.режим, "режим вставки = selection");
		УтверждениеРавно(99001, Вставка.handle, "handle целевого окна проброшен");
		Утверждение(Найти(Вставка.текст, "function add") > 0,
			"вставлен текст ответа AI (из fixture)");
	КонецЕсли;
КонецПроцедуры

Процедура ТестОшибкаКопииЗапрещаетЗамену()

	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("исходник для теста отказа");
	Обработчик = СвежийМокОбработчикСобытий();
	Обработчик.УстановитьИсход("applied");
	Настройки = НастройкиСReplace(Истина);
	Настройки["logging"].Вставить("enabled", Ложь);
	Зависимости = Новый Структура("НастройкиОбщие, ОбработчикСобытий", Настройки, Обработчик);
	Приложение.УстановитьТестовыеЗависимости(Зависимости);
	МокХранилищеКопий.УстановитьОшибку(Истина);
	Результат = Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "backup-failure - VS Code"), "Code");
	МокХранилищеКопий.УстановитьОшибку(Ложь);
	УтверждениеРавно("error", Результат.исход, "Отказ копии не маскируется успешным Replace");
	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено, "Без копии вставка не вызывается");
	Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "backup-retry - VS Code"), "Code");
	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() <> Неопределено,
		"После отказа следующая операция работает, даже при выключенном журнале");
	Хранилище = Новый ХранилищеРезервныхКопий();
	УтверждениеРавно("исходник для теста отказа", Хранилище.Прочитать(МокХранилищеКопий.ПолучитьПоследнийПуть()),
		"Выключенный журнал не отменяет обязательную шифрованную копию");

КонецПроцедуры

Процедура ТестЗаменаFullModuleПодтверждена()
	Сообщить("");
	Сообщить("--- Replace: fullModule, подтверждение=Да ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("");
	МокWinInfo.УстановитьМодуль1С("", "Процедура Весь()" + Символы.ПС + "КонецПроцедуры");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");
	МокОбработчикСобытий.УстановитьРезультатПодтверждения(Истина);

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("1cv8.exe", "Модуль - Конфигуратор - Демо");
	Приложение.ЗапуститьОбработку(Окно, "OneCCode");

	Утверждение(МокОбработчикСобытий.БылоПодтверждениеЗамены() = Истина,
		"ПодтвердитьЗаменуВсегоМодуля вызвана для scope=fullModule");
	Вставка = МокWinInfo.ПолучитьПоследнююВставку();
	Утверждение(Вставка <> Неопределено, "вставка выполнена после подтверждения");
	Если Вставка <> Неопределено Тогда
		УтверждениеРавно("fullModule", Вставка.режим, "режим вставки = fullModule");
	КонецЕсли;
КонецПроцедуры

Процедура ТестЗаменаFullModuleОтклонена()
	Сообщить("");
	Сообщить("--- Replace: fullModule, подтверждение=Нет -> без вставки ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("");
	МокWinInfo.УстановитьМодуль1С("", "Процедура Весь()" + Символы.ПС + "КонецПроцедуры");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");
	МокОбработчикСобытий.УстановитьРезультатПодтверждения(Ложь);

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("1cv8.exe", "Модуль - Конфигуратор - Демо");
	Приложение.ЗапуститьОбработку(Окно, "OneCCode");

	Утверждение(МокОбработчикСобытий.БылоПодтверждениеЗамены() = Истина,
		"диалог подтверждения был показан");
	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено,
		"вставка НЕ выполнена при отказе подтверждения (scope=fullModule)");
КонецПроцедуры

Процедура ТестЗаменаOptInВыключена()
	Сообщить("");
	Сообщить("--- Replace: фича выключена (opt-in) -> allowApply=Ложь, без вставки ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("x = 1");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Ложь));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("code.exe", "app.py - VS Code");
	Приложение.ЗапуститьОбработку(Окно, "Code");

	Утверждение(МокОбработчикСобытий.ПолучитьПоследнийAllowApply() = Ложь,
		"allowApply=Ложь когда replace.enabled не задан (opt-in)");
	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено,
		"defensive: вставка НЕ выполнена даже при Исход=applied (фича off)");
КонецПроцедуры

Процедура ТестОтменаБезЗамены()
	Сообщить("");
	Сообщить("--- Replace: Исход=cancelled -> без вставки ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("y = 2");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("cancelled");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("code.exe", "app.py - VS Code");
	Приложение.ЗапуститьОбработку(Окно, "Code");

	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено,
		"Исход=cancelled -> ВставитьТекстВОкно не вызвана");
КонецПроцедуры

// ========================================================
// Phase 5: streaming (инверсия потока, fallback) - Исход стрима
// ========================================================

Процедура ТестСтримУспешен()
	Сообщить("");
	Сообщить("--- Stream: успешный стрим, buffered НЕ вызывается ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("def f(): pass");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	СтримКод = "def f():" + Символы.ПС + "    return 42";
	МокОбработчикСобытий.УстановитьСтримУспех(СтримКод, "cancelled");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Ложь, Неопределено, Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("code.exe", "app.py - VS Code");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Code");

	Утверждение(МокОбработчикСобытий.БылПоказаСтрима() = Истина, "ПоказатьПревьюСтрим вызвана (стрим-путь приоритетен)");
	Утверждение(МокОбработчикСобытий.БылПоказаПревью() = Ложь, "старый ПоказатьПревью НЕ вызван при успешном стриме");
	Утверждение(Найти(Результат.ответ, "return 42") > 0, "ответ = контент стрима");
	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	Если История.Количество() > 0 Тогда
		УтверждениеРавно("стрим-подготовка", История[0].тип,
			"OpenRouter: только подготовка стрима, buffered-запрос НЕ слался");
	КонецЕсли;
КонецПроцедуры

Процедура ТестОшибкаСтримаБезПовтора()
	Сообщить("");
	Сообщить("--- Stream: ошибка не запускает повторный платный запрос ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.УстановитьВыделенныйТекст("привет мир");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьСтримОшибку("stream-error: имитация недоступности");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Ложь, Неопределено, Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("notepad.exe", "Безымянный - Блокнот");
	БылаОшибка = Ложь;
	Попытка
		Приложение.ЗапуститьОбработку(Окно, "Text");
	Исключение
		БылаОшибка = Истина;
	КонецПопытки;
	Утверждение(БылаОшибка, "ошибка стрима передана вызывающему коду");
	Утверждение(МокОбработчикСобытий.БылПоказаСтрима() = Истина, "стрим был попытан");
	Утверждение(МокОбработчикСобытий.БылПоказаПревью() = Ложь, "повторное превью не открыто");
	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	НашелТекстовый = Ложь;
	Для Каждого З Из История Цикл
		Если З.тип = "текстовый" Тогда НашелТекстовый = Истина; КонецЕсли;
	КонецЦикла;
	Утверждение(НЕ НашелТекстовый, "второй запрос не отправлен");
КонецПроцедуры

Процедура ТестНедоступнаяПривязкаЗапрещаетЗамену()
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьДоступностьПривязки(Ложь);
	МокWinInfo.УстановитьВыделенныйТекст("original source");
	Обработчик = СвежийМокОбработчикСобытий();
	Обработчик.УстановитьИсход("applied");
	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", Обработчик);
	Приложение.УстановитьТестовыеЗависимости(Зав);
	Результат = Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "test.py"), "Code");
	Утверждение(НЕ Обработчик.ПолучитьПоследнийAllowApply(), "без привязки Apply недоступен");
	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено,
		"поддельный applied без привязки не вызывает вставку");
	УтверждениеРавно("conflict", Результат.исход, "отказ не маскируется успешным применением");
	МокWinInfo.УстановитьДоступностьПривязки(Истина);
КонецПроцедуры

Процедура ТестКонфликтЗаменыСохраняетОтветБезПовтора()
	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("original");
	МокWinInfo.УстановитьРезультатВставки(Ложь, "source changed");
	Обработчик = СвежийМокОбработчикСобытий();
	Обработчик.УстановитьИсход("applied");
	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", Обработчик);
	Приложение.УстановитьТестовыеЗависимости(Зав);
	Результат = Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "test.py"), "Code");
	УтверждениеРавно("conflict", Результат.исход, "конфликт не возвращает applied");
	ОжидаемоеЧислоПоказов = 2;
	УтверждениеРавно(ОжидаемоеЧислоПоказов, Обработчик.ПолучитьКоличествоПревью(),
		"ответ открыт повторно для копирования");
	Превью = Обработчик.ПолучитьПоследнееПревью();
	УтверждениеРавно(0, Превью.Таймаут, "отказ не скрывает результат по таймауту");
	УтверждениеРавно(Результат.ответ, Превью.Результат, "повторно показан полученный ответ без изменений");
	Утверждение(НЕ Обработчик.ПолучитьПоследнийAllowApply(), "после конфликта повторный Apply запрещён");
	Утверждение(НЕ ПустаяСтрока(Обработчик.ПолучитьПримечание()), "причина отказа видна в окне");
	УтверждениеРавно(1, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(), "конфликт не вызывает запрос к ИИ");
	МокWinInfo.СброситьВставку();
КонецПроцедуры

Процедура ТестОтменаБлокируетПозднийОтвет()
	МокOpenRouter.ОчиститьИсторию();
	МокOpenRouter.УстановитьОтменуПередОтветом(Истина);
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("original");
	Обработчик = СвежийМокОбработчикСобытий();
	Обработчик.УстановитьИсход("applied");
	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", Обработчик);
	Приложение.УстановитьТестовыеЗависимости(Зав);
	Операция = Новый УправлениеОперацией();
	Утверждение(Операция.Начать(), "операция принята");
	БылаОтмена = Ложь;
	Попытка
		Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "test.py"), "Code");
	Исключение
		БылаОтмена = Операция.Отменена();
	КонецПопытки;
	Операция.Завершить();
	МокOpenRouter.УстановитьОтменуПередОтветом(Ложь);
	Утверждение(БылаОтмена, "поздний ответ прерван отменой");
	УтверждениеРавно(0, Обработчик.ПолучитьКоличествоПревью(), "поздний ответ не открыл превью");
	Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено, "отмена запрещает вставку");
	УтверждениеРавно(1, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(), "повторного запроса нет");
КонецПроцедуры

Процедура ТестПостоянныйСбойПревьюСохраняетОтветБезПовтора(Знач ПослеКонфликта = Ложь,
	Знач ОтказРезерва = Ложь)
	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("synthetic source");
	Обработчик = СвежийМокОбработчикСобытий();
	ОжидаемыйИсход = "error";
	ОжидаемыеПопытки = 1;
	Если ПослеКонфликта Тогда
		Обработчик.УстановитьИсход("applied");
		МокWinInfo.УстановитьРезультатВставки(Ложь, "source changed");
		Обработчик.УстановитьОшибкуПревью("synthetic persistent WebView failure", 1);
		ОжидаемыйИсход = "conflict";
		ОжидаемыеПопытки = 2;
	Иначе
		Обработчик.УстановитьОшибкуПревью("synthetic persistent WebView failure");
	КонецЕсли;
	Если ОтказРезерва Тогда
		Обработчик.УстановитьОшибкуРезерва("synthetic native window failure");
	КонецЕсли;
	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", Обработчик);
	Приложение.УстановитьТестовыеЗависимости(Зав);
	Результат = Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "fixture.py"), "Code");
	УтверждениеРавно(ОжидаемыйИсход, Результат.исход, "сбой UI не объявляется успешным применением");
	УтверждениеРавно(ОжидаемыеПопытки, Обработчик.ПолучитьКоличествоПревью(), "сломанный показ заменён нативным окном");
	Резерв = Обработчик.ПолучитьРезервныйРезультат();
	Утверждение(Резерв <> Неопределено, "полный ответ передан независимому от WebView каналу");
	Если Резерв <> Неопределено Тогда
		УтверждениеРавно(Результат.ответ, Резерв.Текст, "полученный ответ доступен без изменений");
	КонецЕсли;
	УтверждениеРавно(1, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(), "повторного AI-запроса нет");
	Если НЕ ПослеКонфликта Тогда
		Утверждение(МокWinInfo.ПолучитьПоследнююВставку() = Неопределено, "после сбоя UI вставка не выполняется");
	КонецЕсли;
	Если ОтказРезерва Тогда
		Хранилище = Новый ХранилищеРезервныхКопий();
		ПутьКопии = МокХранилищеКопий.ПолучитьПоследнийПуть();
		Утверждение(Найти(ПутьКопии, "_Result_") > 0, "аварийная копия ответа отличима от копии исходника");
		УтверждениеРавно(Результат.ответ, Хранилище.Прочитать(ПутьКопии),
			"при отказе обоих окон полученный ответ сохраняется через настоящий DPAPI");
	КонецЕсли;
	МокWinInfo.УстановитьРезультатВставки(Истина);
	МокWinInfo.СброситьВставку();
КонецПроцедуры

Процедура ТестВставкаПриОшибкеБуфераНеПредлагаетПовтор()
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("synthetic source");
	МокWinInfo.УстановитьРезультатВставки(Истина, "restore failed", Истина);
	Обработчик = СвежийМокОбработчикСобытий();
	Обработчик.УстановитьИсход("applied");
	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина));
	Зав.Вставить("ОбработчикСобытий", Обработчик);
	Приложение.УстановитьТестовыеЗависимости(Зав);
	Результат = Приложение.ЗапуститьОбработку(СоздатьОкно("code.exe", "fixture.py"), "Code");
	УтверждениеРавно("applied", Результат.исход, "ошибка восстановления не отменяет факт вставки");
	УтверждениеРавно(1, Обработчик.ПолучитьКоличествоПревью(), "повторное превью для вставки не предлагается");
	Сообщения = Обработчик.ПолучитьСообщенияСтатуса();
	Последнее = Сообщения[Сообщения.Количество() - 1];
	Утверждение(Найти(Последнее, "Буфер обмена не восстановлен") > 0, "плашка сообщает отдельное предупреждение");
	МокWinInfo.УстановитьРезультатВставки(Истина);
	МокWinInfo.СброситьВставку();
КонецПроцедуры

Процедура ТестСтримПрименен()
	Сообщить("");
	Сообщить("--- Stream: Исход=applied -> replace-in-place ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьВыделенныйТекст("x=1");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	СтримКод = "x = 1  # improved";
	МокОбработчикСобытий.УстановитьСтримУспех(СтримКод, "applied");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиСReplace(Истина, Неопределено, Истина));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("code.exe", "app.py - VS Code");
	Приложение.ЗапуститьОбработку(Окно, "Code");

	Утверждение(МокОбработчикСобытий.БылПоказаСтрима() = Истина, "стрим-путь использован");
	Вставка = МокWinInfo.ПолучитьПоследнююВставку();
	Утверждение(Вставка <> Неопределено, "Исход=applied из стрима -> ВставитьТекстВОкно вызвана");
	Если Вставка <> Неопределено Тогда
		УтверждениеРавно("selection", Вставка.режим, "режим вставки selection");
		Утверждение(Найти(Вставка.текст, "improved") > 0, "вставлен контент стрима");
	КонецЕсли;
КонецПроцедуры

// ========================================================
// Локальный Codex CLI: подписочный провайдер без OpenRouter-токена
// ========================================================

Процедура ТестПровайдерCodexCLI()
	Сообщить("");
	Сообщить("--- Провайдер Codex CLI: текст без OpenRouter-токена ---");

	МокOpenRouter.ОчиститьИсторию();
	МокCodex.ОчиститьИсторию();
	МокCodex.УстановитьОтвет("Исправленный код из Codex");
	МокWinInfo.УстановитьВыделенныйТекст("function oldName() { return 1; }");

	КаталогКонфига = Путь("..", "..", "config");
	МоделиCodex = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "models.json"));
	МоделиCodex["contexts"]["Code"].Вставить("provider", "codex");
	НастройкиCodex = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "settings.json"));
	НастройкиCodex["preview"].Вставить("stream", Ложь);
	МокП = СвежийМокОбработчикСобытий();

	Зав = Новый Структура();
	Зав.Вставить("НастройкиМоделей", МоделиCodex);
	Зав.Вставить("НастройкиОбщие", НастройкиCodex);
	Зав.Вставить("CodexКлиент", МокCodex);
	Зав.Вставить("ОбработчикСобытий", МокП);
	Зав.Вставить("APIКлюч", "");
	Зав.Вставить("МокAI", Ложь);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("code.exe", "sample.js - Visual Studio Code");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Code");

	УтверждениеРавно("codex", Результат.провайдер,
		"Code маршрутизирован в Codex CLI");
	УтверждениеРавно("Codex (ChatGPT)", Результат.модель,
		"пустая codexModel использует модель подписки по умолчанию");
	УтверждениеРавно("Исправленный код из Codex", Результат.ответ,
		"финальный ответ Codex возвращён в общий пайплайн");
	УтверждениеРавно(1, МокCodex.ПолучитьИсторию().Количество(),
		"выполнен ровно один вызов Codex");
	УтверждениеРавно(0, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(),
		"OpenRouter не вызван и токен не потребовался");

	ЗавR = Новый Структура();
	ЗавR.Вставить("APIКлюч", "test-key");
	ЗавR.Вставить("МокAI", Истина);
	Приложение.УстановитьТестовыеЗависимости(ЗавR);
КонецПроцедуры

Процедура ТестПровайдерCodexCLIСИзображением()
	Сообщить("");
	Сообщить("--- Провайдер Codex CLI: Browser с изображением и reasoning ---");

	МокOpenRouter.ОчиститьИсторию();
	МокCodex.ОчиститьИсторию();
	МокCodex.УстановитьОтвет("На странице показана форма входа");
	МокСкриншот.Сбросить();
	МокСкриншот.УстановитьПутьСнимка("browser-shot.png");

	КаталогКонфига = Путь("..", "..", "config");
	МоделиCodex = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "models.json"));
	МодельBrowser = МоделиCodex["contexts"]["Browser"];
	МодельBrowser.Вставить("provider", "codex");
	МодельBrowser.Вставить("codexModel", "gpt-5.6-sol");
	МодельBrowser.Вставить("codexReasoningEffort", "high");
	НастройкиCodex = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "settings.json"));
	НастройкиCodex["preview"].Вставить("stream", Ложь);

	Зав = Новый Структура();
	Зав.Вставить("НастройкиМоделей", МоделиCodex);
	Зав.Вставить("НастройкиОбщие", НастройкиCodex);
	Зав.Вставить("CodexКлиент", МокCodex);
	Зав.Вставить("APIКлюч", "");
	Зав.Вставить("МокAI", Ложь);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("chrome.exe", "Вход - Google Chrome");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Browser");
	УтверждениеРавно("codex", Результат.провайдер,
		"Browser маршрутизирован в Codex CLI");
	УтверждениеРавно("Codex: gpt-5.6-sol / reasoning high", Результат.модель,
		"в результате видны модель Sol и reasoning");
	ИсторияCodex = МокCodex.ПолучитьИсторию();
	УтверждениеРавно(1, ИсторияCodex.Количество(),
		"изображение отправлено одним вызовом Codex");
	Если ИсторияCodex.Количество() > 0 Тогда
		УтверждениеРавно("browser-shot.png", ИсторияCodex[0].изображение,
			"путь снимка передан в --image");
		УтверждениеРавно("gpt-5.6-sol", ИсторияCodex[0].модель,
			"выбрана модель GPT-5.6-Sol");
		УтверждениеРавно("high", ИсторияCodex[0].reasoning,
			"выбран высокий reasoning effort");
	КонецЕсли;
	УтверждениеРавно(0, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(),
		"Browser не вызывает OpenRouter при выбранном Codex");

	ЗавR = Новый Структура();
	ЗавR.Вставить("APIКлюч", "test-key");
	ЗавR.Вставить("МокAI", Истина);
	Приложение.УстановитьТестовыеЗависимости(ЗавR);
КонецПроцедуры

// ========================================================
// Phase 6: image->image (контекст Image, early-return ветка)
// ========================================================

Процедура ТестImageToImage()
	Сообщить("");
	Сообщить("--- Image->image: буфер-картинка -> улучшенный PNG -> показ ---");

	МокOpenRouter.ОчиститьИсторию();
	МокБуф = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	МокБуф.УстановитьИзображение("dummy-input.png");
	МокП = СвежийМокОбработчикСобытий();
	МокП.УстановитьИсходИзображения("saved");

	Зав = Новый Структура();
	Зав.Вставить("Clipboard", МокБуф);
	Зав.Вставить("ОбработчикСобытий", МокП);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("unknown.exe", "Clipboard image");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Image");

	Утверждение(Найти(Результат.ответ, ".png") > 0,
		"ответ = путь к сгенерированному PNG");
	Утверждение(Новый Файл(Результат.ответ).Существует(),
		"PNG реально создан нативным декодером (Base64Значение)");
	УтверждениеРавно("saved", Результат.исход,
		"исход показа картинки проброшен (saved)");
	Утверждение(Найти(МокП.ПолучитьПутьПоказаннойКартинки(), ".png") > 0,
		"ОбработчикСобытий.ПоказатьИзображение получил путь PNG");

	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	НашелImg = Ложь;
	Для Каждого З Из История Цикл
		Если З.тип = "image-to-image" Тогда НашелImg = Истина; КонецЕсли;
	КонецЦикла;
	Утверждение(НашелImg, "вызван ОтправитьЗапросНаУлучшениеИзображения (image->image)");

	// Восстановить дефолтный буфер (без картинки) для последующих тестов
	МокБуфДефолт = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	ЗавR = Новый Структура();
	ЗавR.Вставить("Clipboard", МокБуфДефолт);
	Приложение.УстановитьТестовыеЗависимости(ЗавR);
КонецПроцедуры

// ========================================================
// Phase 6.1: vision-bbox -> детерминированный кроп -> image->image
// ========================================================

Процедура ТестImageWindowShotКроп()
	Сообщить("");
	Сообщить("--- Image windowShot: vision-bbox -> кроп -> enhance ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьКроп();
	МокOpenRouter.УстановитьОбластьИзображения(70, 0, 230, 190);
	МокWinInfo.УстановитьРазмерКартинки(300, 220);
	МокWinInfo.УстановитьРезультатКропа(Истина);
	МокБуф = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os")); // без картинки -> windowShot
	МокП = СвежийМокОбработчикСобытий();
	МокП.УстановитьИсходИзображения("saved");

	Зав = Новый Структура();
	Зав.Вставить("Clipboard", МокБуф);
	Зав.Вставить("ОбработчикСобытий", МокП);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("i_view64.exe", "pic.jpg - IrfanView");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Image");

	Кроп = МокWinInfo.ПолучитьПоследнийКроп();
	Утверждение(Кроп <> Неопределено, "ОбрезатьPNG вызван для windowShot");
	Если Кроп <> Неопределено Тогда
		Утверждение(Кроп.x >= 0 И Кроп.y >= 0, "координаты кропа клэмпнуты >= 0");
		Утверждение(Кроп.x + Кроп.w <= 300 И Кроп.y + Кроп.h <= 220,
			"кроп не выходит за границы 300x220 (клэмп)");
	КонецЕсли;
	Утверждение(Найти(Результат.ответ, ".png") > 0, "итог - PNG");
	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	ЕстьBBox = Ложь; ЕстьImg = Ложь;
	Для Каждого З Из История Цикл
		Если З.тип = "vision-bbox" Тогда ЕстьBBox = Истина; КонецЕсли;
		Если З.тип = "image-to-image" Тогда ЕстьImg = Истина; КонецЕсли;
	КонецЦикла;
	Утверждение(ЕстьBBox, "был vision-bbox запрос (шаг 1)");
	Утверждение(ЕстьImg, "был image->image запрос (шаг 2, на кропе)");
КонецПроцедуры

Процедура ТестImageToImageЧерезCodex()
	Сообщить("");
	Сообщить("--- Paint -> Codex bbox -> imagegen -> новый PNG ---");

	МокOpenRouter.ОчиститьИсторию();
	МокCodex.ОчиститьИсторию();
	МокCodex.УстановитьОтвет("{""x"":20,""y"":40,""w"":260,""h"":160}");
	МокCodex.УстановитьОтветИзображения("codex-generated.png");
	МокWinInfo.СброситьКроп();
	МокWinInfo.УстановитьРазмерКартинки(300, 220);
	МокWinInfo.УстановитьРезультатКропа(Истина);
	МокСкриншот.Сбросить();
	МокСкриншот.УстановитьПутьСнимка("paint-window.png");
	МокБуф = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	МокП = СвежийМокОбработчикСобытий();
	МокП.УстановитьИсходИзображения("saved");

	КаталогКонфига = Путь("..", "..", "config");
	МоделиCodex = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "models.json"));
	МодельImage = МоделиCodex["contexts"]["Image"];
	МодельImage.Вставить("provider", "codex");
	МодельImage.Вставить("codexModel", "gpt-5.6-sol");
	МодельImage.Вставить("codexReasoningEffort", "high");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиМоделей", МоделиCodex);
	Зав.Вставить("Clipboard", МокБуф);
	Зав.Вставить("ОбработчикСобытий", МокП);
	Зав.Вставить("CodexКлиент", МокCodex);
	Зав.Вставить("APIКлюч", "");
	Зав.Вставить("МокAI", Ложь);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("mspaint.exe", "Набросок - Paint");
	Результат = Приложение.ЗапуститьОбработку(Окно, "Image");

	УтверждениеРавно("codex", Результат.провайдер,
		"Image использует Codex без OpenRouter-токена");
	УтверждениеРавно("codex-generated.png", Результат.ответ,
		"путь imagegen передан в общий Preview");
	УтверждениеРавно("saved", Результат.исход,
		"результат Codex можно сохранить из Image Preview");
	ИсторияCodex = МокCodex.ПолучитьИсторию();
	УтверждениеРавно(2, ИсторияCodex.Количество(),
		"выполнены bbox-анализ и одна генерация изображения");
	Если ИсторияCodex.Количество() = 2 Тогда
		УтверждениеРавно("text", ИсторияCodex[0].тип,
			"первый вызов определяет границы холста");
		УтверждениеРавно("paint-window.png", ИсторияCodex[0].изображение,
			"bbox получает снимок окна Paint");
		УтверждениеРавно("imagegen", ИсторияCodex[1].тип,
			"второй вызов запускает встроенный imagegen");
		Утверждение(Найти(ИсторияCodex[1].изображение, "crop_") > 0,
			"imagegen получает холст без интерфейса Paint");
		УтверждениеРавно(600, ИсторияCodex[1].таймаут,
			"генерации дан отдельный увеличенный таймаут");
	КонецЕсли;
	УтверждениеРавно(0, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(),
		"OpenRouter не вызывается ни для bbox, ни для генерации");

	ЗавR = Новый Структура();
	ЗавR.Вставить("НастройкиМоделей",
		ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "models.json")));
	ЗавR.Вставить("APIКлюч", "test-key");
	ЗавR.Вставить("МокAI", Истина);
	Приложение.УстановитьТестовыеЗависимости(ЗавR);
КонецПроцедуры

Процедура ТестImageBBoxFallback()
	Сообщить("");
	Сообщить("--- Image windowShot: сбой vision-bbox -> fallback на весь скриншот ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьКроп();
	МокOpenRouter.УстановитьРежимОшибки("vision недоступен (имитация)");
	МокWinInfo.УстановитьРазмерКартинки(300, 220);
	МокБуф = ЗагрузитьСценарий(Путь("..", "mocks", "mock-clipboard.os"));
	МокП = СвежийМокОбработчикСобытий();
	МокП.УстановитьИсходИзображения("cancelled");

	Зав = Новый Структура();
	Зав.Вставить("Clipboard", МокБуф);
	Зав.Вставить("ОбработчикСобытий", МокП);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("nomacs.exe", "img - nomacs");
	// РежимОшибки на моке роняет И bbox, И image->image. Нам нужен
	// сбой ТОЛЬКО bbox, а image->image должен отработать -> отдельный
	// прогон: сбой bbox обрабатывается Попыткой (graceful), но затем
	// ОтправитьЗапросНаУлучшениеИзображения тоже в РежимОшибки ->
	// исключение наружу. Проверяем что сбой bbox НЕ валит до того
	// (Попытка отработала, кроп пропущен), а исключение - от image-шага.
	Сбой = Ложь;
	Попытка
		Приложение.ЗапуститьОбработку(Окно, "Image");
	Исключение
		Сбой = Истина;
	КонецПопытки;
	Утверждение(МокWinInfo.ПолучитьПоследнийКроп() = Неопределено,
		"при сбое vision-bbox кроп НЕ выполнен (graceful, Попытка отработала)");
	Утверждение(Сбой, "исключение пришло от image->image шага (РежимОшибки), не от bbox");
КонецПроцедуры

// ========================================================
// Запуск
// ========================================================

