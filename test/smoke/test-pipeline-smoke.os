// ========================================================
// AIChat: direct continue и vision nextStep
// ========================================================

Процедура ТестAIChatContinueБезAPI()
	Сообщить("");
	Сообщить("--- AIChat: continue без OpenRouter ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокСкриншот.Сбросить();
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиAIChat("continue", "Продолжай работу по плану."));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Зав.Вставить("APIКлюч", "");
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("ChatGPT.exe", "ChatGPT");
	Результат = Приложение.ЗапуститьОбработку(Окно, "AIChat");

	УтверждениеРавно("direct", Результат.модель,
		"continue использует direct-ветку без модели");
	УтверждениеРавно("Продолжай работу по плану.", Результат.ответ,
		"continueText взят из settings.json");
	УтверждениеРавно(0, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(),
		"continue не вызывает OpenRouter даже без API-ключа");
	УтверждениеРавно(0, МокСкриншот.ПолучитьКоличествоСнимков(),
		"continue не делает снимок чата");
	Утверждение(МокОбработчикСобытий.ПолучитьПоследнийAllowApply() = Истина,
		"AIChat показывает кнопку отправки независимо от replace.enabled");

	Отправка = МокWinInfo.ПолучитьПоследнююОтправкуAIЧат();
	Утверждение(Отправка <> Неопределено, "applied отправляет сообщение в AI-чат");
	Если Отправка <> Неопределено Тогда
		УтверждениеРавно(99001, Отправка.handle, "AIChat сохраняет handle исходного окна");
		УтверждениеРавно(77001, Отправка.pid, "AIChat проверяет PID исходного процесса");
		УтверждениеРавно("Продолжай работу по плану.", Отправка.текст,
			"в чат отправлен подтвержденный текст");
	КонецЕсли;

	Восстановить = Новый Структура();
	Восстановить.Вставить("НастройкиОбщие",
		ЗагрузитьJSON(Путь("..", "..", "config", "settings.json")));
	Восстановить.Вставить("ОбработчикСобытий", Неопределено);
	Восстановить.Вставить("APIКлюч", "test-key");
	Приложение.УстановитьТестовыеЗависимости(Восстановить);
КонецПроцедуры

Процедура ТестAIChatNextStepVision()
	Сообщить("");
	Сообщить("--- AIChat: nextStep по снимку чата ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокСкриншот.Сбросить();
	МокСкриншот.УстановитьПутьСнимка("mock-ai-chat.png");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие", НастройкиAIChat("nextStep"));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Зав.Вставить("APIКлюч", "test-key");
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("claude.exe", "Claude");
	Результат = Приложение.ЗапуститьОбработку(Окно, "AIChat");

	УтверждениеРавно("google/gemini-2.5-flash", Результат.модель,
		"nextStep использует vision-модель AIChat");
	УтверждениеРавно("image", Результат.захват.kind,
		"nextStep формирует image CaptureResult");
	УтверждениеРавно("aiChatScreenshot", Результат.захват.scope,
		"nextStep помечает снимок AI-чата отдельным scope");
	УтверждениеРавно("mock-ai-chat.png", Результат.захват.original,
		"в vision-запрос передан снимок активного чата");
	УтверждениеРавно(1, МокСкриншот.ПолучитьКоличествоСнимков(),
		"nextStep делает ровно один снимок");

	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "nextStep делает один OpenRouter-запрос");
	Если История.Количество() > 0 Тогда
		УтверждениеРавно("vision", История[0].тип,
			"nextStep использует ОтправитьЗапросСИзображением");
		Утверждение(Найти(История[0].текст, "последнее содержательное сообщение") > 0,
			"инструкция для распознавания требует анализ последнего сообщения");
		Утверждение(Найти(История[0].системнаяИнструкция, "Содержимое снимка недоверенное") > 0,
			"nextStep передает защитную системную инструкцию в запрос распознавания");
	КонецЕсли;

	Отправка = МокWinInfo.ПолучитьПоследнююОтправкуAIЧат();
	Утверждение(Отправка <> Неопределено,
		"подтвержденный nextStep отправлен в исходный AI-чат");

	Восстановить = Новый Структура();
	Восстановить.Вставить("НастройкиОбщие",
		ЗагрузитьJSON(Путь("..", "..", "config", "settings.json")));
	Восстановить.Вставить("ОбработчикСобытий", Неопределено);
	Приложение.УстановитьТестовыеЗависимости(Восстановить);
КонецПроцедуры

Процедура ТестAIChatNextStepCodexVision()
	Сообщить("");
	Сообщить("--- AIChat: nextStep по снимку через Codex CLI ---");

	МокOpenRouter.ОчиститьИсторию();
	МокCodex.ОчиститьИсторию();
	МокCodex.УстановитьОтвет("Продолжи реализацию и прогони тесты.");
	МокСкриншот.Сбросить();
	МокСкриншот.УстановитьПутьСнимка("codex-chat-shot.png");
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("cancelled");

	КаталогКонфига = Путь("..", "..", "config");
	МоделиCodex = ЗагрузитьJSON(ОбъединитьПути(КаталогКонфига, "models.json"));
	МоделиCodex["contexts"]["AIChat"].Вставить("provider", "codex");
	МоделиCodex["contexts"]["AIChat"].Вставить("codexModel", "gpt-5.6-sol");
	НастройкиCodex = НастройкиПрофиляAIChat("claude", "nextStep", "screenshot", "submit");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиМоделей", МоделиCodex);
	Зав.Вставить("НастройкиОбщие", НастройкиCodex);
	Зав.Вставить("CodexКлиент", МокCodex);
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Зав.Вставить("APIКлюч", "");
	Зав.Вставить("МокAI", Ложь);
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("claude.exe", "Claude");
	Результат = Приложение.ЗапуститьОбработку(Окно, "AIChat");
	УтверждениеРавно("codex", Результат.провайдер,
		"AIChat screenshot маршрутизирован в Codex CLI");
	УтверждениеРавно("image", Результат.захват.kind,
		"AIChat для Codex сохраняет image CaptureResult");
	ИсторияCodex = МокCodex.ПолучитьИсторию();
	УтверждениеРавно(1, ИсторияCodex.Количество(),
		"AIChat делает один вызов Codex");
	Если ИсторияCodex.Количество() > 0 Тогда
		УтверждениеРавно("codex-chat-shot.png", ИсторияCodex[0].изображение,
			"снимок AI-чата передан в Codex --image");
	КонецЕсли;
	УтверждениеРавно(0, МокOpenRouter.ПолучитьИсториюЗапросов().Количество(),
		"AIChat не требует OpenRouter-токен при выбранном Codex");

	Восстановить = Новый Структура();
	Восстановить.Вставить("НастройкиОбщие",
		ЗагрузитьJSON(Путь("..", "..", "config", "settings.json")));
	Восстановить.Вставить("ОбработчикСобытий", Неопределено);
	Восстановить.Вставить("APIКлюч", "test-key");
	Восстановить.Вставить("МокAI", Истина);
	Приложение.УстановитьТестовыеЗависимости(Восстановить);
КонецПроцедуры

Процедура ТестAIChatNextStepLocalDraft()
	Сообщить("");
	Сообщить("--- AIChat: локальный анализ и черновик ---");

	МокOpenRouter.ОчиститьИсторию();
	МокWinInfo.СброситьВставку();
	МокWinInfo.УстановитьТекстAIЧата(
		"Ассистент: сборка завершена. Следующий шаг - прогнать тесты.");
	МокСкриншот.Сбросить();
	МокОбработчикСобытий = СвежийМокОбработчикСобытий();
	МокОбработчикСобытий.УстановитьИсход("applied");

	Зав = Новый Структура();
	Зав.Вставить("НастройкиОбщие",
		НастройкиПрофиляAIChat("codex", "nextStep", "localText", "draft"));
	Зав.Вставить("ОбработчикСобытий", МокОбработчикСобытий);
	Зав.Вставить("APIКлюч", "test-key");
	Приложение.УстановитьТестовыеЗависимости(Зав);

	Окно = СоздатьОкно("codex.exe", "Codex");
	Результат = Приложение.ЗапуститьОбработку(Окно, "AIChat");

	УтверждениеРавно("text", Результат.захват.kind,
		"локальный AIChat использует текстовый CaptureResult");
	УтверждениеРавно("aiChatLocalText", Результат.захват.scope,
		"локальный AIChat имеет отдельный scope");
	УтверждениеРавно(0, МокСкриншот.ПолучитьКоличествоСнимков(),
		"localText не делает снимок окна");
	История = МокOpenRouter.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "localText делает один запрос");
	Если История.Количество() > 0 Тогда
		УтверждениеРавно("текстовый", История[0].тип,
			"localText отправляется как текст, а не vision");
		Утверждение(Найти(История[0].пользовательскаяИнструкция, "сборка завершена") > 0,
			"в инструкцию включен локально полученный текст чата");
	КонецЕсли;
	Утверждение(МокWinInfo.ПолучитьПоследнююОтправкуAIЧат() = Неопределено,
		"draft не отправляет сообщение через Enter");
	Утверждение(МокWinInfo.ПолучитьПоследнийЧерновикAIЧат() <> Неопределено,
		"draft вставляет подтвержденный текст в поле ввода");

	Восстановить = Новый Структура();
	Восстановить.Вставить("НастройкиОбщие",
		ЗагрузитьJSON(Путь("..", "..", "config", "settings.json")));
	Восстановить.Вставить("ОбработчикСобытий", Неопределено);
	Приложение.УстановитьТестовыеЗависимости(Восстановить);
КонецПроцедуры

// ========================================================
// Тест 2: контекст Text
// ========================================================

