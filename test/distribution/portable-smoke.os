Корень = АргументыКоманднойСтроки[0];
Приложение = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "onescript", "zbs-main-polling.os"));
Если Приложение = Неопределено Тогда
	ВызватьИсключение "Application module was not loaded";
КонецЕсли;
КаталогМодулей = ОбъединитьПути(Корень, "src", "onescript", "modules");
Детектор = ЗагрузитьСценарий(ОбъединитьПути(КаталогМодулей, "context-detector.os"));
Окно = Новый Структура("exe,title", "winword.exe", "Synthetic document");
Если Детектор.ОпределитьКонтекст(Окно) <> "Word" Тогда
	ВызватьИсключение "Context detector failed";
КонецЕсли;
Чтение = Новый ЧтениеJSON();
Чтение.ОткрытьФайл(ОбъединитьПути(Корень, "config", "settings.json"));
Настройки = ПрочитатьJSON(Чтение, Истина);
Чтение.Закрыть();
Если ТипЗнч(Настройки) <> Тип("Соответствие") Или Настройки.Получить("general") = Неопределено Тогда
	ВызватьИсключение "Native JSON settings failed";
КонецЕсли;
Сообщить("PORTABLE-SMOKE-PASS");
