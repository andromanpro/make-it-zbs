// ========================================================
// Тесты: logger.os
// ========================================================
// Проверяет инициализацию, запись логов в файлы,
// чтение логов, очистку, лимит файлов.
// ========================================================

Перем ВсегоТестов;
Перем Пройдено;
Перем Провалено;
Перем Логгер;
Перем КаталогТестовыхЛогов;
Перем ИмяФлагаЛогирования; // Строка - имя общего выключателя.
Перем ИмяТестовойМодели; // Строка - модель-заглушка.
Перем КонтекстТекстовогоПроцессора; // Строка - контекст Word.
Перем КонтекстКода; // Строка - контекст редактора кода.

// ========================================================
// Утилиты
// ========================================================

Процедура Утверждение(Знач Условие, Знач ОписаниеТеста)

	ВсегоТестов = ВсегоТестов + 1;

	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
	КонецЕсли;

КонецПроцедуры

Процедура УтверждениеРавно(Знач Ожидаемое, Знач Фактическое, Знач ОписаниеТеста)

	Условие = (Ожидаемое = Фактическое);

	ВсегоТестов = ВсегоТестов + 1;

	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
		Сообщить("         Ожидалось: " + Ожидаемое);
		Сообщить("         Получено:  " + Фактическое);
	КонецЕсли;

КонецПроцедуры

// Создать свежий каталог для тестовых логов
Функция СоздатьВременныйКаталог()

	ВременныйКаталог = ОбъединитьПути(КаталогВременныхФайлов(), "zbs-test-logs-" + Строка(Новый УникальныйИдентификатор()));

	Если НЕ Новый Файл(ВременныйКаталог).Существует() Тогда
		СоздатьКаталог(ВременныйКаталог);
	КонецЕсли;

	Возврат ВременныйКаталог;

КонецФункции

// Подсчитать количество JSON-файлов в каталоге
Функция ПосчитатьФайлыЛогов(Знач Каталог)

	Файлы = НайтиФайлы(Каталог, "*.json");
	Возврат Файлы.Количество();

КонецФункции

// Файл начинается с UTF-8 BOM (EF BB BF)?
// ЧтениеТекста(UTF8) проглатывает BOM при чтении, поэтому проверяем сырые байты.
Функция ФайлИмеетBOM(Знач ПолныйПуть)

	ДвоичныеДанные = Новый ДвоичныеДанные(ПолныйПуть);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);
	Возврат Буфер.Размер >= 3 И Буфер[0] = 239 И Буфер[1] = 187 И Буфер[2] = 191;

КонецФункции

// Очистить каталог после теста
Процедура ОчиститьКаталог(Знач Каталог)

	Попытка
		УдалитьФайлы(Каталог);
	Исключение
		Сообщить("[WARN] Не удалось очистить тестовый каталог: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// ========================================================
// Тесты
// ========================================================

Процедура ТестИнициализация()

	Сообщить("");
	Сообщить("--- Инициализация логгера ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();

	ОшибкаВозникла = Ложь;
	Попытка
		Логгер.Инициализировать(КаталогТестовыхЛогов);
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Утверждение(НЕ ОшибкаВозникла, "Инициализация без ошибок");

	// Каталог должен существовать
	Утверждение(Новый Файл(КаталогТестовыхЛогов).Существует(),
		"Каталог логов создан");

КонецПроцедуры

Процедура ТестИнициализацияСоздаетКаталог()

	Сообщить("");
	Сообщить("--- Инициализация создает несуществующий каталог ---");

	НовыйКаталог = ОбъединитьПути(КаталогВременныхФайлов(), "zbs-test-new-" + Строка(Новый УникальныйИдентификатор()));

	Утверждение(НЕ Новый Файл(НовыйКаталог).Существует(),
		"Каталог изначально не существует");

	Логгер.Инициализировать(НовыйКаталог);

	Утверждение(Новый Файл(НовыйКаталог).Существует(),
		"Каталог создан при инициализации");

	// Очистка
	ОчиститьКаталог(НовыйКаталог);

КонецПроцедуры

Процедура ТестЛогированиеЗапроса()

	Сообщить("");
	Сообщить("--- Логирование запроса ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();
	Логгер.Инициализировать(КаталогТестовыхЛогов);

	КоличествоДо = ПосчитатьФайлыЛогов(КаталогТестовыхЛогов);

	Логгер.ЗаписатьЗапрос(КонтекстКода, "anthropic/claude-3.5-sonnet", "Improve this code");

	КоличествоПосле = ПосчитатьФайлыЛогов(КаталогТестовыхЛогов);

	Утверждение(КоличествоПосле > КоличествоДо,
		"Создан файл лога запроса (было " + КоличествоДо + ", стало " + КоличествоПосле + ")");

	// Проверить содержимое лога
	Файлы = НайтиФайлы(КаталогТестовыхЛогов, "request_*.json");
	Утверждение(Файлы.Количество() > 0, "Файл лога начинается с 'request_'");

	Если Файлы.Количество() > 0 Тогда
		Чтение = Новый ЧтениеТекста(Файлы[0].ПолноеИмя, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		ДанныеЛога = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		УтверждениеРавно("request", ДанныеЛога.type, "Тип лога = request");
		УтверждениеРавно(КонтекстКода, ДанныеЛога.context, "Контекст = Code");
		УтверждениеРавно("anthropic/claude-3.5-sonnet", ДанныеЛога.model, "Модель записана");
		Утверждение(ДанныеЛога.Свойство("prompt"), "Лог содержит поле prompt");
	КонецЕсли;

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестЛогированиеОтвета()

	Сообщить("");
	Сообщить("--- Логирование ответа ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();
	Логгер.Инициализировать(КаталогТестовыхЛогов);

	ИнфоТокенов = Новый Структура();
	ИнфоТокенов.Вставить("prompt_tokens", 100);
	ИнфоТокенов.Вставить("completion_tokens", 50);
	ИнфоТокенов.Вставить("total_tokens", 150);

	Логгер.ЗаписатьОтвет("Text", "openai/gpt-4-turbo", "Improved text here", ИнфоТокенов);

	Файлы = НайтиФайлы(КаталогТестовыхЛогов, "response_*.json");
	Утверждение(Файлы.Количество() > 0, "Файл лога ответа создан");

	Если Файлы.Количество() > 0 Тогда
		Чтение = Новый ЧтениеТекста(Файлы[0].ПолноеИмя, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		ДанныеЛога = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		УтверждениеРавно("response", ДанныеЛога.type, "Тип лога = response");
		УтверждениеРавно("Text", ДанныеЛога.context, "Контекст = Text");
		Утверждение(ДанныеЛога.Свойство("usage"), "Лог содержит usage");
	КонецЕсли;

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестЛогированиеОшибки()

	Сообщить("");
	Сообщить("--- Логирование ошибки ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();
	Логгер.Инициализировать(КаталогТестовыхЛогов);

	Логгер.ЗаписатьОшибку("hotkey", "HTTP 500: Internal Server Error");

	Файлы = НайтиФайлы(КаталогТестовыхЛогов, "error_*.json");
	Утверждение(Файлы.Количество() > 0, "Файл лога ошибки создан");

	Если Файлы.Количество() > 0 Тогда
		Чтение = Новый ЧтениеТекста(Файлы[0].ПолноеИмя, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		ДанныеЛога = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		УтверждениеРавно("error", ДанныеЛога.type, "Тип лога = error");
		Утверждение(Найти(ДанныеЛога.error, "500") > 0, "Ошибка содержит код 500");
	КонецЕсли;

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестЛогированиеСессии()

	Сообщить("");
	Сообщить("--- Логирование полной сессии ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();
	Логгер.Инициализировать(КаталогТестовыхЛогов);

	ВремяТестовойСессии = 1500;
	Логгер.ЗаписатьСессию(КонтекстКода, "claude-3.5-sonnet", "Improve code", "Improved code result", ВремяТестовойСессии);

	Файлы = НайтиФайлы(КаталогТестовыхЛогов, "session_*.json");
	Утверждение(Файлы.Количество() > 0, "Файл лога сессии создан");

	Если Файлы.Количество() > 0 Тогда
		Чтение = Новый ЧтениеТекста(Файлы[0].ПолноеИмя, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		ДанныеЛога = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		УтверждениеРавно("session", ДанныеЛога.type, "Тип лога = session");
		Утверждение(ДанныеЛога.Свойство("request"), "Сессия содержит request");
		Утверждение(ДанныеЛога.Свойство("response"), "Сессия содержит response");
		УтверждениеРавно(1500, ДанныеЛога.execution_time_ms, "Время выполнения = 1500 мс");
	КонецЕсли;

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестОчисткаЛогов()

	Сообщить("");
	Сообщить("--- Очистка всех логов ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();
	Логгер.Инициализировать(КаталогТестовыхЛогов);

	// Создать несколько логов
	Логгер.ЗаписатьЗапрос(КонтекстКода, "model1", "prompt1");
	Логгер.ЗаписатьЗапрос("Text", "model2", "prompt2");
	Логгер.ЗаписатьОшибку("test", "test error");

	Утверждение(ПосчитатьФайлыЛогов(КаталогТестовыхЛогов) >= 3,
		"Создано минимум 3 лога перед очисткой");

	Логгер.ОчиститьВсеЛоги();

	УтверждениеРавно(0, ПосчитатьФайлыЛогов(КаталогТестовыхЛогов),
		"После очистки файлов логов = 0");

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестОтключениеЛогирования()

	Сообщить("");
	Сообщить("--- Отключение логирования через настройки ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();

	Настройки = Новый Соответствие();
	Настройки.Вставить("logRequests", Ложь);
	Настройки.Вставить("logResponses", Ложь);

	Логгер.Инициализировать(КаталогТестовыхЛогов, Настройки);

	// Запрос и ответ не должны создавать файлы
	Логгер.ЗаписатьЗапрос(КонтекстКода, ИмяТестовойМодели, "prompt");
	Логгер.ЗаписатьОтвет(КонтекстКода, ИмяТестовойМодели, "response");

	// Ошибки всегда логируются (нет флага для их отключения)
	// Но request и response отключены
	ФайлыЗапросов = НайтиФайлы(КаталогТестовыхЛогов, "request_*.json");
	ФайлыОтветов = НайтиФайлы(КаталогТестовыхЛогов, "response_*.json");

	УтверждениеРавно(0, ФайлыЗапросов.Количество(),
		"При logRequests=false файлы запросов НЕ создаются");

	УтверждениеРавно(0, ФайлыОтветов.Количество(),
		"При logResponses=false файлы ответов НЕ создаются");

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестЛогированиеEnabledHardOff()

	Сообщить("");
	Сообщить("--- logging.enabled=false выключает логи (hard-off, Phase 13.4) ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();

	// enabled=false ПЕРЕБИВАЕТ logRequests/logResponses=true
	Настройки = Новый Соответствие();
	Настройки.Вставить(ИмяФлагаЛогирования, Ложь);
	Настройки.Вставить("logRequests", Истина);
	Настройки.Вставить("logResponses", Истина);

	Логгер.Инициализировать(КаталогТестовыхЛогов, Настройки);

	Логгер.ЗаписатьЗапрос(КонтекстКода, ИмяТестовойМодели, "prompt");
	Логгер.ЗаписатьОтвет(КонтекстКода, ИмяТестовойМодели, "response");
	// Phase 15: ошибки и сессии тоже под hard-off (в них попадает контент)
	Логгер.ЗаписатьОшибку(КонтекстКода, "текст ошибки с фрагментом ответа модели");
	ВремяТестовойСессии = 100;
	Логгер.ЗаписатьСессию(КонтекстКода, ИмяТестовойМодели, "запрос", "ответ", ВремяТестовойСессии);

	ФайлыЗапросов = НайтиФайлы(КаталогТестовыхЛогов, "request_*.json");
	ФайлыОтветов = НайтиФайлы(КаталогТестовыхЛогов, "response_*.json");
	ФайлыОшибок = НайтиФайлы(КаталогТестовыхЛогов, "error_*.json");
	ФайлыСессий = НайтиФайлы(КаталогТестовыхЛогов, "session_*.json");

	УтверждениеРавно(0, ФайлыЗапросов.Количество(),
		"enabled=false: запросы НЕ пишутся даже при logRequests=true");
	УтверждениеРавно(0, ФайлыОтветов.Количество(),
		"enabled=false: ответы НЕ пишутся даже при logResponses=true");
	УтверждениеРавно(0, ФайлыОшибок.Количество(),
		"Phase 15: enabled=false гасит и ОШИБКИ (в них фрагменты контента)");
	УтверждениеРавно(0, ФайлыСессий.Количество(),
		"Phase 15: enabled=false гасит и СЕССИИ (запрос+ответ)");

	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестФорматJSON()

	Сообщить("");
	Сообщить("--- Формат файлов JSON ---");

	КаталогТестовыхЛогов = СоздатьВременныйКаталог();
	// Явно включить логирование (после ТестОтключениеЛогирования флаги сброшены)
	НастройкиВкл = Новый Соответствие();
	НастройкиВкл.Вставить("logRequests", Истина);
	НастройкиВкл.Вставить("logResponses", Истина);
	Логгер.Инициализировать(КаталогТестовыхЛогов, НастройкиВкл);

	Логгер.ЗаписатьЗапрос(КонтекстКода, "claude-3.5-sonnet", "Test prompt");

	Файлы = НайтиФайлы(КаталогТестовыхЛогов, "*.json");
	Утверждение(Файлы.Количество() > 0, "JSON файл создан");

	Если Файлы.Количество() > 0 Тогда
		Чтение = Новый ЧтениеТекста(Файлы[0].ПолноеИмя, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();

		// Проверить что файл является валидным JSON
		ОшибкаПарсинга = Ложь;
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON();
			ЧтениеJSON.УстановитьСтроку(Содержимое);
			ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
		Исключение
			ОшибкаПарсинга = Истина;
		КонецПопытки;

		Утверждение(НЕ ОшибкаПарсинга, "Файл содержит валидный JSON");
		Утверждение(СтрДлина(Содержимое) > 10, "JSON не пустой (длина > 10)");
		Утверждение(НЕ ФайлИмеетBOM(Файлы[0].ПолноеИмя),
			"Лог-файл записан UTF-8 БЕЗ BOM");
	КонецЕсли;

	// Очистка
	ОчиститьКаталог(КаталогТестовыхЛогов);

КонецПроцедуры

Процедура ТестТехническийЖурналБезКонтента()

	Каталог = СоздатьВременныйКаталог();
	Настройки = Новый Соответствие();
	Настройки.Вставить(ИмяФлагаЛогирования, Истина);
	Настройки.Вставить("diagnosticsOnly", Истина);
	Настройки.Вставить("logRequests", Истина);
	Настройки.Вставить("logResponses", Истина);
	Логгер.Инициализировать(Каталог, Настройки);
	Секрет = "private-document-OPENROUTER_API_KEY=sk-secret-fixture";
	РазмерТестовогоВыделения = 42;
	ОжидаемоеЧислоСобытий = 2;
	ПаузаДляРазныхДатФайлов = 1100;
	Логгер.ЗаписатьЗапрос(КонтекстТекстовогоПроцессора, ИмяТестовойМодели, Секрет);
	Логгер.ЗаписатьОтвет(КонтекстТекстовогоПроцессора, ИмяТестовойМодели, Секрет);
	Логгер.ЗаписатьСессию(КонтекстТекстовогоПроцессора, ИмяТестовойМодели, Секрет, Секрет);
	Логгер.ЗаписатьСобытие(КонтекстТекстовогоПроцессора, "captured", РазмерТестовогоВыделения, Истина);
	Логгер.ЗаписатьОшибку("hotkey", Секрет, Новый Структура("text", Секрет));
	Записи = Логгер.ПолучитьПоследниеЛоги();
	УтверждениеРавно(ОжидаемоеЧислоСобытий, Записи.Количество(),
		"Технический режим пишет только события и безопасную ошибку");
	Для Каждого Запись Из Записи Цикл
		УтверждениеРавно("diagnostic", Запись.type, "Тип безопасной записи - diagnostic");
		НетКонтента = НЕ Запись.Свойство("request") И НЕ Запись.Свойство("response")
			И НЕ Запись.Свойство("error") И НЕ Запись.Свойство("additional_data");
		Утверждение(НетКонтента,
			"В журнале отсутствуют поля с содержимым документа и ошибки");
	КонецЦикла;
	Для Каждого Файл Из НайтиФайлы(Каталог, "*.json") Цикл
		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Утверждение(Найти(Текст, Секрет) = 0, "Секрет и текст не попали в JSON");
	КонецЦикла;
	ОчиститьКаталог(Каталог);
	Каталог = СоздатьВременныйКаталог();
	Настройки.Вставить(ИмяФлагаЛогирования, Ложь);
	Логгер.Инициализировать(Каталог, Настройки);
	Логгер.ЗаписатьСобытие(КонтекстТекстовогоПроцессора, "accepted");
	УтверждениеРавно(0, ПосчитатьФайлыЛогов(Каталог), "Hard-off выключает и технические события");
	Настройки.Вставить(ИмяФлагаЛогирования, Истина);
	Логгер.Инициализировать(Каталог, Настройки);
	Логгер.ЗаписатьСобытие(КонтекстТекстовогоПроцессора, "accepted");
	УтверждениеРавно(1, ПосчитатьФайлыЛогов(Каталог), "Повторная настройка включает технический журнал без перезапуска");
	Приостановить(ПаузаДляРазныхДатФайлов);
	Логгер.ЗаписатьСобытие("Image", "captured");
	Последние = Логгер.ПолучитьПоследниеЛоги(1);
	УтверждениеРавно("Image", Последние[0].context, "Последние логи отсортированы от новых к старым");
	ОчиститьКаталог(Каталог);

КонецПроцедуры

// ========================================================
// Запуск тестов
// ========================================================

Процедура ТестОчисткаШифрованныхКопий()

	Каталог = СоздатьВременныйКаталог();
	Настройки = Новый Соответствие();
	Настройки.Вставить(ИмяФлагаЛогирования, Ложь);
	ЛимитКопий = 2;
	Настройки.Вставить("maxLogFiles", ЛимитКопий);
	Логгер.Инициализировать(Каталог, Настройки);
	КаталогКопий = ОбъединитьПути(Каталог, "backups");
	СоздатьКаталог(КаталогКопий);
	Для Индекс = 1 По 3 Цикл
		// Проверяется только отбор файлов по расширению, не формат DPAPI.
		Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогКопий, Строка(Индекс) + ".zbsbackup"));
		Запись.Записать("fixture");
		Запись.Закрыть();
	КонецЦикла;
	Логгер.ОчиститьЗахваченныйКонтент();
	УтверждениеРавно(ЛимитКопий, НайтиФайлы(КаталогКопий, "*.zbsbackup").Количество(),
		"Шифрованные копии подчиняются maxLogFiles даже при выключенном журнале");
	УтверждениеРавно(0, ПосчитатьФайлыЛогов(Каталог), "Очистка копий не включает запись журнала");
	ОчиститьКаталог(Каталог);

КонецПроцедуры

Процедура ТестОчисткаИспользуетВладельцаВременныхФайлов()
	Каталог = СоздатьВременныйКаталог();
	Настройки = Новый Соответствие();
	Настройки.Вставить("enabled", Ложь);
	ПутьККомпоненту = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "mocks", "mock-clipboard.os");
	Компонент = ЗагрузитьСценарий(ПутьККомпоненту);
	Логгер.Инициализировать(Каталог, Настройки, Компонент);
	Логгер.ОчиститьЗахваченныйКонтент();
	ЛимитВременныхФайлов = 20;
	УтверждениеРавно(ЛимитВременныхФайлов, Компонент.ПолучитьЛимитОчистки(),
		"Очистку реального каталога выполняет его C#-владелец даже при выключенном журнале");
	УтверждениеРавно(0, ПосчитатьФайлыЛогов(Каталог), "Очистка временных файлов не сохраняет контент");
	ОчиститьКаталог(Каталог);
КонецПроцедуры

ВсегоТестов = 0;
ИмяФлагаЛогирования = "enabled";
ИмяТестовойМодели = "model";
КонтекстТекстовогоПроцессора = "Word";
КонтекстКода = "Code";
Пройдено = 0;
Провалено = 0;

Сообщить("========================================");
Сообщить("Тесты: logger");
Сообщить("========================================");

// Загрузить тестируемый модуль (путь цепочкой по 2 аргумента)
ПутьКМодулю = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "..");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "src");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "onescript");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "modules");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "logger.os");
Логгер = ЗагрузитьСценарий(ПутьКМодулю);

// Запустить тесты
ТестИнициализация();
ТестИнициализацияСоздаетКаталог();
ТестЛогированиеЗапроса();
ТестЛогированиеОтвета();
ТестЛогированиеОшибки();
ТестЛогированиеСессии();
ТестОчисткаЛогов();
ТестОтключениеЛогирования();
ТестЛогированиеEnabledHardOff();
ТестФорматJSON();
ТестТехническийЖурналБезКонтента();
ТестОчисткаШифрованныхКопий();
ТестОчисткаИспользуетВладельцаВременныхФайлов();

// Итоги
Сообщить("");
Сообщить("========================================");
Сообщить("Итого: " + ВсегоТестов + " | Pass: " + Пройдено + " | Fail: " + Провалено);
Сообщить("========================================");

Если Провалено > 0 Тогда
	ВызватьИсключение "ПРОВАЛЕНО тестов: " + Провалено;
КонецЕсли;
