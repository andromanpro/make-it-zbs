// ========================================================
// Тесты: context-detector.os
// ========================================================
// Проверка определения контекста по процессу, заголовку,
// определения языка программирования, vision-контекстов.
// ========================================================

Перем ВсегоТестов;
Перем Пройдено;
Перем Провалено;
Перем Детектор;
Перем КонтекстКода; // Строка - имя контекста редактора.
Перем КонтекстБраузера; // Строка - имя контекста браузера.
Перем КонтекстТекста; // Строка - имя обычного текста.
Перем НеизвестныйЯзык; // Строка - результат без языка программирования.
Перем КонтекстИзображения; // Строка - имя контекста изображения.

// ========================================================
// Утилиты
// ========================================================

Процедура Утверждение(Знач Условие, Знач ОписаниеТеста)

	ВсегоТестов = ВсегоТестов + 1;

	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
	КонецЕсли;

КонецПроцедуры

Процедура УтверждениеРавно(Знач Ожидаемое, Знач Фактическое, Знач ОписаниеТеста)

	Условие = (Ожидаемое = Фактическое);

	ВсегоТестов = ВсегоТестов + 1;

	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
		Сообщить("         Ожидалось: " + Ожидаемое);
		Сообщить("         Получено:  " + Фактическое);
	КонецЕсли;

КонецПроцедуры

// Создать структуру, имитирующую ИнформацияОбОкне
Функция СоздатьОкно(Знач ИмяПроцесса, Знач Заголовок)

	Окно = Новый Структура();
	Окно.Вставить("exe", ИмяПроцесса);
	Окно.Вставить("title", Заголовок);

	Возврат Окно;

КонецФункции

// ========================================================
// Тесты определения контекста по процессу
// ========================================================

Процедура ТестОпределениеКонтекстаПоПроцессу()

	Сообщить("");
	Сообщить("--- Определение контекста по имени процесса ---");

	// Code - редакторы кода
	Окно = СоздатьОкно("code.exe", "main.py - Visual Studio Code");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "VS Code -> Code");

	Окно = СоздатьОкно("devenv.exe", "Solution Explorer");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Visual Studio -> Code");

	Окно = СоздатьОкно("idea64.exe", "Project - IntelliJ IDEA");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "IntelliJ IDEA -> Code");

	Окно = СоздатьОкно("notepad++.exe", "config.json - Notepad++");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Notepad++ -> Code");

	Окно = СоздатьОкно("sublime_text.exe", "index.html");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Sublime Text -> Code");

	// Browser - браузеры
	Окно = СоздатьОкно("chrome.exe", "Google - Google Chrome");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Chrome -> Browser");

	Окно = СоздатьОкно("firefox.exe", "GitHub - Firefox");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Firefox -> Browser");

	Окно = СоздатьОкно("msedge.exe", "Bing - Microsoft Edge");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Edge -> Browser");

	// Excel
	Окно = СоздатьОкно("excel.exe", "Book1 - Excel");
	УтверждениеРавно("Excel", Детектор.ОпределитьКонтекст(Окно), "Excel -> Excel");

	// Email
	Окно = СоздатьОкно("outlook.exe", "Inbox - Outlook");
	УтверждениеРавно("Email", Детектор.ОпределитьКонтекст(Окно), "Outlook -> Email");

	Окно = СоздатьОкно("thunderbird.exe", "Mozilla Thunderbird");
	УтверждениеРавно("Email", Детектор.ОпределитьКонтекст(Окно), "Thunderbird -> Email");

	// Word
	Окно = СоздатьОкно("winword.exe", "Document1 - Word");
	УтверждениеРавно("Word", Детектор.ОпределитьКонтекст(Окно), "Word -> Word");

КонецПроцедуры

// ========================================================
// Тесты определения контекста AIChat
// ========================================================

Процедура ТестОпределениеКонтекстаAIChat()

	Сообщить("");
	Сообщить("--- Определение контекста AIChat ---");

	Окно = СоздатьОкно("ChatGPT.exe", "ChatGPT");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно),
		"ChatGPT desktop / Codex -> AIChat");

	Окно = СоздатьОкно("claude.exe", "Claude");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно),
		"Claude desktop -> AIChat");

	Окно = СоздатьОкно("opencode.exe", "OpenCode");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно),
		"OpenCode process -> AIChat");

	Окно = СоздатьОкно("WindowsTerminal.exe", "Claude Code - project");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно),
		"Claude Code в Windows Terminal -> AIChat");

	Окно = СоздатьОкно("WindowsTerminal.exe", "OpenCode - repository");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно),
		"OpenCode в Windows Terminal -> AIChat");

	Окно = СоздатьОкно("WindowsTerminal.exe", "Codex CLI");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно),
		"Codex CLI в Windows Terminal -> AIChat");

	// Регрессия: имя файла в редакторе не является признаком активного агента.
	Окно = СоздатьОкно("code.exe", "CLAUDE.md - project - Visual Studio Code");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно),
		"CLAUDE.md в VS Code остается Code");

	// AIChat проверяется раньше clipboard Image: хоткей продолжает диалог,
	// даже если пользователь ранее скопировал картинку.
	Буфер = Новый Структура();
	Буфер.Вставить("имеетИзображение", Истина);
	Окно = СоздатьОкно("ChatGPT.exe", "ChatGPT");
	УтверждениеРавно("AIChat", Детектор.ОпределитьКонтекст(Окно, Буфер),
		"AIChat имеет приоритет над картинкой в буфере");

КонецПроцедуры

// ========================================================
// Тесты определения контекста по заголовку окна
// ========================================================

Процедура ТестОпределениеКонтекстаПоЗаголовку()

	Сообщить("");
	Сообщить("--- Определение контекста по заголовку окна ---");

	// Расширение файла в заголовке -> Code
	Окно = СоздатьОкно("unknown.exe", "main.py - Some Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Заголовок .py -> Code");

	Окно = СоздатьОкно("unknown.exe", "app.js - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Заголовок .js -> Code");

	Окно = СоздатьОкно("unknown.exe", "Program.cs - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Заголовок .cs -> Code");

	Окно = СоздатьОкно("unknown.exe", "Main.java - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Заголовок .java -> Code");

	Окно = СоздатьОкно("unknown.exe", "module.cpp - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Заголовок .cpp -> Code");

	Окно = СоздатьОкно("unknown.exe", "server.go - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Заголовок .go -> Code");

	// URL в заголовке -> Browser
	Окно = СоздатьОкно("unknown.exe", "https://example.com - Page");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Заголовок https -> Browser");

	Окно = СоздатьОкно("unknown.exe", "www.google.com - Search");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Домен google.com не является файлом .go");
	Окно = СоздатьОкно("unknown.exe", "config.json - Viewer");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно), ".json не является расширением .js");
	Окно = СоздатьОкно("unknown.exe", "http-client.py - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "Имя http-client.py не является URL");
	Окно = СоздатьОкно("encode.exe", "Untitled");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно), "encode.exe не является code.exe");
	Окно = СоздатьОкно("notcodex.exe", "Untitled");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно), "notcodex.exe не является codex.exe");
	Окно = СоздатьОкно("WindowsTerminal.exe", "F:/repos/codex-project");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно),
		"Путь к каталогу Codex не доказывает запущенный чат");
	Окно = СоздатьОкно("WindowsTerminal.exe", "claude.md - project");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно), "claude.md в терминале не является Claude Code");
	Окно = СоздатьОкно("unknown.exe", "www.example.com - Search");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Заголовок www. -> Browser");

	// Неизвестный процесс и заголовок -> Text (по умолчанию)
	Окно = СоздатьОкно("unknown.exe", "Some Window");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно), "Неизвестное окно -> Text");

	Окно = СоздатьОкно("myapp.exe", "My Custom Application");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно), "Произвольное приложение -> Text");

КонецПроцедуры

// ========================================================
// Тесты определения контекста OneCCode (1С Конфигуратор)
// ========================================================

Процедура ТестОпределениеКонтекстаOneCCode()

	Сообщить("");
	Сообщить("--- Определение контекста OneCCode (1С Конфигуратор) ---");

	// Редактор модуля Конфигуратора: exe 1cv8 + «Конфигуратор» в title
	Окно = СоздатьОкно("1cv8.exe", "Модуль - Конфигуратор - Зарплата и управление персоналом");
	УтверждениеРавно("OneCCode", Детектор.ОпределитьКонтекст(Окно),
		"1cv8 + 'Конфигуратор' в заголовке -> OneCCode");

	// Регистронезависимость exe и заголовка
	Окно = СоздатьОкно("1CV8.EXE", "ФОРМА - КОНФИГУРАТОР - ДЕМО");
	УтверждениеРавно("OneCCode", Детектор.ОпределитьКонтекст(Окно),
		"1CV8.EXE + 'КОНФИГУРАТОР' -> OneCCode (регистронезависимо)");

	// 1С:Предприятие (тот же exe, НЕТ «Конфигуратор» в title) -> не OneCCode
	Окно = СоздатьОкно("1cv8.exe", "Зарплата и управление персоналом / Иванов / 1С:Предприятие");
	Утверждение(Детектор.ОпределитьКонтекст(Окно) <> "OneCCode",
		"1cv8 без 'Конфигуратор' в заголовке -> НЕ OneCCode (режим Предприятие)");

	// Регрессия: обычный редактор кода по-прежнему Code, не OneCCode
	Окно = СоздатьОкно("code.exe", "main.py - Visual Studio Code");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно),
		"VS Code остается Code (ветка OneCCode не перехватывает)");

	// Описание контекста OneCCode присутствует
	Описание = Детектор.ПолучитьОписаниеКонтекста("OneCCode");
	Утверждение(Найти(Описание, "Конфигуратор") > 0,
		"OneCCode имеет описание про Конфигуратор");

КонецПроцедуры

// ========================================================
// Тесты определения контекста по буферу обмена (Image)
// ========================================================

Процедура ТестОпределениеКонтекстаImage()

	Сообщить("");
	Сообщить("--- Определение контекста Image (буфер обмена) ---");

	// Старый скриншот не должен подменять активный редактор.
	Окно = СоздатьОкно("code.exe", "main.py");
	Буфер = Новый Структура();
	Буфер.Вставить("имеетИзображение", Истина);

	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"VS Code имеет приоритет над старым скриншотом");
	Окно = СоздатьОкно("WINWORD.EXE", "Document1 - Word");
	УтверждениеРавно("Word", Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Выделение Word не переключается в генерацию картинки");
	Окно = СоздатьОкно("excel.exe", "Book1 - Excel");
	УтверждениеРавно("Excel", Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Excel не переключается в Image из-за буфера");
	Окно = СоздатьОкно("outlook.exe", "Inbox - Outlook");
	УтверждениеРавно("Email", Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Email не переключается в Image из-за буфера");
	Окно = СоздатьОкно("1cv8.exe", "Модуль - Конфигуратор");
	УтверждениеРавно("OneCCode", Детектор.ОпределитьКонтекст(Окно, Буфер),
		"1С Конфигуратор не переключается в Image из-за буфера");
	Окно = СоздатьОкно("chrome.exe", "Page - Chrome");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Браузер анализирует страницу, а не старую картинку");
	Окно = СоздатьОкно("unknown.exe", "main.py - Editor");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Заголовок редактора имеет приоритет над буфером");
	Окно = СоздатьОкно("unknown.exe", "Untitled");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Неизвестное приложение не отправляет старую картинку без явного разрешения");
	УтверждениеРавно(КонтекстИзображения, Детектор.ОпределитьКонтекст(Окно, Буфер, Истина),
		"Картинка из буфера в неизвестном приложении требует явного разрешения");
	Окно = СоздатьОкно("notepad.exe", "Untitled - Notepad");
	УтверждениеРавно(КонтекстТекста, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Блокнот остаётся текстом при старом скриншоте");
	Окно = СоздатьОкно("mspaint.exe", "Набросок - Paint");
	УтверждениеРавно(КонтекстИзображения, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Paint с картинкой в буфере остаётся Image");
	Окно = СоздатьОкно("code.exe", "main.py");

	// Буфер без изображения -> определяется по процессу
	Буфер = Новый Структура();
	Буфер.Вставить("имеетИзображение", Ложь);

	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Буфер без изображения при code.exe -> Code");

	// Phase 6: просмотрщик изображений -> Image (без буфера)
	Окно = СоздатьОкно("i_view64.exe", "photo.jpg - IrfanView");
	УтверждениеРавно(КонтекстИзображения, Детектор.ОпределитьКонтекст(Окно),
		"IrfanView -> Image (просмотрщик, Phase 6)");

	Окно = СоздатьОкно("ImageGlass.exe", "ImageGlass");
	УтверждениеРавно(КонтекстИзображения, Детектор.ОпределитьКонтекст(Окно),
		"ImageGlass -> Image (регистронезависимо)");

	Окно = СоздатьОкно("mspaint.exe", "Набросок - Paint");
	УтверждениеРавно(КонтекстИзображения, Детектор.ОпределитьКонтекст(Окно, Буфер),
		"Paint -> Image без предварительного копирования холста");

	// Регрессия: браузер остается Browser.
	Окно = СоздатьОкно("chrome.exe", "Google - Chrome");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно),
		"Chrome остается Browser (не перехвачен Image-правилом)");

КонецПроцедуры

// ========================================================
// Тесты определения языка программирования
// ========================================================

Процедура ТестОпределениеЯзыкаПрограммирования()

	Сообщить("");
	Сообщить("--- Определение языка программирования ---");

	УтверждениеРавно("Python", Детектор.ОпределитьЯзыкПрограммирования("main.py - VS Code"),
		"main.py -> Python");

	УтверждениеРавно("JavaScript", Детектор.ОпределитьЯзыкПрограммирования("app.js - VS Code"),
		"app.js -> JavaScript");

	УтверждениеРавно("TypeScript", Детектор.ОпределитьЯзыкПрограммирования("component.ts - VS Code"),
		"component.ts -> TypeScript");

	УтверждениеРавно("C#", Детектор.ОпределитьЯзыкПрограммирования("Program.cs - Visual Studio"),
		"Program.cs -> C#");

	УтверждениеРавно("Java", Детектор.ОпределитьЯзыкПрограммирования("Main.java - IntelliJ"),
		"Main.java -> Java");

	УтверждениеРавно("C++", Детектор.ОпределитьЯзыкПрограммирования("module.cpp - VS Code"),
		"module.cpp -> C++");

	УтверждениеРавно("Go", Детектор.ОпределитьЯзыкПрограммирования("server.go - GoLand"),
		"server.go -> Go");

	УтверждениеРавно("Rust", Детектор.ОпределитьЯзыкПрограммирования("lib.rs - VS Code"),
		"lib.rs -> Rust");

	УтверждениеРавно("PHP", Детектор.ОпределитьЯзыкПрограммирования("index.php - PhpStorm"),
		"index.php -> PHP");

	УтверждениеРавно("SQL", Детектор.ОпределитьЯзыкПрограммирования("query.sql - DBeaver"),
		"query.sql -> SQL");

	УтверждениеРавно("1C:Enterprise", Детектор.ОпределитьЯзыкПрограммирования("Module.bsl - EDT"),
		"Module.bsl -> 1C:Enterprise");

	УтверждениеРавно("OneScript", Детектор.ОпределитьЯзыкПрограммирования("script.os - VS Code"),
		"script.os -> OneScript");

	УтверждениеРавно(НеизвестныйЯзык, Детектор.ОпределитьЯзыкПрограммирования("README.md - VS Code"),
		"README.md -> Unknown");

	УтверждениеРавно(НеизвестныйЯзык, Детектор.ОпределитьЯзыкПрограммирования("Просто заголовок"),
		"Без расширения -> Unknown");
	УтверждениеРавно(НеизвестныйЯзык, Детектор.ОпределитьЯзыкПрограммирования("config.json - Viewer"),
		".json не определяется как JavaScript по префиксу .js");
	УтверждениеРавно(НеизвестныйЯзык, Детектор.ОпределитьЯзыкПрограммирования("styles.css - Viewer"),
		".css не определяется как C# по префиксу .cs");
	УтверждениеРавно("C++", Детектор.ОпределитьЯзыкПрограммирования("main.cpp - Editor"),
		".cpp не определяется как C по префиксу .c");

КонецПроцедуры

// ========================================================
// Тесты вспомогательных методов
// ========================================================

Процедура ТестОписанияКонтекстов()

	Сообщить("");
	Сообщить("--- Описания контекстов ---");

	Описание = Детектор.ПолучитьОписаниеКонтекста(КонтекстКода);
	Утверждение(Найти(Описание, "код") > 0 ИЛИ Найти(Описание, "Редактор") > 0,
		"Code имеет описание о коде");

	Описание = Детектор.ПолучитьОписаниеКонтекста(КонтекстБраузера);
	Утверждение(Найти(Описание, "браузер") > 0 ИЛИ Найти(Описание, "Веб") > 0,
		"Browser имеет описание о браузере");

	Описание = Детектор.ПолучитьОписаниеКонтекста("AIChat");
	Утверждение(Найти(Описание, "AI-клиент") > 0,
		"AIChat имеет описание AI-клиента");

	Описание = Детектор.ПолучитьОписаниеКонтекста("НесуществующийКонтекст");
	УтверждениеРавно("Неизвестный контекст", Описание,
		"Неизвестный контекст -> 'Неизвестный контекст'");

КонецПроцедуры

Процедура ТестТребуетсяVision()

	Сообщить("");
	Сообщить("--- Требуется ли Vision ---");

	Утверждение(Детектор.ТребуетсяVision(КонтекстБраузера), "Browser требует Vision");
	Утверждение(Детектор.ТребуетсяVision("AIChat"), "AIChat требует Vision для nextStep");
	Утверждение(Детектор.ТребуетсяVision(КонтекстИзображения), "Image требует Vision");
	Утверждение(НЕ Детектор.ТребуетсяVision(КонтекстКода), "Code НЕ требует Vision");
	Утверждение(НЕ Детектор.ТребуетсяVision(КонтекстТекста), "Text НЕ требует Vision");
	Утверждение(НЕ Детектор.ТребуетсяVision("Excel"), "Excel НЕ требует Vision");

КонецПроцедуры

Процедура ТестПолучитьВсеКонтексты()

	Сообщить("");
	Сообщить("--- Список всех контекстов ---");

	Контексты = Детектор.ПолучитьВсеКонтексты();

	Утверждение(Контексты.Количество() >= 5,
		"Минимум 5 контекстов (получено: " + Контексты.Количество() + ")");

	Утверждение(Контексты.Найти(КонтекстКода) <> Неопределено, "Есть контекст Code");
	Утверждение(Контексты.Найти(КонтекстБраузера) <> Неопределено, "Есть контекст Browser");
	Утверждение(Контексты.Найти("Excel") <> Неопределено, "Есть контекст Excel");
	Утверждение(Контексты.Найти("AIChat") <> Неопределено, "Есть контекст AIChat");

КонецПроцедуры

Процедура ТестРегистронезависимость()

	Сообщить("");
	Сообщить("--- Регистронезависимость ---");

	// Процесс в верхнем регистре
	Окно = СоздатьОкно("CODE.EXE", "main.py");
	УтверждениеРавно(КонтекстКода, Детектор.ОпределитьКонтекст(Окно), "CODE.EXE -> Code (без учета регистра)");

	Окно = СоздатьОкно("Chrome.EXE", "Google");
	УтверждениеРавно(КонтекстБраузера, Детектор.ОпределитьКонтекст(Окно), "Chrome.EXE -> Browser (без учета регистра)");

КонецПроцедуры

// ========================================================
// Запуск тестов
// ========================================================

ВсегоТестов = 0;
КонтекстКода = "Code";
КонтекстБраузера = "Browser";
КонтекстТекста = "Text";
НеизвестныйЯзык = "Unknown";
КонтекстИзображения = "Image";
Пройдено = 0;
Провалено = 0;

Сообщить("========================================");
Сообщить("Тесты: context-detector");
Сообщить("========================================");

// Загрузить тестируемый модуль (путь цепочкой по 2 аргумента)
ПутьКМодулю = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "..");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "src");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "onescript");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "modules");
ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "context-detector.os");
Детектор = ЗагрузитьСценарий(ПутьКМодулю);

// Запустить тесты
ТестОпределениеКонтекстаПоПроцессу();
ТестОпределениеКонтекстаAIChat();
ТестОпределениеКонтекстаПоЗаголовку();
ТестОпределениеКонтекстаOneCCode();
ТестОпределениеКонтекстаImage();
ТестОпределениеЯзыкаПрограммирования();
ТестОписанияКонтекстов();
ТестТребуетсяVision();
ТестПолучитьВсеКонтексты();
ТестРегистронезависимость();

// Итоги
Сообщить("");
Сообщить("========================================");
Сообщить("Итого: " + ВсегоТестов + " | Pass: " + Пройдено + " | Fail: " + Провалено);
Сообщить("========================================");

Если Провалено > 0 Тогда
	ВызватьИсключение "ПРОВАЛЕНО тестов: " + Провалено;
КонецЕсли;
