// ========================================================
// Тесты: Парсинг ответов OpenRouter API
// ========================================================
// Проверяет ИзвлечьТекстОтвета, ПолучитьИнфоОбИспользовании,
// работу мока, обработку ошибочных ответов.
// ========================================================

Перем ВсегоТестов;
Перем Пройдено;
Перем Провалено;
Перем МокКлиент;
Перем КаталогFixtures;

// ========================================================
// Утилиты
// ========================================================

Процедура Утверждение(Знач Условие, Знач ОписаниеТеста)

	ВсегоТестов = ВсегоТестов + 1;

	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
	КонецЕсли;

КонецПроцедуры

Процедура УтверждениеРавно(Знач Ожидаемое, Знач Фактическое, Знач ОписаниеТеста)

	Условие = (Ожидаемое = Фактическое);

	ВсегоТестов = ВсегоТестов + 1;

	Если Условие Тогда
		Пройдено = Пройдено + 1;
		Сообщить("  [PASS] " + ОписаниеТеста);
	Иначе
		Провалено = Провалено + 1;
		Сообщить("  [FAIL] " + ОписаниеТеста);
		Сообщить("         Ожидалось: " + Ожидаемое);
		Сообщить("         Получено:  " + Фактическое);
	КонецЕсли;

КонецПроцедуры

Функция ЗагрузитьFixture(Знач ИмяФайла)

	ПолныйПуть = ОбъединитьПути(КаталогFixtures, ИмяФайла);

	Чтение = Новый ЧтениеТекста(ПолныйПуть, КодировкаТекста.UTF8);
	ТекстJSON = Чтение.Прочитать();
	Чтение.Закрыть();

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

// ========================================================
// Тесты парсинга успешного ответа
// ========================================================

Процедура ТестИзвлечениеТекстаУспешныйОтвет()

	Сообщить("");
	Сообщить("--- Извлечение текста из успешного ответа ---");

	Ответ = ЗагрузитьFixture("api-response-success.json");

	Текст = МокКлиент.ИзвлечьТекстОтвета(Ответ);

	Утверждение(НЕ ПустаяСтрока(Текст), "Текст ответа не пустой");
	Утверждение(Найти(Текст, "function") > 0, "Текст содержит код функции");
	Утверждение(Найти(Текст, "return") > 0, "Текст содержит return");

КонецПроцедуры

Процедура ТестИнформацияОбИспользованииУспешныйОтвет()

	Сообщить("");
	Сообщить("--- Информация об использовании токенов ---");

	Ответ = ЗагрузитьFixture("api-response-success.json");

	Инфо = МокКлиент.ПолучитьИнфоОбИспользовании(Ответ);

	УтверждениеРавно(150, Инфо.prompt_tokens, "prompt_tokens = 150");
	УтверждениеРавно(42, Инфо.completion_tokens, "completion_tokens = 42");
	УтверждениеРавно(192, Инфо.total_tokens, "total_tokens = 192");

КонецПроцедуры

// ========================================================
// Тесты парсинга vision ответа
// ========================================================

Процедура ТестИзвлечениеТекстаVisionОтвет()

	Сообщить("");
	Сообщить("--- Извлечение текста из vision ответа ---");

	Ответ = ЗагрузитьFixture("api-response-vision.json");

	Текст = МокКлиент.ИзвлечьТекстОтвета(Ответ);

	Утверждение(НЕ ПустаяСтрока(Текст), "Vision ответ не пустой");
	Утверждение(СтрДлина(Текст) > 20, "Vision ответ содержит описание (длина > 20)");

КонецПроцедуры

Процедура ТестТокеныVisionОтвет()

	Сообщить("");
	Сообщить("--- Токены vision ответа ---");

	Ответ = ЗагрузитьFixture("api-response-vision.json");

	Инфо = МокКлиент.ПолучитьИнфоОбИспользовании(Ответ);

	УтверждениеРавно(1200, Инфо.prompt_tokens, "Vision prompt_tokens = 1200 (изображение)");
	УтверждениеРавно(85, Инфо.completion_tokens, "Vision completion_tokens = 85");
	УтверждениеРавно(1285, Инфо.total_tokens, "Vision total_tokens = 1285");

	Утверждение(Инфо.prompt_tokens > 500,
		"Vision prompt_tokens больше чем у текстового (изображение потребляет токены)");

КонецПроцедуры

// ========================================================
// Тесты обработки ошибочных ответов
// ========================================================

Процедура ТестОтветСОшибкой()

	Сообщить("");
	Сообщить("--- Обработка ответа с ошибкой ---");

	Ответ = ЗагрузитьFixture("api-response-error.json");

	// Ответ содержит поле error, а не choices
	Утверждение(Ответ.Свойство("error"), "Ответ с ошибкой содержит поле 'error'");
	Утверждение(НЕ Ответ.Свойство("choices"), "Ответ с ошибкой НЕ содержит 'choices'");

	// Попытка извлечь текст должна вызвать исключение
	ОшибкаВозникла = Ложь;
	Попытка
		МокКлиент.ИзвлечьТекстОтвета(Ответ);
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Утверждение(ОшибкаВозникла, "ИзвлечьТекстОтвета вызывает исключение на ответе с ошибкой");

КонецПроцедуры

Процедура ТестОтветБезUsage()

	Сообщить("");
	Сообщить("--- Ответ без блока usage ---");

	// Структура без usage
	Ответ = Новый Структура();
	Ответ.Вставить("id", "test");

	Инфо = МокКлиент.ПолучитьИнфоОбИспользовании(Ответ);

	УтверждениеРавно(0, Инфо.prompt_tokens, "Без usage: prompt_tokens = 0");
	УтверждениеРавно(0, Инфо.completion_tokens, "Без usage: completion_tokens = 0");
	УтверждениеРавно(0, Инфо.total_tokens, "Без usage: total_tokens = 0");

КонецПроцедуры

// ========================================================
// Тесты мок-клиента
// ========================================================

Процедура ТестМокИнициализация()

	Сообщить("");
	Сообщить("--- Инициализация мока ---");

	// Инициализация не должна вызывать ошибку
	ОшибкаВозникла = Ложь;
	Попытка
		МокКлиент.Инициализировать("test-api-key-12345");
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Утверждение(НЕ ОшибкаВозникла, "Инициализация мока без ошибок");

КонецПроцедуры

Процедура ТестМокОтправкаТекстовогоЗапроса()

	Сообщить("");
	Сообщить("--- Мок: текстовый запрос ---");

	// Загрузить fixture как ответ
	ПутьКFixture = ОбъединитьПути(КаталогFixtures, "api-response-success.json");
	МокКлиент.ЗагрузитьОтветИзФайла(ПутьКFixture);
	МокКлиент.ОчиститьИсторию();

	Результат = МокКлиент.ОтправитьТекстовыйЗапрос(
		"anthropic/claude-3.5-sonnet",
		"You are a helpful assistant.",
		"Improve this code: function add(a,b){return a+b}");

	// Проверить что ответ корректный
	Утверждение(Результат.Свойство("choices"), "Ответ содержит choices");
	Утверждение(Результат.choices.Количество() > 0, "Есть хотя бы один choice");

	// Проверить историю запросов
	История = МокКлиент.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "В истории 1 запрос");
	УтверждениеРавно("текстовый", История[0].тип, "Тип запроса = текстовый");
	УтверждениеРавно("anthropic/claude-3.5-sonnet", История[0].модель, "Модель запроса корректна");

КонецПроцедуры

Процедура ТестМокОтправкаVisionЗапроса()

	Сообщить("");
	Сообщить("--- Мок: vision запрос ---");

	ПутьКFixture = ОбъединитьПути(КаталогFixtures, "api-response-vision.json");
	МокКлиент.ЗагрузитьОтветИзФайла(ПутьКFixture);
	МокКлиент.ОчиститьИсторию();

	Результат = МокКлиент.ОтправитьЗапросСИзображением(
		"anthropic/claude-opus-4",
		"Analyze this image",
		"C:\fake\path\screenshot.png");

	// Проверить что ответ от vision fixture
	Текст = МокКлиент.ИзвлечьТекстОтвета(Результат);
	Утверждение(СтрДлина(Текст) > 0, "Vision ответ получен");

	// Проверить историю
	История = МокКлиент.ПолучитьИсториюЗапросов();
	УтверждениеРавно(1, История.Количество(), "В истории 1 vision запрос");
	УтверждениеРавно("vision", История[0].тип, "Тип запроса = vision");
	УтверждениеРавно("anthropic/claude-opus-4", История[0].модель, "Vision модель корректна");

КонецПроцедуры

Процедура ТестМокРежимОшибки()

	Сообщить("");
	Сообщить("--- Мок: режим ошибки ---");

	МокКлиент.УстановитьРежимОшибки("HTTP 401: Invalid API key");

	ОшибкаВозникла = Ложь;
	ТекстПойманнойОшибки = "";
	Попытка
		МокКлиент.ОтправитьТекстовыйЗапрос("model", "system", "user");
	Исключение
		ОшибкаВозникла = Истина;
		ТекстПойманнойОшибки = ОписаниеОшибки();
	КонецПопытки;

	Утверждение(ОшибкаВозникла, "Режим ошибки вызывает исключение");
	Утверждение(Найти(ТекстПойманнойОшибки, "401") > 0,
		"Текст ошибки содержит код 401");

	// Сбросить режим ошибки
	МокКлиент.СброситьРежимОшибки();

	// Установить ответ чтобы следующий вызов не падал
	ПутьКFixture = ОбъединитьПути(КаталогFixtures, "api-response-success.json");
	МокКлиент.ЗагрузитьОтветИзФайла(ПутьКFixture);

	ОшибкаВозникла = Ложь;
	Попытка
		МокКлиент.ОтправитьТекстовыйЗапрос("model", "system", "user");
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Утверждение(НЕ ОшибкаВозникла, "После сброса режима ошибки запрос проходит");

КонецПроцедуры

Процедура ТестМокБезУстановленногоОтвета()

	Сообщить("");
	Сообщить("--- Мок: запрос без установленного ответа ---");

	// Создать новый мок без установленного ответа
	ПутьКМоку = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	ПутьКМоку = ОбъединитьПути(ПутьКМоку, "mocks");
	ПутьКМоку = ОбъединитьПути(ПутьКМоку, "mock-openrouter-client.os");
	НовыйМок = ЗагрузитьСценарий(ПутьКМоку);
	НовыйМок.Инициализировать("key");

	ОшибкаВозникла = Ложь;
	Попытка
		НовыйМок.ОтправитьТекстовыйЗапрос("model", "system", "user");
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Утверждение(ОшибкаВозникла,
		"Запрос без установленного ответа вызывает исключение");

КонецПроцедуры

// ========================================================
// Запуск тестов
// ========================================================

ВсегоТестов = 0;
Пройдено = 0;
Провалено = 0;

Сообщить("========================================");
Сообщить("Тесты: openrouter-parser (мок-клиент)");
Сообщить("========================================");

// Пути (цепочкой по 2 аргумента)
КаталогFixtures = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
КаталогFixtures = ОбъединитьПути(КаталогFixtures, "fixtures");

// Загрузить мок
ПутьКМоку = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ПутьКМоку = ОбъединитьПути(ПутьКМоку, "mocks");
ПутьКМоку = ОбъединитьПути(ПутьКМоку, "mock-openrouter-client.os");
МокКлиент = ЗагрузитьСценарий(ПутьКМоку);

// Запустить тесты
ТестМокИнициализация();
ТестИзвлечениеТекстаУспешныйОтвет();
ТестИнформацияОбИспользованииУспешныйОтвет();
ТестИзвлечениеТекстаVisionОтвет();
ТестТокеныVisionОтвет();
ТестОтветСОшибкой();
ТестОтветБезUsage();
ТестМокОтправкаТекстовогоЗапроса();
ТестМокОтправкаVisionЗапроса();
ТестМокРежимОшибки();
ТестМокБезУстановленногоОтвета();

// Итоги
Сообщить("");
Сообщить("========================================");
Сообщить("Итого: " + ВсегоТестов + " | Pass: " + Пройдено + " | Fail: " + Провалено);
Сообщить("========================================");

Если Провалено > 0 Тогда
	ВызватьИсключение "ПРОВАЛЕНО тестов: " + Провалено;
КонецЕсли;
