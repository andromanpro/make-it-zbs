// Количество выполненных проверок API библиотеки.
Перем Проверок;

Процедура Проверить(Знач Условие, Знач Имя)
	Если НЕ Условие Тогда
		ВызватьИсключение Имя;
	КонецЕсли;
	Проверок = Проверок + 1;
КонецПроцедуры

Проверок = 0;
ТестовыйТекст = "Windows library: Привет, UTF-16!";
ПодключитьВнешнююКомпоненту(АргументыКоманднойСтроки[0]);
Буфер = Новый БуферWindows();
Окна = Новый РабочийСтолWindows();
Окно = Окна.АктивноеОкно();
Проверить(Окно.Дескриптор <> 0, "Foreground handle");
Проверить(Окно.ИдентификаторПроцесса > 0, "Foreground PID");
Проверить(Окно.Класс <> "", "Foreground class");
Проверить(ТипЗнч(Окно.Заголовок) = Тип("Строка"), "Title type");

// No personal clipboard content is printed or written to disk.
Оригинал = Буфер.Сохранить();
СобственнаяВерсия = -1;
Попытка
	СобственнаяВерсия = Буфер.ЗаписатьТекст(ТестовыйТекст, Оригинал.Версия);
	Проверить(СобственнаяВерсия = Буфер.Версия, "Atomic write sequence");
	Проверить(Буфер.ВерсияСобственнойЗаписи = СобственнаяВерсия, "Verified owned sequence");
	Проверить(Буфер.ПрочитатьТекст() = ТестовыйТекст, "Unicode round trip");
	Первый = Буфер.Сохранить();
	Проверить(Первый.Версия = СобственнаяВерсия, "Snapshot sequence");
	СобственнаяВерсия = Буфер.ЗаписатьТекст("Synthetic newer copy", СобственнаяВерсия);
	Проверить(НЕ Первый.Восстановить(Первый.Версия), "Stale restore must refuse");
	Проверить(Буфер.ПрочитатьТекст() = "Synthetic newer copy", "Stale restore preserves newer copy");
	Проверить(Первый.Восстановить(СобственнаяВерсия), "Restore with owned sequence");
	СобственнаяВерсия = Буфер.Версия;
	Проверить(Буфер.ПрочитатьТекст() = ТестовыйТекст, "Restored original synthetic copy");
	Первый.Закрыть();
	Отказ = Ложь;
	Попытка
		Первый.Восстановить(СобственнаяВерсия);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Disposed snapshot refuses restore");
	Отказ = Ложь;
	Попытка
		Буфер.ЗаписатьТекст("Should not be written", СобственнаяВерсия - 1);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Stale write must refuse");
	Проверить(Буфер.ПрочитатьТекст() = ТестовыйТекст, "Stale write preserves clipboard");
	Для Индекс = 0 По 2 Цикл
		Если Индекс = 0 Тогда
			НевернаяВерсия = -2;
		ИначеЕсли Индекс = 1 Тогда
			НевернаяВерсия = 0.5;
		Иначе
			НевернаяВерсия = 4294967296;
		КонецЕсли;
		Отказ = Ложь;
		Попытка
			Буфер.ЗаписатьТекст("Should not be written", НевернаяВерсия);
		Исключение
			Отказ = Истина;
		КонецПопытки;
		Проверить(Отказ, "Invalid sequence must refuse");
	КонецЦикла;
	Проверить(Буфер.Версия = СобственнаяВерсия, "Rejected writes do not mutate clipboard");
	СобственнаяВерсия = Буфер.ЗаписатьТекст("", СобственнаяВерсия);
	Проверить(Буфер.ПрочитатьТекст() = "", "Empty text round trip");
	Отказ = Ложь;
	Попытка
		Буфер.ЗаписатьТекст("NUL" + Символ(0) + "suffix", СобственнаяВерсия);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "NUL text must refuse");
	Проверить(Буфер.Версия = СобственнаяВерсия, "Rejected NUL does not mutate clipboard");
	Проверить(Оригинал.Восстановить(СобственнаяВерсия), "Restore user's initial clipboard");
	СобственнаяВерсия = -1;
	Оригинал.Закрыть();
Исключение
	ВерсияОтката = Буфер.ВерсияСобственнойЗаписи;
	Если ВерсияОтката >= 0 Тогда
		Оригинал.Восстановить(ВерсияОтката);
	КонецЕсли;
	Оригинал.Закрыть();
	ВызватьИсключение;
КонецПопытки;
Сообщить("WINDOWS-LIBRARY-SMOKE-PASS assertions=" + Формат(Проверок, "ЧГ=0"));
Буфер.ЗавершитьСлужбы();
