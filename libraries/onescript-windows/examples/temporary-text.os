ПодключитьВнешнююКомпоненту(АргументыКоманднойСтроки[0]);
Буфер = Новый БуферWindows();
Снимок = Буфер.Сохранить();
Попытка
	ВерсияЗаписи = Буфер.ЗаписатьТекст("Synthetic temporary text", Снимок.Версия);
	// Put the operation using this temporary text here. This example sends no keys.
	Восстановлен = Снимок.Восстановить(ВерсияЗаписи);
	Снимок.Закрыть();
	Если НЕ Восстановлен Тогда
		Сообщить("Clipboard changed; the newer copy was left intact.");
	КонецЕсли;
Исключение
	Снимок.Закрыть();
	ВызватьИсключение;
КонецПопытки;
Буфер.ЗавершитьСлужбы();
