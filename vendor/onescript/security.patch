+        private static string ValidateDestination(string directory, string name)
+        {
+            var root = Path.GetFullPath(directory).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
+                + Path.DirectorySeparatorChar;
+            var relative = name.Replace('/', Path.DirectorySeparatorChar);
+            if (Path.IsPathRooted(relative) || relative.IndexOf(':') >= 0)
+                throw new IOException("Archive entry must have a relative file path.");
+            var target = Path.GetFullPath(Path.Combine(root, relative));
+            if (!target.StartsWith(root, StringComparison.OrdinalIgnoreCase))
+                throw new IOException("Archive entry escapes its extraction directory.");
+            // Existing links below the destination must not redirect an otherwise valid path.
+            for (var current = target; current != null && current.StartsWith(root, StringComparison.OrdinalIgnoreCase);
+                 current = Path.GetDirectoryName(current))
+            {
+                if ((File.Exists(current) || Directory.Exists(current))
+                    && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                    throw new IOException("Archive entry traverses a filesystem link.");
+            }
+            return target;
+        }
