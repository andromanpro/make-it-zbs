# Исторически в репозитории смешаны LF и CRLF. CR перед LF не считается
# trailing whitespace, но реальные пробелы в конце строк по-прежнему ловятся.
* whitespace=trailing-space,space-before-tab,cr-at-eol

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Vendored notices are hashed byte-for-byte against their original packages.
vendor/licenses/** -text
vendor/onescript/** -text
src/CaptureHost/THIRD-PARTY-CAPTURE.txt -text
